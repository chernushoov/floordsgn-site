  "glossary": {
    "сargelim": {
      "term": "Саргелим",
      "def": "Декоративные металлические полосы между секциями террацо для зонирования и компенсации швов."
    },
    "sikafloor": {
      "term": "Sikafloor-263 SL",
      "def": "Самовыравнивающийся 2-компонентный эпокси, толщина 2-3мм, износостойкий."
    },
    "mma": {
      "term": "MMA Pronto",
      "def": "Метилметакрилат, fast-cure 1-2ч, можно при -25°C, специфический запах при кладке."
    },
    "pucem": {
      "term": "PU-cement",
      "def": "Полиуретан-цементный гибрид. Food-grade, термошок -40 до +120°C."
    },
    "esd": {
      "term": "ESD",
      "def": "Electrostatic Discharge — заземляющая система против статики, для cleanroom/electronics."
    },
    "ral": {
      "term": "RAL",
      "def": "Европейский стандарт цветов для промышленных покрытий."
    },
    "rclass": {
      "term": "R-класс",
      "def": "DIN 51130: рейтинг противоскольжения. R9 — гладко, R13 — максимум grip."
    },
    "haccp": {
      "term": "HACCP",
      "def": "Стандарт пищевой безопасности — критическое для food-plant."
    },
    "topcoat": {
      "term": "Топкоат",
      "def": "Финишное защитное покрытие — герметик/износ-слой поверх тела системы."
    },
    "primer": {
      "term": "Праймер",
      "def": "Адгезионный грунт между подложкой и телом системы."
    },
    "body": {
      "term": "Тело системы",
      "def": "Основной несущий слой пола (терраццо-масса, эпокси-SL, PurCem и т.д.)."
    },
    "substrate": {
      "term": "Подложка",
      "def": "Существующая бетонная плита или стяжка, на которую кладётся система."
    },
    "Палладиана": "Крупный мраморный лом 25-40 мм, только цементный связующий, толщина 30-50 мм. Не сочетается с эпокси.",
    "CPC Class A/B/C/D": "Стандарт Concrete Polishing Council для глубины обнажения агрегата: A — только цементное молочко, B — мелкий, C — средний, D — крупный.",
    "Pandomo Loft": "Знаковая микротопинг-система Henkel/Ardex — плоский satin, толщина 2-3 мм, max бесшовная зона ~80 м².",
    "PurCem": "Полиуретан-цементный гибрид Sika для пищевой/фарма-промышленности. Термошок −40 до +120°C. HACCP/ISEGA/NSF.",
    "Sargel / Sargolim": "Декоративная разделительная планка между секциями террацо. Hebrew סרגל = ruler. Латунь / алюминий / нержавейка / PVC T-profile.",
    "Torginol flake": "Виниловый чип для декоративного эпокси, размеры 1/16″ – 1/2″, мульти-цветные блэнды (Domino, Granite).",
    "DOI": "Distinctness of Image — стандарт ASTM E430 для глянца. <10 матовый, 70+ зеркало.",
    "EN 1177": "Европейский стандарт ударопоглощения детских площадок. Привязка толщины EPDM к высоте падения. HIC <1000.",
    "HIC": "Head Injury Criterion — критерий защиты при падении. <1000 = безопасно. EN 1177 определяет толщину покрытия."
  },
