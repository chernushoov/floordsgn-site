        // Microtopping
        micro_category: "Architectural Coating",
        micro_title: "Microtopping",
        micro_meta: "Ultra-Thin Cement Overlay",
        micro_lead: "Ultra-thin polymer-modified cement coating that transforms existing surfaces into seamless, contemporary floors. The architect's choice for minimalist interiors with industrial character.",
        micro_h2_where: "Where Microtopping Excels",
        micro_p_where: "Microtopping creates seamless, flowing surfaces that define modern architectural spaces. Its minimal thickness makes it ideal for renovation projects where floor height is critical.",
        micro_app1_title: "High-End Residential",
        micro_app1_desc: "Living areas, kitchens, bathrooms. Continuous surface flow throughout the home. Compatible with underfloor heating.",
        micro_app2_title: "Retail & Showrooms",
        micro_app2_desc: "Neutral backdrop that lets products shine. Easy maintenance for high-traffic retail environments.",
        micro_app3_title: "Hospitality",
        micro_app3_desc: "Hotels, restaurants, caf\xe9s. Creates sophisticated ambiance with industrial undertones.",
        micro_app4_title: "Renovation Projects",
        micro_app4_desc: "Overlay existing tiles, concrete, or screeds without demolition. Minimal floor height increase.",
        micro_h2_substrate: "Substrate Preparation",
        micro_p_substrate: "Microtopping is thin (2-3mm) so substrate imperfections telegraph through. Surface preparation determines final quality.",
        micro_sub1: "<strong>Existing tiles</strong> \u2014 Can be overlaid if sound. Grout lines filled, surface scuffed for adhesion",
        micro_sub2: "<strong>Concrete</strong> \u2014 Must be flat, free of laitance, cracks filled with flexible compound",
        micro_sub3: "<strong>Screeds</strong> \u2014 Self-leveling compound applied to achieve required flatness (SR1-SR2)",
        micro_sub4: "<strong>Bonding primer</strong> \u2014 System-specific primer ensures adhesion to various substrates",
        micro_sub5: "<strong>Crack bridging</strong> \u2014 Fiberglass mesh embedded at movement joints and over filled cracks",
        micro_h2_process: "Application Process",
        micro_p_process: "Microtopping is applied in multiple thin layers, each hand-worked to create the desired texture and character.",
        micro_layer1_title: "Base Coat",
        micro_layer1_desc: "First layer of polymer-modified cement applied by trowel. Builds foundation, fills minor imperfections. Fiberglass mesh embedded if required.",
        micro_layer2_title: "Finish Coat",
        micro_layer2_desc: "Thin decorative layer applied and worked by hand to create desired texture \u2014 from smooth to varied, depending on technique and tools used.",
        micro_layer3_title: "Sealer System",
        micro_layer3_desc: "Two-component polyurethane or epoxy sealer provides stain resistance and durability. Multiple sheen levels: matte, satin, or gloss.",
        micro_h2_finishes: "Finish Options",
        micro_p_finishes: "Each microtopping floor can be customized to achieve your desired aesthetic:",
        micro_var1_title: "Natural Cement",
        micro_var1_desc: "Classic gray tones with subtle variation. Raw, industrial aesthetic.",
        micro_var2_title: "Tinted",
        micro_var2_desc: "Integral pigments create warm or cool tones \u2014 from charcoal to warm taupe.",
        micro_var3_title: "Cloud Effect",
        micro_var3_desc: "Deliberate trowel marks create movement and depth. Artisanal character.",
        micro_var4_title: "Uniform",
        micro_var4_desc: "Spray application for more consistent, even appearance. Modern, minimal.",
        micro_h2_advantages: "Key Advantages",
        micro_adv1: "<strong>Minimal Thickness</strong> \u2014 Only 2-3mm. No door trimming, no transition issues, no floor height changes.",
        micro_adv2: "<strong>Seamless Continuity</strong> \u2014 No joints, no grout lines. Surface flows continuously room to room.",
        micro_adv3: "<strong>Renovation Friendly</strong> \u2014 Overlay existing floors without demolition. Faster, cleaner, less disruptive.",
        micro_adv4: "<strong>Unique Character</strong> \u2014 Hand-applied artisanal finish. Each floor is one-of-a-kind with natural variation.",
        micro_adv5: "<strong>Underfloor Heating</strong> \u2014 Excellent thermal conductivity. Thinner than tiles for faster heat response.",
