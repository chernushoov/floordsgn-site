        epoxy_substr_title: "\u0422\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F \u043A \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044E",
        epoxy_substr_age: "\u0412\u043E\u0437\u0440\u0430\u0441\u0442 \u0431\u0435\u0442\u043E\u043D\u0430",
        epoxy_substr_age_v: "\u226528 \u0434\u043D\u0435\u0439",
