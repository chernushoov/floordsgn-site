        epoxy_app4_desc: "ESD-\u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C, \u0431\u0435\u0441\u0448\u043E\u0432\u043D\u0430\u044F \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C, \u0445\u0438\u043C\u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C. ISO-\u043A\u043B\u0430\u0441\u0441\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F.",
        epoxy_h2_substrate: "\u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F",
        epoxy_p_substrate: "\u042D\u043F\u043E\u043A\u0441\u0438\u0434\u043D\u044B\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438 \u0438 \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u0438 \u0441 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0435\u043C. \u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0430\u044F \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430 \u2014 \u0437\u0430\u043B\u043E\u0433 \u0434\u043E\u043B\u0433\u043E\u0432\u0435\u0447\u043D\u043E\u0441\u0442\u0438. \u041D\u0430\u0448\u0430 \u043A\u043E\u043C\u0430\u043D\u0434\u0430 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043E\u043F\u0442\u0438\u043C\u0430\u043B\u044C\u043D\u0443\u044E \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0443 \u043A\u0430\u0436\u0434\u043E\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438.",
        epoxy_sub1: "<strong>\u0414\u0440\u043E\u0431\u0435\u0441\u0442\u0440\u0443\u0439\u043D\u0430\u044F \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0430</strong> \u2014 \u0421\u043E\u0437\u0434\u0430\u0451\u0442 \u043E\u043F\u0442\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0439 \u043F\u0440\u043E\u0444\u0438\u043B\u044C (CSP 3-5) \u0438 \u0443\u0434\u0430\u043B\u044F\u0435\u0442 \u0446\u0435\u043C\u0435\u043D\u0442\u043D\u043E\u0435 \u043C\u043E\u043B\u043E\u0447\u043A\u043E",
        epoxy_sub2: "<strong>\u0410\u043B\u043C\u0430\u0437\u043D\u0430\u044F \u0448\u043B\u0438\u0444\u043E\u0432\u043A\u0430</strong> \u2014 \u0414\u043B\u044F \u0442\u043E\u043D\u043A\u0438\u0445 \u0441\u0438\u0441\u0442\u0435\u043C \u0438\u043B\u0438 \u0433\u0434\u0435 \u0434\u0440\u043E\u0431\u0435\u0441\u0442\u0440\u0443\u0439\u043A\u0430 \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u0430",
        epoxy_sub3: "<strong>\u0420\u0435\u043C\u043E\u043D\u0442 \u0442\u0440\u0435\u0449\u0438\u043D</strong> \u2014 \u0421\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u043D\u044B\u0435 \u0442\u0440\u0435\u0449\u0438\u043D\u044B \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u044E\u0442\u0441\u044F \u0433\u0438\u0431\u043A\u0438\u043C \u044D\u043F\u043E\u043A\u0441\u0438\u0434\u043E\u043C, \u0432\u043E\u043B\u043E\u0441\u044F\u043D\u044B\u0435 \u2014 \u043F\u0440\u043E\u043D\u0438\u043A\u0430\u044E\u0449\u0438\u043C \u043F\u0440\u0430\u0439\u043C\u0435\u0440\u043E\u043C",
        epoxy_sub4: "<strong>\u0422\u0435\u0441\u0442 \u0432\u043B\u0430\u0436\u043D\u043E\u0441\u0442\u0438</strong> \u2014 \u0425\u043B\u043E\u0440\u043A\u0430\u043B\u044C\u0446\u0438\u0435\u0432\u044B\u0439 \u0438 RH-\u0437\u043E\u043D\u0434\u043E\u0432\u044B\u0439 \u0442\u0435\u0441\u0442 \u043F\u043E ASTM F1869/F2170",
        epoxy_sub5: "<strong>\u0423\u0434\u0430\u043B\u0435\u043D\u0438\u0435 \u0437\u0430\u0433\u0440\u044F\u0437\u043D\u0435\u043D\u0438\u0439</strong> \u2014 \u041C\u0430\u0441\u043B\u0430, \u0436\u0438\u0440\u044B, \u043E\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0435\u043B\u0438 \u0434\u043E\u043B\u0436\u043D\u044B \u0431\u044B\u0442\u044C \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0443\u0434\u0430\u043B\u0435\u043D\u044B",
        epoxy_h2_system: "\u0410\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u044B",
        epoxy_p_system: "\u041A\u0430\u0436\u0434\u0430\u044F \u044D\u043F\u043E\u043A\u0441\u0438\u0434\u043D\u0430\u044F \u0443\u043A\u043B\u0430\u0434\u043A\u0430 \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u0442\u043E\u0447\u043D\u043E\u0439 \u043C\u043D\u043E\u0433\u043E\u0441\u043B\u043E\u0439\u043D\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u0435, \u0433\u0434\u0435 \u043A\u0430\u0436\u0434\u044B\u0439 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u043D\u0430 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0443\u044E \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0438 \u0434\u043E\u043B\u0433\u043E\u0432\u0435\u0447\u043D\u043E\u0441\u0442\u044C.",
        epoxy_layer1_title: "\u0413\u0440\u0443\u043D\u0442\u043E\u0432\u043E\u0447\u043D\u044B\u0439 \u0441\u043B\u043E\u0439",
        epoxy_layer1_desc: "\u041D\u0438\u0437\u043A\u043E\u0432\u044F\u0437\u043A\u0438\u0439 \u044D\u043F\u043E\u043A\u0441\u0438\u0434 \u043F\u0440\u043E\u043D\u0438\u043A\u0430\u0435\u0442 \u0432 \u043F\u043E\u0440\u044B \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F, \u0443\u043A\u0440\u0435\u043F\u043B\u044F\u0435\u0442 \u0441\u043B\u0430\u0431\u044B\u0435 \u0441\u043B\u043E\u0438 \u0438 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u0441\u0432\u044F\u0437\u044C \u0434\u043B\u044F \u043F\u043E\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0445 \u0441\u043B\u043E\u0451\u0432. \u0420\u0430\u0441\u0445\u043E\u0434: 0.15-0.25 \u043A\u0433/\u043C\xb2.",
        epoxy_layer2_title: "\u041E\u0441\u043D\u043E\u0432\u043D\u043E\u0439 \u0441\u043B\u043E\u0439 / \u041F\u043E\u0441\u044B\u043F\u043A\u0430",
        epoxy_layer2_desc: "\u0421\u0430\u043C\u043E\u0432\u044B\u0440\u0430\u0432\u043D\u0438\u0432\u0430\u044E\u0449\u0438\u0439\u0441\u044F \u0438\u043B\u0438 \u0437\u0430\u0442\u0438\u0440\u0430\u0435\u043C\u044B\u0439 \u044D\u043F\u043E\u043A\u0441\u0438\u0434\u043D\u044B\u0439 \u0440\u0430\u0441\u0442\u0432\u043E\u0440 \u043D\u0430\u0431\u0438\u0440\u0430\u0435\u0442 \u0442\u043E\u043B\u0449\u0438\u043D\u0443. \u0414\u043B\u044F \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0433\u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u043A\u0432\u0430\u0440\u0446 \u043F\u043E\u0441\u044B\u043F\u0430\u0435\u0442\u0441\u044F \u0432\u043E \u0432\u043B\u0430\u0436\u043D\u0443\u044E \u0441\u043C\u043E\u043B\u0443 \u0434\u043B\u044F \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u0441\u0446\u0435\u043F\u043B\u0435\u043D\u0438\u044F \u0438 \u0438\u0437\u043D\u043E\u0441\u043E\u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u0438.",
        epoxy_layer3_title: "\u0424\u0438\u043D\u0438\u0448\u043D\u044B\u0439 \u0441\u043B\u043E\u0439",
        epoxy_layer3_desc: "\u041F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u044B\u0439 \u0438\u043B\u0438 \u043F\u0438\u0433\u043C\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0442\u043E\u043F\u043A\u043E\u0443\u0442 \u0438\u043D\u043A\u0430\u043F\u0441\u0443\u043B\u0438\u0440\u0443\u0435\u0442 \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 UV-\u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C (\u0430\u043B\u0438\u0444\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B) \u0438 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442 \u0438\u0442\u043E\u0433\u043E\u0432\u044B\u0439 \u0433\u043B\u044F\u043D\u0435\u0446 \u0438 \u0445\u0438\u043C\u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C.",
        epoxy_h2_variants: "\u0412\u0430\u0440\u0438\u0430\u043D\u0442\u044B \u0441\u0438\u0441\u0442\u0435\u043C",
        epoxy_p_variants: "\u041C\u044B \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u043C \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E \u043A\u043E\u043D\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u0439 \u044D\u043F\u043E\u043A\u0441\u0438\u0434\u043D\u044B\u0445 \u0441\u0438\u0441\u0442\u0435\u043C \u043F\u043E\u0434 \u0432\u0430\u0448\u0438 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F:",
        epoxy_var1_title: "\u0421\u0430\u043C\u043E\u0432\u044B\u0440\u0430\u0432\u043D\u0438\u0432\u0430\u044E\u0449\u0438\u0439\u0441\u044F",
        epoxy_var1_desc: "\u0413\u043B\u0430\u0434\u043A\u0430\u044F \u0431\u0435\u0441\u0448\u043E\u0432\u043D\u0430\u044F \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C. \u0422\u043E\u043B\u0449\u0438\u043D\u0430 2-3\u043C\u043C. \u0414\u043B\u044F \u043B\u0451\u0433\u043A\u043E\u0433\u043E-\u0441\u0440\u0435\u0434\u043D\u0435\u0433\u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F, \u0447\u0438\u0441\u0442\u044B\u0445 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0439.",
        epoxy_var2_title: "\u041A\u0432\u0430\u0440\u0446\u0435\u0432\u0430\u044F \u043F\u043E\u0441\u044B\u043F\u043A\u0430",
        epoxy_var2_desc: "\u0426\u0432\u0435\u0442\u043D\u043E\u0439 \u043A\u0432\u0430\u0440\u0446 \u0434\u043B\u044F \u0442\u0435\u043A\u0441\u0442\u0443\u0440\u044B \u0438 \u0434\u043E\u043B\u0433\u043E\u0432\u0435\u0447\u043D\u043E\u0441\u0442\u0438. 3-5\u043C\u043C. \u0418\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0435 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435, \u0434\u0435\u043A\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0435 \u043E\u043F\u0446\u0438\u0438.",
        epoxy_var3_title: "\u0420\u0430\u0441\u0442\u0432\u043E\u0440\u043D\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430",
        epoxy_var3_desc: "\u0422\u043E\u043B\u0441\u0442\u043E\u0441\u043B\u043E\u0439\u043D\u0430\u044F \u0437\u0430\u0442\u0438\u0440\u0430\u0435\u043C\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430. 6-12\u043C\u043C. \u042D\u043A\u0441\u0442\u0440\u0435\u043C\u0430\u043B\u044C\u043D\u0430\u044F \u0443\u0434\u0430\u0440\u043E- \u0438 \u0442\u0435\u0440\u043C\u043E\u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C.",
        epoxy_var4_title: "ESD/\u0422\u043E\u043A\u043E\u043F\u0440\u043E\u0432\u043E\u0434\u044F\u0449\u0438\u0439",
        epoxy_var4_desc: "\u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0441\u0442\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u0440\u0430\u0437\u0440\u044F\u0434\u0430. \u042D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u0438\u043A\u0430, \u0434\u0430\u0442\u0430-\u0446\u0435\u043D\u0442\u0440\u044B, \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0435.",
        epoxy_h2_advantages: "\u041A\u043B\u044E\u0447\u0435\u0432\u044B\u0435 \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0430",
        epoxy_adv1: "<strong>\u0425\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C</strong> \u2014 \u0423\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0441\u0442\u044C \u043A \u043A\u0438\u0441\u043B\u043E\u0442\u0430\u043C, \u0449\u0435\u043B\u043E\u0447\u0430\u043C, \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044F\u043C, \u043C\u0430\u0441\u043B\u0430\u043C \u0438 \u0442\u043E\u043F\u043B\u0438\u0432\u0443. \u0414\u043E\u0441\u0442\u0443\u043F\u043D\u044B FDA-\u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u044B\u0435 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u044B.",
        epoxy_adv2: "<strong>\u0411\u0435\u0441\u0448\u043E\u0432\u043D\u043E\u0441\u0442\u044C \u0438 \u0433\u0438\u0433\u0438\u0435\u043D\u0430</strong> \u2014 \u041D\u0435\u0442 \u0448\u0432\u043E\u0432 \u0438 \u0437\u0430\u0442\u0438\u0440\u043A\u0438, \u0433\u0434\u0435 \u043C\u043E\u0433\u0443\u0442 \u0441\u043A\u0430\u043F\u043B\u0438\u0432\u0430\u0442\u044C\u0441\u044F \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u0438. \u041B\u0435\u0433\u043A\u043E \u043C\u044B\u0442\u044C \u0438 \u0434\u0435\u0437\u0438\u043D\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u0442\u044C.",
        epoxy_adv3: "<strong>\u041C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C</strong> \u2014 \u0412\u044B\u0441\u043E\u043A\u0430\u044F \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C \u043D\u0430 \u0441\u0436\u0430\u0442\u0438\u0435 (80+ \u041C\u041F\u0430), \u0443\u0434\u0430\u0440\u043E- \u0438 \u0438\u0437\u043D\u043E\u0441\u043E\u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C.",
        epoxy_adv4: "<strong>\u0413\u0438\u0431\u043A\u043E\u0441\u0442\u044C \u0434\u0438\u0437\u0430\u0439\u043D\u0430</strong> \u2014 \u041D\u0435\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u044B\u0435 \u0446\u0432\u0435\u0442\u0430, \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u043A-\u044D\u0444\u0444\u0435\u043A\u0442\u044B, \u0444\u043B\u0435\u0439\u043A-\u0441\u0438\u0441\u0442\u0435\u043C\u044B, \u043B\u043E\u0433\u043E\u0442\u0438\u043F\u044B \u0438 \u0440\u0430\u0437\u043C\u0435\u0442\u043A\u0430.",
        epoxy_adv5: "<strong>\u0411\u044B\u0441\u0442\u0440\u044B\u0439 \u0432\u043E\u0437\u0432\u0440\u0430\u0442 \u0432 \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u044E</strong> \u2014 \u041F\u0435\u0448\u0435\u0445\u043E\u0434\u043D\u0430\u044F \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0430 \u0447\u0435\u0440\u0435\u0437 24 \u0447\u0430\u0441\u0430, \u043F\u043E\u043B\u043D\u0430\u044F \u2014 \u0447\u0435\u0440\u0435\u0437 7 \u0434\u043D\u0435\u0439.",
        epoxy_adv6: "<strong>\u0414\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0441\u0440\u043E\u043A \u0441\u043B\u0443\u0436\u0431\u044B</strong> \u2014 10-15+ \u043B\u0435\u0442 \u0432 \u043F\u0440\u043E\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u043F\u0440\u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u043C \u0443\u0445\u043E\u0434\u0435.",
        epoxy_h2_maintenance: "\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F",
        epoxy_p_maintenance: "\u042D\u043F\u043E\u043A\u0441\u0438\u0434\u043D\u044B\u0435 \u043F\u043E\u043B\u044B \u0442\u0440\u0435\u0431\u0443\u044E\u0442 \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0443\u0445\u043E\u0434\u0430, \u043D\u043E \u043D\u0435 \u043D\u0443\u043B\u0435\u0432\u043E\u0433\u043E. \u041F\u0440\u043E\u0441\u0442\u043E\u0439 \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B \u0443\u0431\u043E\u0440\u043A\u0438 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043F\u0440\u043E\u0434\u043B\u0435\u0432\u0430\u0435\u0442 \u0441\u0440\u043E\u043A \u0441\u043B\u0443\u0436\u0431\u044B:",
        epoxy_maint_daily: "\u0421\u0443\u0445\u0430\u044F \u0443\u0431\u043E\u0440\u043A\u0430 \u0438\u043B\u0438 \u0430\u0432\u0442\u043E\u0441\u043A\u0440\u0430\u0431\u0435\u0440 \u0434\u043B\u044F \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u044F \u0430\u0431\u0440\u0430\u0437\u0438\u0432\u043D\u044B\u0445 \u0447\u0430\u0441\u0442\u0438\u0446. \u041D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0430\u044F \u0443\u0431\u043E\u0440\u043A\u0430 \u043F\u0440\u043E\u043B\u0438\u0442\u043E\u0433\u043E.",
        epoxy_maint_weekly: "\u0412\u043B\u0430\u0436\u043D\u0430\u044F \u0443\u0431\u043E\u0440\u043A\u0430 \u0441 \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u043C pH-\u043E\u0447\u0438\u0441\u0442\u0438\u0442\u0435\u043B\u0435\u043C. \u0418\u0437\u0431\u0435\u0433\u0430\u0439\u0442\u0435 \u043A\u0438\u0441\u043B\u043E\u0442\u043D\u044B\u0445 \u0438\u043B\u0438 \u0449\u0435\u043B\u043E\u0447\u043D\u044B\u0445 \u0441\u0440\u0435\u0434\u0441\u0442\u0432.",
        epoxy_maint_quarterly: "\u0413\u043B\u0443\u0431\u043E\u043A\u0430\u044F \u043E\u0447\u0438\u0441\u0442\u043A\u0430 \u0430\u0432\u0442\u043E\u0441\u043A\u0440\u0430\u0431\u0435\u0440\u043E\u043C. \u041E\u0441\u043C\u043E\u0442\u0440 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0439, \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u043D\u0430 \u0441\u0442\u044B\u043A\u0430\u0445 \u0438 \u043A\u0440\u0430\u044F\u0445.",
        epoxy_maint_annually: "\u041F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439 \u043E\u0441\u043C\u043E\u0442\u0440. \u041F\u0435\u0440\u0435\u043A\u0440\u044B\u0442\u0438\u0435 \u0438\u0437\u043D\u043E\u0448\u0435\u043D\u043D\u044B\u0445 \u0437\u043E\u043D \u043F\u043E \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438.",
        epoxy_cta_title: "\u0413\u043E\u0442\u043E\u0432\u044B \u043A \u044D\u043F\u043E\u043A\u0441\u0438\u0434\u043D\u043E\u043C\u0443 \u043F\u0440\u043E\u0435\u043A\u0442\u0443?",
        epoxy_cta_text: "\u041D\u0430\u0448\u0430 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043A\u043E\u043C\u0430\u043D\u0434\u0430 \u043E\u0446\u0435\u043D\u0438\u0442 \u0432\u0430\u0448\u0438 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F \u0438 \u043F\u043E\u0434\u0431\u0435\u0440\u0451\u0442 \u043E\u043F\u0442\u0438\u043C\u0430\u043B\u044C\u043D\u0443\u044E \u044D\u043F\u043E\u043A\u0441\u0438\u0434\u043D\u0443\u044E \u0441\u0438\u0441\u0442\u0435\u043C\u0443.",
        epoxy_specs_title: "\u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438",
