        // Concrete
        concrete_category: "Sustainable Finish",
        concrete_title: "Decorative Concrete",
        concrete_meta: "Polished & Stained Finishes",
        concrete_lead: "Transform existing concrete into a finished floor through grinding, polishing, and staining. Maximum sustainability, minimum material input \u2014 the ultimate eco-conscious flooring choice.",
        concrete_h2_where: "Where Polished Concrete Works",
        concrete_p_where: "Polished concrete transforms ordinary slabs into beautiful, durable floors. It is ideal for spaces where sustainability, low maintenance, and modern aesthetics are priorities.",
        concrete_app1_title: "Retail & Showrooms",
        concrete_app1_desc: "Sleek, modern aesthetic. High light reflectivity reduces lighting costs. Low maintenance.",
        concrete_app2_title: "Warehouses & Distribution",
        concrete_app2_desc: "Densified concrete resists forklift traffic. Dust-proof surface improves air quality.",
        concrete_app3_title: "Office Buildings",
        concrete_app3_desc: "Sustainable flooring option. LEED credits. Exposed aggregate or cream finish.",
        concrete_app4_title: "Residential",
        concrete_app4_desc: "Industrial chic aesthetic. Works with radiant heating. Low-allergen flooring option.",
        concrete_h2_substrate: "Substrate Assessment",
        concrete_p_substrate: "Polished concrete transforms existing slabs. Final appearance depends heavily on substrate quality and condition. Our team conducts thorough assessments before every project.",
        concrete_sub1: "<strong>Concrete quality</strong> \u2014 Higher strength concrete (25+ MPa) polishes better. Aggregate type affects appearance",
        concrete_sub2: "<strong>Existing coatings</strong> \u2014 Old sealers, paints, adhesives must be removed. May require aggressive grinding",
        concrete_sub3: "<strong>Crack repair</strong> \u2014 Cracks filled with epoxy or polyurea. Will remain visible as design feature",
        concrete_sub4: "<strong>Flatness</strong> \u2014 Grinding removes high spots. Significant flatness correction requires overlays",
        concrete_sub5: "<strong>Moisture</strong> \u2014 Densifiers help with moderate moisture. Severe MVT may require mitigation",
        concrete_h2_process: "The Polishing Process",
        concrete_p_process: "Polished concrete is achieved through a systematic mechanical process that densifies and refines the surface.",
        concrete_layer1_title: "Grinding",
        concrete_layer1_desc: "Progressive diamond grinding from coarse (30-50 grit) to medium (100-200 grit). Removes surface layer, exposes aggregate if desired, creates flat plane.",
        concrete_layer2_title: "Densification",
        concrete_layer2_desc: "Lithium silicate densifier penetrates and reacts with concrete, hardening the surface. Creates dust-proof, wear-resistant matrix.",
        concrete_layer3_title: "Polishing",
        concrete_layer3_desc: "Fine diamond polishing (400-3000 grit) develops sheen. Higher grit = higher shine. Guard coat optional for stain resistance.",
        concrete_h2_finishes: "Finish Options",
        concrete_p_finishes: "We offer multiple finish levels to match your aesthetic and functional requirements:",
        concrete_var1_title: "Cream Polish",
        concrete_var1_desc: "Minimal grinding \u2014 surface paste polished. Uniform color, no aggregate exposure.",
        concrete_var2_title: "Salt & Pepper",
        concrete_var2_desc: "Light aggregate exposure. Mix of fine aggregate and cement paste visible.",
        concrete_var3_title: "Full Aggregate",
        concrete_var3_desc: "Deep grinding exposes coarse aggregate. Stone chips visible throughout.",
        concrete_var4_title: "Stained",
        concrete_var4_desc: "Acid stain or dye adds color. Reactive stains create variegated, unique effects.",
        concrete_h2_advantages: "Key Advantages",
        concrete_adv1: "<strong>Sustainable</strong> \u2014 No new materials added. Uses existing slab. Zero VOC. LEED credits available.",
        concrete_adv2: "<strong>Low Maintenance</strong> \u2014 Densified surface resists staining and dusting. Simple cleaning protocol.",
        concrete_adv3: "<strong>Cost Effective</strong> \u2014 No overlay materials. Lower lifecycle cost than most flooring systems.",
        concrete_adv4: "<strong>Light Reflective</strong> \u2014 High-gloss polish reflects ambient light, reducing lighting energy costs.",
        concrete_adv5: "<strong>Durable</strong> \u2014 25+ year service life. Can be re-polished if scratched or worn.",
        concrete_adv6: "<strong>No Floor Height Change</strong> \u2014 Process removes material rather than adding. No door or transition issues.",
        concrete_h2_maintenance: "Maintenance Protocol",
        concrete_p_maintenance: "Densified polished concrete is remarkably easy to maintain. The hard, dense surface resists wear and staining.",
        concrete_maint_daily: "Dust mop with clean microfiber. Auto-scrubber for large areas.",
        concrete_maint_weekly: "Damp mop with neutral pH cleaner. No wax or polish required.",
        concrete_maint_monthly: "Monthly",
        concrete_maint_monthly_desc: "Burnish with high-speed buffer if needed to restore gloss.",
        concrete_maint_asneeded: "Re-densify and re-polish worn areas. Usually every 5-10 years in high traffic.",
        concrete_cta_title: "Interested in Polished Concrete?",
        concrete_cta_text: "Let us assess your existing slab and recommend the best finish option for your space.",
        concrete_specs_title: "Technical Specifications",
        concrete_spec_thickness: "Added Thickness",
        concrete_spec_depth: "Grinding Depth",
        concrete_spec_sheen: "Sheen Levels",
        concrete_spec_sheen_v: "Matte to Mirror",
