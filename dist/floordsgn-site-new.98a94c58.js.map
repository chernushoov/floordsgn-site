        services_subtitle: "\u041D\u0430\u0448\u0430 \u044D\u043A\u0441\u043F\u0435\u0440\u0442\u0438\u0437\u0430",
        services_title: "\u0421\u0438\u0441\u0442\u0435\u043C\u044B \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0439",
        service_industrial: "\u041F\u0440\u043E\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u044B\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B",
        service_industrial_desc: "\u042D\u043F\u043E\u043A\u0441\u0438\u0434\u043D\u044B\u0435 \u0438 \u043F\u043E\u043B\u0438\u0443\u0440\u0435\u0442\u0430\u043D\u043E\u0432\u044B\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F \u0434\u043B\u044F \u0437\u0430\u0432\u043E\u0434\u043E\u0432, \u0441\u043A\u043B\u0430\u0434\u043E\u0432 \u0438 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432.",
        service_decorative: "\u0414\u0435\u043A\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u044F",
        service_decorative_desc: "\u0422\u0435\u0440\u0440\u0430\u0446\u0446\u043E, \u043C\u0438\u043A\u0440\u043E\u0442\u043E\u043F\u043F\u0438\u043D\u0433, \u043F\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0431\u0435\u0442\u043E\u043D \u0434\u043B\u044F \u043A\u043E\u043C\u043C\u0435\u0440\u0447\u0435\u0441\u043A\u0438\u0445 \u0438 \u0436\u0438\u043B\u044B\u0445 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0439.",
        service_specialty: "\u0421\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435 \u043F\u043E\u043B\u044B",
        service_specialty_desc: "\u0410\u043D\u0442\u0438\u0441\u0442\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435, \u0445\u0438\u043C\u0441\u0442\u043E\u0439\u043A\u0438\u0435 \u0438 \u043F\u0438\u0449\u0435\u0432\u044B\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u0434\u043B\u044F \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u0439.",
