        epoxy_substr_profile: "\u041F\u0440\u043E\u0444\u0438\u043B\u044C \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438",
        epoxy_warranty_years: "5 \u043B\u0435\u0442",
        epoxy_warranty_inspect: "\u0411\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B\u0435 \u043E\u0441\u043C\u043E\u0442\u0440\u044B",
        epoxy_warranty_inspect_v: "\u0413\u043E\u0434 1 \u0438 3",
