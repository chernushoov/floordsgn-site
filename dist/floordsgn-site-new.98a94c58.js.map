        // Quality Section
        quality_subtitle: "\u041D\u0430\u0448 \u043F\u043E\u0434\u0445\u043E\u0434",
        quality_title: "\u0418\u043D\u0436\u0435\u043D\u0435\u0440\u043D\u043E\u0435 \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u043E",
        quality_text: "\u041C\u044B \u0441\u043E\u0447\u0435\u0442\u0430\u0435\u043C \u0435\u0432\u0440\u043E\u043F\u0435\u0439\u0441\u043A\u0438\u0435 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B \u0441 \u0442\u043E\u0447\u043D\u044B\u043C \u043C\u043E\u043D\u0442\u0430\u0436\u043E\u043C \u0434\u043B\u044F \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u043F\u043E\u043B\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u043B\u0443\u0436\u0430\u0442 \u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0435\u0442\u0438\u044F\u043C\u0438. \u041A\u0430\u0436\u0434\u044B\u0439 \u043F\u0440\u043E\u0435\u043A\u0442 \u043F\u043E\u0434\u043A\u0440\u0435\u043F\u043B\u0451\u043D \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0435\u0439 \u0438 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E\u0439 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u043E\u0439.",
        quality_item1: "\u041D\u0435\u043C\u0435\u0446\u043A\u0438\u0435 \u0438 \u0438\u0442\u0430\u043B\u044C\u044F\u043D\u0441\u043A\u0438\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432",
        quality_item2: "ISO-\u0441\u0435\u0440\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u044B \u043C\u043E\u043D\u0442\u0430\u0436\u0430",
        quality_item3: "\u041F\u043E\u043B\u043D\u0430\u044F \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u044F \u043D\u0430 \u043F\u0440\u043E\u0435\u043A\u0442",
        quality_item4: "\u041F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u0430\u044F \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430",
        // Process Section
        process_subtitle: "\u041D\u0430\u0448 \u043F\u0440\u043E\u0446\u0435\u0441\u0441",
        process_title: "\u041A\u0430\u043A \u043C\u044B \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u043C",
        process_step1_title: "\u041A\u043E\u043D\u0441\u0443\u043B\u044C\u0442\u0430\u0446\u0438\u044F",
        process_step1_text: "\u0411\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B\u0439 \u0432\u044B\u0435\u0437\u0434 \u043D\u0430 \u043E\u0431\u044A\u0435\u043A\u0442. \u041E\u0446\u0435\u043D\u0438\u0432\u0430\u0435\u043C \u0443\u0441\u043B\u043E\u0432\u0438\u044F, \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u0435\u043C \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F, \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u043C \u0440\u0435\u0448\u0435\u043D\u0438\u044F.",
        process_step2_title: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435",
        process_step2_text: "\u0414\u0435\u0442\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u043C\u0435\u0442\u0430 \u0437\u0430 48 \u0447\u0430\u0441\u043E\u0432. \u0424\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F \u0446\u0435\u043D\u0430, \u0431\u0435\u0437 \u0441\u043A\u0440\u044B\u0442\u044B\u0445 \u043F\u043B\u0430\u0442\u0435\u0436\u0435\u0439, \u0447\u0451\u0442\u043A\u0438\u0435 \u0441\u0440\u043E\u043A\u0438.",
        process_step3_title: "\u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430",
        process_step3_text: "\u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F, \u0440\u0435\u043C\u043E\u043D\u0442 \u0442\u0440\u0435\u0449\u0438\u043D, \u0442\u0435\u0441\u0442 \u0432\u043B\u0430\u0436\u043D\u043E\u0441\u0442\u0438. \u0424\u0443\u043D\u0434\u0430\u043C\u0435\u043D\u0442 \u0434\u043B\u044F \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0430.",
        process_step4_title: "\u041C\u043E\u043D\u0442\u0430\u0436",
        process_step4_text: "\u041F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0435 \u043D\u0430\u043D\u0435\u0441\u0435\u043D\u0438\u0435 \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C\u0438 \u0431\u0440\u0438\u0433\u0430\u0434\u0430\u043C\u0438. \u0422\u0438\u043F\u0438\u0447\u043D\u044B\u0439 \u043F\u0440\u043E\u0435\u043A\u0442: 3-7 \u0434\u043D\u0435\u0439.",
        process_step5_title: "\u0413\u0430\u0440\u0430\u043D\u0442\u0438\u044F",
        process_step5_text: "\u0413\u0430\u0440\u0430\u043D\u0442\u0438\u044F 10 \u043B\u0435\u0442 \u043D\u0430 \u0432\u0441\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B. \u0414\u043E\u0441\u0442\u0443\u043F\u043D\u0430 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u0430\u044F \u0442\u0435\u0445\u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430.",
        // Testimonials
        testimonials_subtitle: "\u041E\u0442\u0437\u044B\u0432\u044B \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432",
        testimonials_title: "\u0427\u0442\u043E \u0433\u043E\u0432\u043E\u0440\u044F\u0442 \u043E \u043D\u0430\u0441",
        testimonial1_text: "\u0412\u044B\u043F\u043E\u043B\u043D\u0438\u043B\u0438 12 000 \u043A\u0432.\u043C. \u0441\u043A\u043B\u0430\u0434\u0430 \u0432\u0441\u0435\u0433\u043E \u0437\u0430 5 \u0434\u043D\u0435\u0439. \u041D\u043E\u043B\u044C \u0434\u0435\u0444\u0435\u043A\u0442\u043E\u0432 \u043F\u043E\u0441\u043B\u0435 3 \u043B\u0435\u0442 \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0439 \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u0438 \u043F\u043E\u0433\u0440\u0443\u0437\u0447\u0438\u043A\u0430\u043C\u0438. \u0418\u0441\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E.",
        testimonial1_author: "\u0414\u0430\u0432\u0438\u0434 \u041A.",
        testimonial1_role: "\u0423\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0449\u0438\u0439 \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u043C, \u041B\u043E\u0433\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0446\u0435\u043D\u0442\u0440 \u0410\u0448\u0434\u043E\u0434",
        testimonial2_text: "\u041F\u043E\u043B \u0438\u0437 \u0442\u0435\u0440\u0440\u0430\u0446\u0446\u043E \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u0438\u043B \u043D\u0430\u0448 \u0448\u043E\u0443\u0440\u0443\u043C. \u041A\u043B\u0438\u0435\u043D\u0442\u044B \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E \u0434\u0435\u043B\u0430\u044E\u0442 \u043A\u043E\u043C\u043F\u043B\u0438\u043C\u0435\u043D\u0442\u044B. \u0421\u0442\u043E\u0438\u0442 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0448\u0435\u043A\u0435\u043B\u044F \u2014 \u044D\u0442\u043E \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u044F \u0432 \u0438\u043C\u0438\u0434\u0436 \u0431\u0440\u0435\u043D\u0434\u0430.",
        testimonial2_author: "\u041C\u0430\u0440\u0438\u043D\u0430 \u0421.",
        testimonial2_role: "\u0412\u043B\u0430\u0434\u0435\u043B\u0435\u0446, \u041C\u0435\u0431\u0435\u043B\u044C\u043D\u0430\u044F \u0433\u0430\u043B\u0435\u0440\u0435\u044F \u0422\u0435\u043B\u044C-\u0410\u0432\u0438\u0432",
        testimonial3_text: "\u041D\u0430\u043C \u043D\u0443\u0436\u0435\u043D \u0431\u044B\u043B \u043F\u0438\u0449\u0435\u0432\u043E\u0439 \u044D\u043F\u043E\u043A\u0441\u0438\u0434 \u0434\u043B\u044F \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430. Floor.DSGN \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u043B\u0438 \u0432 \u0441\u0440\u043E\u043A, \u043F\u0440\u043E\u0448\u043B\u0438 \u0432\u0441\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438. \u041E\u0447\u0435\u043D\u044C \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u044E.",
