        // Restoration
        rest_category: "Maintenance Services",
        rest_title: "Floor Restoration & Sealer Renewal",
        rest_meta: "Renew Don't Replace",
        rest_lead: "Extend the life of existing floors through professional restoration, recoating, and sealer renewal. Cost-effective maintenance that restores appearance and protection at a fraction of replacement cost.",
        rest_h2_what: "What We Restore",
        rest_p_what: "Our restoration services cover all major flooring systems. We assess each floor individually to determine the most effective restoration approach.",
        rest_app1_title: "Epoxy Floor Recoating",
        rest_app1_desc: "Worn epoxy floors recoated with matching or upgraded topcoats. Restores gloss, repairs damage, extends service life.",
        rest_app2_title: "Polished Concrete Re-Polish",
        rest_app2_desc: "Diamond honing and re-polishing of worn polished concrete. Restores shine without full replacement.",
        rest_app3_title: "Terrazzo Restoration",
        rest_app3_desc: "Historic or worn terrazzo ground and polished back to original condition. Crack repair included.",
        rest_app4_title: "Microtopping Resealing",
        rest_app4_desc: "Worn sealer stripped and renewed. Restores stain resistance and appearance.",
        rest_h2_assessment: "Assessment Process",
        rest_p_assessment: "Not all floors can be restored. We conduct thorough assessment to determine if restoration is viable and cost-effective before recommending a course of action.",
        rest_assess1: "<strong>Adhesion testing</strong> \u2014 Pull-off tests verify existing coating adhesion. Delaminated coatings may need removal",
        rest_assess2: "<strong>Damage assessment</strong> \u2014 Extent of wear, chemical damage, mechanical damage documented",
        rest_assess3: "<strong>Moisture testing</strong> \u2014 Underlying moisture issues must be addressed before recoating",
        rest_assess4: "<strong>Compatibility</strong> \u2014 New coatings must be compatible with existing system. Unknown coatings may need removal",
        rest_assess5: "<strong>Cost-benefit analysis</strong> \u2014 We will tell you honestly if replacement makes more sense than restoration",
        rest_h2_workflow: "Restoration Workflow",
        rest_p_workflow: "Our systematic approach ensures consistent, high-quality restoration results.",
        rest_layer1_title: "Assessment & Quote",
        rest_layer1_desc: "Site visit, testing, documentation. We provide detailed report with options and honest recommendations. No-obligation quote.",
        rest_layer2_title: "Preparation",
        rest_layer2_desc: "Diamond grinding or sanding to create profile for new coating. Repairs to cracks, chips, and damaged areas. Thorough cleaning.",
        rest_layer3_title: "Restoration",
        rest_layer3_desc: "Application of primer (if needed), body coats, and topcoats. System matched to existing floor or upgraded as specified.",
        rest_h2_scenarios: "Common Restoration Scenarios",
        rest_p_scenarios: "Here are typical situations where restoration provides excellent value:",
        rest_var1_title: "Warehouse Traffic Wear",
        rest_var1_desc: "High-traffic lanes recoated. Edge wear addressed. Demarcation lines renewed.",
        rest_var2_title: "Kitchen Sealer Failure",
        rest_var2_desc: "Stripped and resealed after chemical damage or wear. Non-slip texture maintained.",
        rest_var3_title: "Showroom Refresh",
        rest_var3_desc: "Scratched or dull finish polished and resealed. Restores retail appearance.",
        rest_var4_title: "Historic Terrazzo",
        rest_var4_desc: "Decades-old terrazzo ground, polished, and sealed. Reveals original beauty.",
        rest_h2_advantages: "Key Advantages",
        rest_adv1: "<strong>Cost Effective</strong> \u2014 50-70% of replacement cost. Extends floor life at fraction of new installation price.",
        rest_adv2: "<strong>Less Downtime</strong> \u2014 Typically 1-3 days vs. 1-2 weeks for full replacement. Business continues faster.",
        rest_adv3: "<strong>Sustainable</strong> \u2014 Keeps existing floor out of landfill. Minimal new materials required.",
        rest_adv4: "<strong>No Demolition</strong> \u2014 No removal of existing floor. Less disruption, noise, and waste.",
        rest_adv5: "<strong>Upgrade Opportunity</strong> \u2014 Can upgrade to better topcoat, add slip resistance, or change color during restoration.",
        rest_adv6: "<strong>Preventive Maintenance</strong> \u2014 Regular recoating prevents wear-through to substrate. Extends total floor lifespan.",
        rest_h2_planning: "Maintenance Planning",
        rest_p_planning: "The best time to restore is before the floor fails completely. We help you plan maintenance cycles for optimal floor performance.",
        rest_maint_annual: "Annual Inspection",
        rest_maint_annual_desc: "We assess floor condition and recommend maintenance. Catches issues early.",
        rest_maint_traffic: "High-Traffic Recoating",
        rest_maint_traffic_desc: "Recoat wear areas every 3-5 years to maintain protection before substrate exposure.",
        rest_maint_full: "Full Recoat Cycle",
        rest_maint_full_desc: "Complete topcoat renewal every 5-10 years depending on traffic and use.",
        rest_maint_contracts: "Maintenance Contracts",
        rest_maint_contracts_desc: "We offer annual maintenance agreements for planned, budgeted floor care.",
        rest_cta_title: "Is Your Floor Worth Saving?",
        rest_cta_text: "Let us assess your floor and give you honest advice on restoration vs. replacement.",
        rest_cta_btn: "Request Assessment",
        rest_benefits_title: "Restoration Benefits",
        rest_ben_cost: "Cost vs. Replacement",
