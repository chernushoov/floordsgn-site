        epoxy_p_where: "\u042D\u043F\u043E\u043A\u0441\u0438\u0434\u043D\u044B\u0435 \u043F\u043E\u043B\u044B \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u044B \u0434\u043B\u044F \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u043F\u0440\u043E\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u0439 \u0441 \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C, \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u044B\u043C \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435\u043C \u0438 \u0441\u0442\u0440\u043E\u0433\u0438\u043C\u0438 \u0433\u0438\u0433\u0438\u0435\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F\u043C\u0438. \u041E\u0442 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445 \u0446\u0435\u0445\u043E\u0432 \u0434\u043E \u0444\u0430\u0440\u043C\u0430\u0446\u0435\u0432\u0442\u0438\u043A\u0438 \u2014 \u044D\u043F\u043E\u043A\u0441\u0438\u0434 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0431\u0435\u0441\u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0438\u0441\u0441\u043D\u0443\u044E \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C.",
