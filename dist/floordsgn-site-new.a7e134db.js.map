        rest_category: "\u0421\u0435\u0440\u0432\u0438\u0441\u043D\u043E\u0435 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0435",
        rest_title: "\u0420\u0435\u0441\u0442\u0430\u0432\u0440\u0430\u0446\u0438\u044F \u043F\u043E\u043B\u043E\u0432 \u0438 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435 \u0433\u0435\u0440\u043C\u0435\u0442\u0438\u043A\u0430",
        rest_meta: "\u041E\u0431\u043D\u043E\u0432\u0438\u0442\u044C, \u0430 \u043D\u0435 \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C",
        rest_lead: "\u041F\u0440\u043E\u0434\u043B\u0435\u043D\u0438\u0435 \u0441\u0440\u043E\u043A\u0430 \u0441\u043B\u0443\u0436\u0431\u044B \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0445 \u043F\u043E\u043B\u043E\u0432 \u0447\u0435\u0440\u0435\u0437 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u0443\u044E \u0440\u0435\u0441\u0442\u0430\u0432\u0440\u0430\u0446\u0438\u044E, \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0442\u0438\u0435 \u0438 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435 \u0433\u0435\u0440\u043C\u0435\u0442\u0438\u043A\u0430. \u042D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u043D\u043E\u0435 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442 \u0432\u0438\u0434 \u0438 \u0437\u0430\u0449\u0438\u0442\u0443 \u0437\u0430 \u0434\u043E\u043B\u044E \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u0438 \u0437\u0430\u043C\u0435\u043D\u044B.",
        rest_h2_what: "\u0427\u0442\u043E \u043C\u044B \u0440\u0435\u0441\u0442\u0430\u0432\u0440\u0438\u0440\u0443\u0435\u043C",
        rest_p_what: "\u041D\u0430\u0448\u0438 \u0443\u0441\u043B\u0443\u0433\u0438 \u0440\u0435\u0441\u0442\u0430\u0432\u0440\u0430\u0446\u0438\u0438 \u043E\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u044E\u0442 \u0432\u0441\u0435 \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u043D\u0430\u043F\u043E\u043B\u044C\u043D\u044B\u0445 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0439. \u041C\u044B \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u043E \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0435\u043C \u043A\u0430\u0436\u0434\u044B\u0439 \u043F\u043E\u043B \u0434\u043B\u044F \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F \u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0433\u043E \u043F\u043E\u0434\u0445\u043E\u0434\u0430.",
        rest_app1_title: "\u041F\u0435\u0440\u0435\u043A\u0440\u044B\u0442\u0438\u0435 \u044D\u043F\u043E\u043A\u0441\u0438\u0434\u0430",
        rest_app1_desc: "\u0418\u0437\u043D\u043E\u0448\u0435\u043D\u043D\u044B\u0435 \u044D\u043F\u043E\u043A\u0441\u0438\u0434\u043D\u044B\u0435 \u043F\u043E\u043B\u044B \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0438\u043C\u0438 \u0438\u043B\u0438 \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u043D\u044B\u043C\u0438 \u0442\u043E\u043F\u043A\u043E\u0443\u0442\u0430\u043C\u0438. \u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435 \u0431\u043B\u0435\u0441\u043A\u0430, \u0440\u0435\u043C\u043E\u043D\u0442 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0439, \u043F\u0440\u043E\u0434\u043B\u0435\u043D\u0438\u0435 \u0441\u0440\u043E\u043A\u0430 \u0441\u043B\u0443\u0436\u0431\u044B.",
        rest_app2_title: "\u041F\u0435\u0440\u0435\u043F\u043E\u043B\u0438\u0440\u043E\u0432\u043A\u0430 \u0431\u0435\u0442\u043E\u043D\u0430",
        rest_app2_desc: "\u0410\u043B\u043C\u0430\u0437\u043D\u0430\u044F \u0448\u043B\u0438\u0444\u043E\u0432\u043A\u0430 \u0438 \u043F\u0435\u0440\u0435\u043F\u043E\u043B\u0438\u0440\u043E\u0432\u043A\u0430 \u0438\u0437\u043D\u043E\u0448\u0435\u043D\u043D\u043E\u0433\u043E \u043F\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E \u0431\u0435\u0442\u043E\u043D\u0430. \u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435 \u0431\u043B\u0435\u0441\u043A\u0430 \u0431\u0435\u0437 \u043F\u043E\u043B\u043D\u043E\u0439 \u0437\u0430\u043C\u0435\u043D\u044B.",
        rest_app3_title: "\u0420\u0435\u0441\u0442\u0430\u0432\u0440\u0430\u0446\u0438\u044F \u0442\u0435\u0440\u0440\u0430\u0446\u0446\u043E",
        rest_app3_desc: "\u0418\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0438\u043B\u0438 \u0438\u0437\u043D\u043E\u0448\u0435\u043D\u043D\u044B\u0435 \u0442\u0435\u0440\u0440\u0430\u0446\u0446\u043E \u0448\u043B\u0438\u0444\u0443\u044E\u0442\u0441\u044F \u0438 \u043F\u043E\u043B\u0438\u0440\u0443\u044E\u0442\u0441\u044F \u0434\u043E \u0438\u0441\u0445\u043E\u0434\u043D\u043E\u0433\u043E \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F. \u0420\u0435\u043C\u043E\u043D\u0442 \u0442\u0440\u0435\u0449\u0438\u043D \u0432\u043A\u043B\u044E\u0447\u0451\u043D.",
        rest_app4_title: "\u041F\u0435\u0440\u0435\u0433\u0435\u0440\u043C\u0435\u0442\u0438\u0437\u0430\u0446\u0438\u044F \u043C\u0438\u043A\u0440\u043E\u0442\u043E\u043F\u043F\u0438\u043D\u0433\u0430",
        rest_app4_desc: "\u0418\u0437\u043D\u043E\u0448\u0435\u043D\u043D\u044B\u0439 \u0433\u0435\u0440\u043C\u0435\u0442\u0438\u043A \u0441\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \u0438 \u043E\u0431\u043D\u043E\u0432\u043B\u044F\u0435\u0442\u0441\u044F. \u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435 \u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u0438 \u043A \u043F\u044F\u0442\u043D\u0430\u043C \u0438 \u0432\u043D\u0435\u0448\u043D\u0435\u0433\u043E \u0432\u0438\u0434\u0430.",
        rest_h2_assessment: "\u041F\u0440\u043E\u0446\u0435\u0441\u0441 \u043E\u0446\u0435\u043D\u043A\u0438",
        rest_p_assessment: "\u041D\u0435 \u0432\u0441\u0435 \u043F\u043E\u043B\u044B \u043C\u043E\u0436\u043D\u043E \u0440\u0435\u0441\u0442\u0430\u0432\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C. \u041C\u044B \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u043C \u0442\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u0443\u044E \u043E\u0446\u0435\u043D\u043A\u0443, \u0447\u0442\u043E\u0431\u044B \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u0430 \u043B\u0438 \u0438 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u043D\u0430 \u043B\u0438 \u0440\u0435\u0441\u0442\u0430\u0432\u0440\u0430\u0446\u0438\u044F, \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u043E\u0432\u0430\u0442\u044C \u043A\u0443\u0440\u0441 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439.",
        rest_assess1: "<strong>\u0422\u0435\u0441\u0442 \u0430\u0434\u0433\u0435\u0437\u0438\u0438</strong> \u2014 \u041E\u0442\u0440\u044B\u0432\u043D\u044B\u0435 \u0442\u0435\u0441\u0442\u044B \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044E\u0442 \u0430\u0434\u0433\u0435\u0437\u0438\u044E \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0433\u043E \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F. \u041E\u0442\u0441\u043B\u0430\u0438\u0432\u0430\u044E\u0449\u0438\u0435\u0441\u044F \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F \u043C\u043E\u0433\u0443\u0442 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u044F",
        rest_assess2: "<strong>\u041E\u0446\u0435\u043D\u043A\u0430 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0439</strong> \u2014 \u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0438\u0440\u0443\u0435\u0442\u0441\u044F \u0441\u0442\u0435\u043F\u0435\u043D\u044C \u0438\u0437\u043D\u043E\u0441\u0430, \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0438 \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0439",
        rest_assess3: "<strong>\u0422\u0435\u0441\u0442 \u0432\u043B\u0430\u0436\u043D\u043E\u0441\u0442\u0438</strong> \u2014 \u041F\u0440\u043E\u0431\u043B\u0435\u043C\u044B \u0441 \u0432\u043B\u0430\u0433\u043E\u0439 \u0432 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0438 \u0434\u043E\u043B\u0436\u043D\u044B \u0431\u044B\u0442\u044C \u0440\u0435\u0448\u0435\u043D\u044B \u0434\u043E \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0442\u0438\u044F",
        rest_assess4: "<strong>\u0421\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u043E\u0441\u0442\u044C</strong> \u2014 \u041D\u043E\u0432\u044B\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F \u0434\u043E\u043B\u0436\u043D\u044B \u0431\u044B\u0442\u044C \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u044B \u0441 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u0439. \u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F \u043C\u043E\u0433\u0443\u0442 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u044F",
        rest_assess5: "<strong>\u0410\u043D\u0430\u043B\u0438\u0437 \u0437\u0430\u0442\u0440\u0430\u0442/\u0432\u044B\u0433\u043E\u0434</strong> \u2014 \u041C\u044B \u0447\u0435\u0441\u0442\u043D\u043E \u0441\u043A\u0430\u0436\u0435\u043C, \u0435\u0441\u043B\u0438 \u0437\u0430\u043C\u0435\u043D\u0430 \u0446\u0435\u043B\u0435\u0441\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u0435\u0435 \u0440\u0435\u0441\u0442\u0430\u0432\u0440\u0430\u0446\u0438\u0438",
        rest_h2_workflow: "\u0420\u0430\u0431\u043E\u0447\u0438\u0439 \u043F\u0440\u043E\u0446\u0435\u0441\u0441 \u0440\u0435\u0441\u0442\u0430\u0432\u0440\u0430\u0446\u0438\u0438",
        rest_p_workflow: "\u041D\u0430\u0448 \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u043E\u0434\u0445\u043E\u0434 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u044B\u0435, \u0432\u044B\u0441\u043E\u043A\u043E\u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B \u0440\u0435\u0441\u0442\u0430\u0432\u0440\u0430\u0446\u0438\u0438.",
        rest_layer1_title: "\u041E\u0446\u0435\u043D\u043A\u0430 \u0438 \u0440\u0430\u0441\u0447\u0451\u0442",
        rest_layer1_desc: "\u0412\u044B\u0435\u0437\u0434 \u043D\u0430 \u043E\u0431\u044A\u0435\u043A\u0442, \u0442\u0435\u0441\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435, \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435. \u041C\u044B \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u043C \u0434\u0435\u0442\u0430\u043B\u044C\u043D\u044B\u0439 \u043E\u0442\u0447\u0451\u0442 \u0441 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430\u043C\u0438 \u0438 \u0447\u0435\u0441\u0442\u043D\u044B\u043C\u0438 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0446\u0438\u044F\u043C\u0438. \u0420\u0430\u0441\u0447\u0451\u0442 \u0431\u0435\u0437 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432.",
        rest_layer2_title: "\u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430",
        rest_layer2_desc: "\u0410\u043B\u043C\u0430\u0437\u043D\u0430\u044F \u0448\u043B\u0438\u0444\u043E\u0432\u043A\u0430 \u0438\u043B\u0438 \u0430\u0431\u0440\u0430\u0437\u0438\u0432\u043D\u0430\u044F \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0430 \u0434\u043B\u044F \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u043F\u0440\u043E\u0444\u0438\u043B\u044F \u043F\u043E\u0434 \u043D\u043E\u0432\u043E\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435. \u0420\u0435\u043C\u043E\u043D\u0442 \u0442\u0440\u0435\u0449\u0438\u043D, \u0441\u043A\u043E\u043B\u043E\u0432 \u0438 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0451\u043D\u043D\u044B\u0445 \u0443\u0447\u0430\u0441\u0442\u043A\u043E\u0432. \u0422\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u043E\u0447\u0438\u0441\u0442\u043A\u0430.",
        rest_layer3_title: "\u0420\u0435\u0441\u0442\u0430\u0432\u0440\u0430\u0446\u0438\u044F",
        rest_layer3_desc: "\u041D\u0430\u043D\u0435\u0441\u0435\u043D\u0438\u0435 \u043F\u0440\u0430\u0439\u043C\u0435\u0440\u0430 (\u043F\u0440\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438), \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0445 \u0438 \u0444\u0438\u043D\u0438\u0448\u043D\u044B\u0445 \u0441\u043B\u043E\u0451\u0432. \u0421\u0438\u0441\u0442\u0435\u043C\u0430 \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F \u043F\u043E\u0434 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439 \u043F\u043E\u043B \u0438\u043B\u0438 \u0443\u043B\u0443\u0447\u0448\u0430\u0435\u0442\u0441\u044F \u043F\u043E \u0441\u043E\u0433\u043B\u0430\u0441\u043E\u0432\u0430\u043D\u0438\u044E.",
        rest_h2_scenarios: "\u0422\u0438\u043F\u0438\u0447\u043D\u044B\u0435 \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u0438 \u0440\u0435\u0441\u0442\u0430\u0432\u0440\u0430\u0446\u0438\u0438",
        rest_p_scenarios: "\u0412\u043E\u0442 \u0442\u0438\u043F\u0438\u0447\u043D\u044B\u0435 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438, \u0433\u0434\u0435 \u0440\u0435\u0441\u0442\u0430\u0432\u0440\u0430\u0446\u0438\u044F \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043E\u0442\u043B\u0438\u0447\u043D\u0443\u044E \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u044C:",
        rest_var1_title: "\u0418\u0437\u043D\u043E\u0441 \u043E\u0442 \u0441\u043A\u043B\u0430\u0434\u0441\u043A\u043E\u0433\u043E \u0442\u0440\u0430\u0444\u0438\u043A\u0430",
        rest_var1_desc: "\u041F\u0435\u0440\u0435\u043A\u0440\u044B\u0442\u0438\u0435 \u043F\u043E\u043B\u043E\u0441 \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0433\u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F. \u0423\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u043A\u0440\u0430\u0435\u0432\u043E\u0433\u043E \u0438\u0437\u043D\u043E\u0441\u0430. \u041E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435 \u0440\u0430\u0437\u043C\u0435\u0442\u043A\u0438.",
        rest_var2_title: "\u0418\u0437\u043D\u043E\u0441 \u0433\u0435\u0440\u043C\u0435\u0442\u0438\u043A\u0430 \u043D\u0430 \u043A\u0443\u0445\u043D\u0435",
        rest_var2_desc: "\u0421\u043D\u044F\u0442\u0438\u0435 \u0438 \u043F\u0435\u0440\u0435\u0433\u0435\u0440\u043C\u0435\u0442\u0438\u0437\u0430\u0446\u0438\u044F \u043F\u043E\u0441\u043B\u0435 \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F \u0438\u043B\u0438 \u0438\u0437\u043D\u043E\u0441\u0430. \u0421\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u044F\u0449\u0435\u0439 \u0442\u0435\u043A\u0441\u0442\u0443\u0440\u044B.",
        rest_var3_title: "\u041E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435 \u0448\u043E\u0443\u0440\u0443\u043C\u0430",
        rest_var3_desc: "\u041F\u043E\u043B\u0438\u0440\u043E\u0432\u043A\u0430 \u0438 \u043F\u0435\u0440\u0435\u0433\u0435\u0440\u043C\u0435\u0442\u0438\u0437\u0430\u0446\u0438\u044F \u043F\u043E\u0446\u0430\u0440\u0430\u043F\u0430\u043D\u043D\u043E\u0439 \u0438\u043B\u0438 \u043F\u043E\u0442\u0443\u0441\u043A\u043D\u0435\u0432\u0448\u0435\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438. \u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E \u0432\u0438\u0434\u0430.",
        rest_var4_title: "\u0418\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u0442\u0435\u0440\u0440\u0430\u0446\u0446\u043E",
        rest_var4_desc: "\u041C\u043D\u043E\u0433\u043E\u043B\u0435\u0442\u043D\u0435\u0435 \u0442\u0435\u0440\u0440\u0430\u0446\u0446\u043E \u0448\u043B\u0438\u0444\u0443\u0435\u0442\u0441\u044F, \u043F\u043E\u043B\u0438\u0440\u0443\u0435\u0442\u0441\u044F \u0438 \u0433\u0435\u0440\u043C\u0435\u0442\u0438\u0437\u0438\u0440\u0443\u0435\u0442\u0441\u044F. \u0420\u0430\u0441\u043A\u0440\u044B\u0442\u0438\u0435 \u0438\u0441\u0445\u043E\u0434\u043D\u043E\u0439 \u043A\u0440\u0430\u0441\u043E\u0442\u044B.",
        rest_h2_advantages: "\u041A\u043B\u044E\u0447\u0435\u0432\u044B\u0435 \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0430",
        rest_adv1: "<strong>\u042D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u043D\u043E\u0441\u0442\u044C</strong> \u2014 50-70% \u043E\u0442 \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u0438 \u0437\u0430\u043C\u0435\u043D\u044B. \u041F\u0440\u043E\u0434\u043B\u0435\u043D\u0438\u0435 \u0441\u0440\u043E\u043A\u0430 \u0441\u043B\u0443\u0436\u0431\u044B \u043F\u043E\u043B\u0430 \u0437\u0430 \u0434\u043E\u043B\u044E \u0446\u0435\u043D\u044B \u043D\u043E\u0432\u043E\u0439 \u0443\u043A\u043B\u0430\u0434\u043A\u0438.",
        rest_adv2: "<strong>\u041C\u0435\u043D\u044C\u0448\u0435 \u043F\u0440\u043E\u0441\u0442\u043E\u044F</strong> \u2014 \u041E\u0431\u044B\u0447\u043D\u043E 1-3 \u0434\u043D\u044F \u043F\u0440\u043E\u0442\u0438\u0432 1-2 \u043D\u0435\u0434\u0435\u043B\u044C \u0434\u043B\u044F \u043F\u043E\u043B\u043D\u043E\u0439 \u0437\u0430\u043C\u0435\u043D\u044B. \u0411\u0438\u0437\u043D\u0435\u0441 \u0432\u043E\u0437\u043E\u0431\u043D\u043E\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0431\u044B\u0441\u0442\u0440\u0435\u0435.",
        rest_adv3: "<strong>\u042D\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u043D\u043E\u0441\u0442\u044C</strong> \u2014 \u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439 \u043F\u043E\u043B \u043D\u0435 \u0438\u0434\u0451\u0442 \u043D\u0430 \u0441\u0432\u0430\u043B\u043A\u0443. \u041C\u0438\u043D\u0438\u043C\u0443\u043C \u043D\u043E\u0432\u044B\u0445 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432.",
        rest_adv4: "<strong>\u0411\u0435\u0437 \u0434\u0435\u043C\u043E\u043D\u0442\u0430\u0436\u0430</strong> \u2014 \u041D\u0435 \u043D\u0443\u0436\u043D\u043E \u0441\u043D\u0438\u043C\u0430\u0442\u044C \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439 \u043F\u043E\u043B. \u041C\u0435\u043D\u044C\u0448\u0435 \u0448\u0443\u043C\u0430, \u043F\u044B\u043B\u0438 \u0438 \u043E\u0442\u0445\u043E\u0434\u043E\u0432.",
        rest_adv5: "<strong>\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F</strong> \u2014 \u041C\u043E\u0436\u043D\u043E \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u044C \u0442\u043E\u043F\u043A\u043E\u0443\u0442, \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0441\u043A\u043E\u043B\u044C\u0436\u0435\u043D\u0438\u0435 \u0438\u043B\u0438 \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0446\u0432\u0435\u0442 \u043F\u0440\u0438 \u0440\u0435\u0441\u0442\u0430\u0432\u0440\u0430\u0446\u0438\u0438.",
        rest_adv6: "<strong>\u041F\u0440\u0435\u0432\u0435\u043D\u0442\u0438\u0432\u043D\u043E\u0435 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0435</strong> \u2014 \u0420\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u043E\u0435 \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0442\u0438\u0435 \u043F\u0440\u0435\u0434\u043E\u0442\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0438\u0437\u043D\u043E\u0441 \u0434\u043E \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F. \u041F\u0440\u043E\u0434\u043B\u0435\u043D\u0438\u0435 \u043E\u0431\u0449\u0435\u0433\u043E \u0441\u0440\u043E\u043A\u0430 \u0441\u043B\u0443\u0436\u0431\u044B \u043F\u043E\u043B\u0430.",
        rest_h2_planning: "\u041F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F",
        rest_p_planning: "\u041B\u0443\u0447\u0448\u0435\u0435 \u0432\u0440\u0435\u043C\u044F \u0434\u043B\u044F \u0440\u0435\u0441\u0442\u0430\u0432\u0440\u0430\u0446\u0438\u0438 \u2014 \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u043F\u043E\u043B \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0432\u044B\u0439\u0434\u0435\u0442 \u0438\u0437 \u0441\u0442\u0440\u043E\u044F. \u041C\u044B \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u043C \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0446\u0438\u043A\u043B\u044B \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F \u0434\u043B\u044F \u043E\u043F\u0442\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B \u043F\u043E\u043B\u0430.",
        rest_maint_annual: "\u0415\u0436\u0435\u0433\u043E\u0434\u043D\u044B\u0439 \u043E\u0441\u043C\u043E\u0442\u0440",
        rest_maint_annual_desc: "\u041C\u044B \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0435\u043C \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u043F\u043E\u043B\u0430 \u0438 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u043C \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0435. \u0420\u0430\u043D\u043D\u0435\u0435 \u0432\u044B\u044F\u0432\u043B\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0431\u043B\u0435\u043C.",
        rest_maint_traffic: "\u041F\u0435\u0440\u0435\u043A\u0440\u044B\u0442\u0438\u0435 \u0437\u043E\u043D \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F",
        rest_maint_traffic_desc: "\u041F\u0435\u0440\u0435\u043A\u0440\u044B\u0442\u0438\u0435 \u0437\u043E\u043D \u0438\u0437\u043D\u043E\u0441\u0430 \u043A\u0430\u0436\u0434\u044B\u0435 3-5 \u043B\u0435\u0442 \u0434\u043B\u044F \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u0437\u0430\u0449\u0438\u0442\u044B \u0434\u043E \u043E\u0431\u043D\u0430\u0436\u0435\u043D\u0438\u044F \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F.",
        rest_maint_full: "\u041F\u043E\u043B\u043D\u044B\u0439 \u0446\u0438\u043A\u043B \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0442\u0438\u044F",
        rest_maint_full_desc: "\u041F\u043E\u043B\u043D\u043E\u0435 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435 \u0442\u043E\u043F\u043A\u043E\u0443\u0442\u0430 \u043A\u0430\u0436\u0434\u044B\u0435 5-10 \u043B\u0435\u0442 \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442 \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0441\u0442\u0438 \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F.",
