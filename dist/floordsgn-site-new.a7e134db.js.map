        // Epoxy
        epoxy_category: "Industrial Grade",
        epoxy_title: "Epoxy Floor Systems",
        epoxy_meta: "High-Performance Seamless Coating",
        epoxy_lead: "Two-component resin systems engineered for maximum chemical resistance, mechanical durability, and seamless hygiene. The benchmark for industrial and commercial flooring across Israel.",
        epoxy_h2_where: "Where Epoxy Performs",
        epoxy_p_where: "Epoxy flooring excels in demanding industrial environments where chemical exposure, heavy traffic, and strict hygiene requirements are the norm. From manufacturing plants to pharmaceutical facilities, epoxy delivers uncompromising performance.",
        epoxy_app1_title: "Manufacturing Facilities",
        epoxy_app1_desc: "Heavy machinery, forklift traffic, oil and coolant exposure. Self-leveling or broadcast systems 3-5mm.",
        epoxy_app2_title: "Warehouses & Logistics",
        epoxy_app2_desc: "High-traffic zones, pallet jack resistance, demarcation lines. Broadcast quartz systems for durability.",
        epoxy_app3_title: "Food Processing",
        epoxy_app3_desc: "HACCP-compliant, antimicrobial options, coved skirting. Urethane-modified for thermal shock resistance.",
        epoxy_app4_title: "Pharmaceutical & Cleanrooms",
        epoxy_app4_desc: "ESD-control, seamless finish, chemical resistance. ISO-classified environments.",
        epoxy_h2_substrate: "Substrate Preparation",
        epoxy_p_substrate: "Epoxy systems bond mechanically and chemically to the substrate. Proper preparation is non-negotiable for long-term performance. Our team ensures every surface is optimally prepared.",
        epoxy_sub1: "<strong>Shot blasting</strong> \u2014 Creates optimal surface profile (CSP 3-5) and removes laitance",
        epoxy_sub2: "<strong>Diamond grinding</strong> \u2014 For thinner systems or where shot blasting isn't possible",
        epoxy_sub3: "<strong>Crack repair</strong> \u2014 Structural cracks filled with flexible epoxy, hairline cracks with penetrating primer",
        epoxy_sub4: "<strong>Moisture testing</strong> \u2014 Calcium chloride and RH probe testing per ASTM F1869/F2170",
        epoxy_sub5: "<strong>Contamination removal</strong> \u2014 Oil, grease, curing compounds must be completely removed",
        epoxy_h2_system: "System Architecture",
        epoxy_p_system: "Every epoxy installation follows a precise multi-layer system, each component engineered to work together for maximum performance and longevity.",
        epoxy_layer1_title: "Primer Coat",
        epoxy_layer1_desc: "Low-viscosity epoxy penetrates substrate pores, consolidates weak surface layers, and provides chemical bond for subsequent coats. Coverage: 0.15-0.25 kg/m\xb2.",
        epoxy_layer2_title: "Body Coat / Broadcast Layer",
        epoxy_layer2_desc: "Self-leveling or troweled epoxy mortar builds thickness. For high-traffic areas, quartz aggregate broadcast into wet resin creates mechanical interlock and wear resistance.",
        epoxy_layer3_title: "Seal Coat / Topcoat",
        epoxy_layer3_desc: "Clear or pigmented topcoat encapsulates aggregate, provides UV stability (aliphatic systems), and determines final gloss level and chemical resistance.",
        epoxy_h2_variants: "System Variants",
        epoxy_p_variants: "We offer multiple epoxy system configurations to match your specific requirements:",
        epoxy_var1_title: "Self-Leveling",
        epoxy_var1_desc: "Smooth, seamless finish. 2-3mm thickness. Ideal for light-medium traffic, clean environments.",
        epoxy_var2_title: "Quartz Broadcast",
        epoxy_var2_desc: "Colored quartz aggregate for texture and durability. 3-5mm. Heavy traffic, decorative options.",
        epoxy_var3_title: "Mortar System",
        epoxy_var3_desc: "High-build troweled system. 6-12mm. Extreme impact and thermal shock resistance.",
        epoxy_var4_title: "ESD/Conductive",
        epoxy_var4_desc: "Electrostatic discharge control. Electronics manufacturing, data centers, operating rooms.",
        epoxy_h2_advantages: "Key Advantages",
        epoxy_adv1: "<strong>Chemical Resistance</strong> \u2014 Resistant to acids, alkalis, solvents, oils, and fuels. FDA-compliant options available.",
        epoxy_adv2: "<strong>Seamless & Hygienic</strong> \u2014 No joints or grout lines where bacteria can harbor. Easy to clean and sanitize.",
        epoxy_adv3: "<strong>Mechanical Durability</strong> \u2014 High compressive strength (80+ MPa), impact resistance, and abrasion resistance.",
        epoxy_adv4: "<strong>Design Flexibility</strong> \u2014 Unlimited color options, metallic effects, flake systems, logos, and demarcation.",
        epoxy_adv5: "<strong>Fast Return to Service</strong> \u2014 Light foot traffic in 24 hours, full mechanical load in 7 days.",
        epoxy_adv6: "<strong>Long Service Life</strong> \u2014 10-15+ years in industrial environments with proper maintenance.",
        epoxy_h2_maintenance: "Maintenance Protocol",
        epoxy_p_maintenance: "Epoxy floors are low-maintenance but not no-maintenance. A simple cleaning protocol extends service life significantly:",
        epoxy_maint_daily: "Dust mop or auto-scrubber to remove abrasive particles. Spot clean spills immediately.",
        epoxy_maint_weekly: "Wet mop with neutral pH cleaner (diluted). Avoid acidic or alkaline cleaners.",
        epoxy_maint_quarterly: "Deep clean with auto-scrubber. Inspect for damage, especially at joints and edges.",
        epoxy_maint_annually: "Professional inspection. Recoat high-wear areas as needed to maintain protection.",
        epoxy_cta_title: "Ready for Your Epoxy Project?",
        epoxy_cta_text: "Our technical team will assess your requirements and recommend the optimal epoxy system for your facility.",
        epoxy_specs_title: "Technical Specifications",
        epoxy_spec_thickness: "System Thickness",
        epoxy_spec_compressive: "Compressive Strength",
        epoxy_spec_tensile: "Tensile Strength",
        epoxy_spec_hardness: "Shore Hardness",
        epoxy_perf_title: "Performance",
        epoxy_perf_life: "10-15 years",
        epoxy_perf_traffic: "24 hours",
        epoxy_perf_cure: "7 days",
        epoxy_substr_title: "Substrate Requirements",
        epoxy_substr_age: "Concrete Age",
        epoxy_substr_age_v: "\u226528 days",
        epoxy_substr_moisture: "Moisture Content",
        epoxy_substr_rh: "RH Level",
        epoxy_substr_profile: "Surface Profile",
        epoxy_warranty_years: "5 years",
        epoxy_warranty_inspect: "Free Inspections",
        epoxy_warranty_inspect_v: "Year 1 & 3",
        epoxy_rel1: "PU-Cement Flooring",
        epoxy_rel2: "MMA Resin Systems",
        epoxy_rel3: "Microtopping",
        // MMA
        mma_category: "Rapid-Cure Technology",
        mma_title: "MMA Resin Flooring",
        mma_meta: "Methyl Methacrylate Systems",
        mma_lead: "Methyl Methacrylate resin systems that cure in hours, not days. When downtime costs more than the floor, MMA delivers \u2014 with full traffic capability in just 2-4 hours.",
        mma_h2_where: "Where MMA Excels",
        mma_p_where: "MMA flooring is the solution when conventional systems aren't fast enough. Its unique chemistry allows installation in conditions that would halt other flooring projects.",
        mma_app1_title: "24/7 Operations",
        mma_app1_desc: "Food processing, pharmaceutical, logistics \u2014 facilities that cannot shut down. Weekend or overnight installation.",
        mma_app2_title: "Cold Storage",
        mma_app2_desc: "Cures at temperatures as low as -30\xb0C. Freezer floors, cold chain facilities, refrigerated warehouses.",
        mma_app3_title: "Retail Renovation",
        mma_app3_desc: "Mall renovations, supermarket refits \u2014 install overnight, open next morning.",
        mma_app4_title: "Healthcare",
        mma_app4_desc: "Hospital renovations, operating room refurbishment. Minimal odor formulations available.",
        mma_h2_speed: "Speed Without Compromise",
        mma_p_speed: "MMA's rapid cure doesn't mean shortcuts on preparation. Surface prep follows the same rigorous standards as epoxy systems.",
        mma_prep1: "<strong>Shot blasting</strong> \u2014 Preferred method for optimal surface profile. Can proceed immediately after",
        mma_prep2: "<strong>Diamond grinding</strong> \u2014 Alternative where shot blasting isn't feasible",
        mma_prep3: "<strong>Moisture tolerance</strong> \u2014 More forgiving than epoxy, but excess moisture still requires management",
        mma_prep4: "<strong>Cold conditions</strong> \u2014 No heating required for sub-zero installations",
        mma_prep5: "<strong>Rapid primer cure</strong> \u2014 MMA primers cure in 30-60 minutes, enabling same-day system completion",
        mma_h2_system: "System Architecture",
        mma_p_system: "MMA systems follow a similar layered approach to epoxy, but with dramatically faster cure times at each stage.",
        mma_layer1_title: "Reactive Primer",
        mma_layer1_desc: "MMA-based primer penetrates and seals substrate. Cures in 30-60 minutes at 20\xb0C, proportionally faster at higher temperatures.",
        mma_layer2_title: "Body Coat",
        mma_layer2_desc: "Self-leveling or broadcast MMA resin. Aggregate broadcast for slip resistance if required. Cures in 1-2 hours.",
        mma_layer3_title: "Seal Coat",
        mma_layer3_desc: "Clear or pigmented topcoat. UV-stable aliphatic formulations for exterior or high-light applications. Full cure in 1-2 hours.",
        mma_h2_variants: "System Variants",
        mma_p_variants: "MMA is available in multiple configurations to match your specific application requirements:",
        mma_var1_title: "Self-Leveling",
        mma_var1_desc: "Smooth, seamless finish. 2-3mm. Rapid installation for minimal downtime.",
        mma_var2_title: "Quartz Broadcast",
        mma_var2_desc: "Colored quartz for durability and slip resistance. 3-4mm total build.",
        mma_var3_title: "Anti-Slip",
        mma_var3_desc: "Textured aggregate finish for wet areas, ramps, and exterior applications.",
        mma_var4_title: "Decorative Flake",
        mma_var4_desc: "Color flake broadcast for aesthetic appeal. Common in retail and commercial.",
        mma_h2_advantages: "Key Advantages",
        mma_adv1: "<strong>Rapid Cure</strong> \u2014 Full traffic in 2-4 hours. Complete projects in a single shift or overnight.",
        mma_adv2: "<strong>Cold Temperature Cure</strong> \u2014 Installs at -30\xb0C to +35\xb0C. No heating required for cold storage or winter work.",
        mma_adv3: "<strong>UV Stability</strong> \u2014 Aliphatic MMA doesn't yellow or chalk. Suitable for exterior applications.",
        mma_adv4: "<strong>Chemical Resistance</strong> \u2014 Excellent resistance to acids, alkalis, and many solvents.",
        mma_adv5: "<strong>Flexibility</strong> \u2014 More flexible than epoxy, bridges hairline cracks, handles substrate movement.",
        mma_adv6: "<strong>Minimal Downtime</strong> \u2014 The real advantage \u2014 production continues with minimal interruption.",
        mma_h2_maintenance: "Maintenance Protocol",
        mma_p_maintenance: "MMA floors deliver performance comparable to epoxy with significantly faster installation. Maintenance is straightforward.",
        mma_maint_daily: "Sweep or auto-scrub to remove debris. Spot clean spills as they occur.",
        mma_maint_weekly: "Machine scrub with neutral pH cleaner. Rinse thoroughly.",
        mma_maint_quarterly: "Deep clean and inspection. Check high-wear areas for topcoat condition.",
        mma_maint_asneeded: "Rapid recoating possible \u2014 MMA topcoat can be applied with minimal prep.",
        mma_cta_title: "Need Minimal Downtime?",
        mma_cta_text: "Let's discuss how MMA can solve your rapid-installation challenge.",
        mma_specs_title: "Technical Specifications",
        mma_spec_thickness: "System Thickness",
        mma_spec_traffic: "Traffic Ready",
        mma_spec_primer: "Primer Cure",
        mma_temp_title: "Temperature Range",
        mma_temp_min: "Min Install Temp",
        mma_temp_max: "Max Install Temp",
        mma_temp_service: "Service Range",
        mma_temp_humidity: "Humidity Tolerance",
        mma_temp_humidity_v: "High",
        mma_perf_title: "Performance",
        mma_perf_uv: "UV Stability",
        mma_perf_uv_v: "Excellent",
        mma_perf_chem: "Chemical Resistance",
        mma_perf_chem_v: "Excellent",
        mma_perf_flex: "Flexibility",
        mma_perf_flex_v: "High",
        mma_warranty_years: "5 years",
        mma_warranty_repair: "Emergency Repair",
        mma_warranty_repair_v: "Available",
        mma_rel1: "Epoxy Flooring",
        mma_rel2: "PU-Cement",
        mma_rel3: "Rubber Flooring",
        // PU-Cement
        puc_category: "Thermal Shock Resistant",
        puc_title: "PU-Cement Flooring",
        puc_meta: "Polyurethane-Cement Hybrid Systems",
        puc_lead: "Polyurethane-cement hybrid systems engineered for extreme thermal cycling. From boiling water to freezer temperatures \u2014 without cracking. The industry standard for food and beverage processing.",
        puc_h2_where: "Where PU-Cement Performs",
        puc_p_where: "PU-cement is the only flooring system specifically designed for the demands of food processing environments where thermal shock, aggressive cleaning, and hygiene requirements converge.",
        puc_app1_title: "Food & Beverage Processing",
        puc_app1_desc: "Breweries, dairies, meat processing. Hot wash-downs, caustic cleaning, steam exposure. The industry standard.",
        puc_app2_title: "Commercial Kitchens",
        puc_app2_desc: "Hot oil spills, boiling water, constant cleaning. Non-slip texture for wet environments.",
        puc_app3_title: "Pharmaceutical",
        puc_app3_desc: "Clean-in-place compatible. Withstands aggressive sanitization protocols.",
        puc_app4_title: "Bakeries & Laundries",
        puc_app4_desc: "Hot oven interfaces, steam exposure, constant moisture, detergent resistance.",
        puc_h2_built: "Built for Abuse",
        puc_p_built: "PU-cement systems are thick-build mortars that require proper drainage design and substrate preparation for optimal performance.",
        puc_prep1: "<strong>Falls to drain</strong> \u2014 Minimum 1:80 fall required. We install screeds to create proper drainage",
        puc_prep2: "<strong>Shot blasting</strong> \u2014 Aggressive profile (CSP 5-7) for mechanical bond to substrate",
        puc_prep3: "<strong>Coved skirting</strong> \u2014 Integral cove at wall junctions eliminates corner joints",
        puc_prep4: "<strong>Channel drains</strong> \u2014 Stainless steel drainage integrated into floor system",
        puc_prep5: "<strong>Moisture tolerance</strong> \u2014 PU-cement is moisture-tolerant but excess water should be addressed",
        puc_h2_system: "System Architecture",
        puc_p_system: "PU-cement systems combine the strength of cement with the flexibility and chemical resistance of polyurethane.",
        puc_layer1_title: "Bonding System",
        puc_layer1_desc: "Epoxy or polyurethane primer creates chemical bond to prepared concrete. Critical for adhesion under thermal stress.",
        puc_layer2_title: "PU-Cement Mortar",
        puc_layer2_desc: "Polyurethane-bound cementitious mortar troweled to specified thickness. Contains special aggregates for thermal stability and wear resistance.",
        puc_layer3_title: "Seal Coat",
        puc_layer3_desc: "Polyurethane topcoat seals surface, provides chemical resistance, and determines slip texture level.",
        puc_h2_texture: "Texture Options",
        puc_p_texture: "Slip resistance is critical in wet food processing environments. We offer the full range of textures:",
        puc_var1_title: "Smooth (R10)",
        puc_var1_desc: "Easy to clean, moderate slip resistance. Dry processing areas.",
        puc_var2_title: "Medium (R11)",
        puc_var2_desc: "Balanced cleanability and grip. Most food processing applications.",
        puc_var3_title: "Coarse (R12)",
        puc_var3_desc: "Higher slip resistance for wet/oily areas. Slightly more effort to clean.",
        puc_var4_title: "Heavy Duty (R13)",
        puc_var4_desc: "Maximum grip for extreme wet conditions. Industrial drainage areas.",
        puc_h2_advantages: "Key Advantages",
        puc_adv1: "<strong>Thermal Shock Resistance</strong> \u2014 Withstands -40\xb0C to +120\xb0C without cracking. Unlimited thermal cycles.",
        puc_adv2: "<strong>Steam & Hot Water</strong> \u2014 Designed for daily steam cleaning and hot wash-downs. Industry standard for food processing.",
        puc_adv3: "<strong>Chemical Resistance</strong> \u2014 Resists organic acids, caustics, cleaning chemicals. HACCP compliant.",
        puc_adv4: "<strong>Anti-Slip Textures</strong> \u2014 Range of slip ratings (R10-R13) to match specific area requirements.",
        puc_adv5: "<strong>Impact Resistant</strong> \u2014 High-build mortar absorbs impact. Dropped equipment, pallet trucks, heavy loads.",
        puc_adv6: "<strong>Hygienic Design</strong> \u2014 Seamless with coved skirting. No joints for bacteria to harbor.",
        puc_h2_maintenance: "Maintenance Protocol",
        puc_p_maintenance: "PU-cement is specifically designed for aggressive cleaning regimes. The system gets better with regular cleaning.",
        puc_maint_shift: "Production Shift End",
