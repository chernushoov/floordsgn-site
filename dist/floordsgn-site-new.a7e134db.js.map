        about_hero_desc: "\u0411\u043E\u043B\u0435\u0435 15 \u043B\u0435\u0442 Floor.DSGN \u0440\u0435\u0430\u043B\u0438\u0437\u0443\u0435\u0442 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0435 \u043D\u0430\u043F\u043E\u043B\u044C\u043D\u044B\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u044F \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u043D\u043E\u0433\u043E \u043A\u043B\u0430\u0441\u0441\u0430 \u043F\u043E \u0432\u0441\u0435\u043C\u0443 \u0418\u0437\u0440\u0430\u0438\u043B\u044E. \u041C\u044B \u0441\u043E\u0447\u0435\u0442\u0430\u0435\u043C \u0435\u0432\u0440\u043E\u043F\u0435\u0439\u0441\u043A\u0438\u0435 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B \u0441 \u0442\u043E\u0447\u043D\u044B\u043C \u043C\u043E\u043D\u0442\u0430\u0436\u043E\u043C, \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u044F \u043F\u043E\u043B\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442 \u0438 \u0432\u0434\u043E\u0445\u043D\u043E\u0432\u043B\u044F\u044E\u0442.",
        about_values_overline: "\u041D\u0430\u0448 \u043F\u043E\u0434\u0445\u043E\u0434",
        about_values_title: "\u0427\u0442\u043E \u043D\u0430\u043C\u0438 \u0434\u0432\u0438\u0436\u0435\u0442",
        about_value1_title: "\u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u043E",
        about_value1_desc: "\u041A\u0430\u0436\u0434\u044B\u0439 \u043F\u0440\u043E\u0435\u043A\u0442 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u0441 \u0442\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u0430\u043D\u0430\u043B\u0438\u0437\u0430 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F \u0438 \u043F\u043E\u0434\u0431\u043E\u0440\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u044B. \u041C\u044B \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u0435\u043C \u043E\u043F\u0442\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435 \u043D\u0430\u043F\u043E\u043B\u044C\u043D\u043E\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435 \u043F\u043E\u0434 \u0432\u0430\u0448\u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u044F \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u0438 \u0438 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F \u043A \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438.",
        about_value2_title: "\u041A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B",
        about_value2_desc: "\u041C\u044B \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u043C \u0438\u0441\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0441 \u0432\u0435\u0434\u0443\u0449\u0438\u043C\u0438 \u0435\u0432\u0440\u043E\u043F\u0435\u0439\u0441\u043A\u0438\u043C\u0438 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044F\u043C\u0438 \u2014 \u043D\u0435\u043C\u0435\u0446\u043A\u0438\u0435, \u0438\u0442\u0430\u043B\u044C\u044F\u043D\u0441\u043A\u0438\u0435 \u0438 \u0448\u0432\u0435\u0439\u0446\u0430\u0440\u0441\u043A\u0438\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u0441 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0451\u043D\u043D\u043E\u0439 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0435\u0439 \u0432 \u0441\u043B\u043E\u0436\u043D\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u0438.",
        about_value3_title: "\u0422\u043E\u0447\u043D\u044B\u0439 \u043C\u043E\u043D\u0442\u0430\u0436",
        about_value3_desc: "\u041D\u0430\u0448\u0438 \u043C\u043E\u043D\u0442\u0430\u0436\u043D\u044B\u0435 \u0431\u0440\u0438\u0433\u0430\u0434\u044B \u043F\u0440\u043E\u0448\u043B\u0438 \u0437\u0430\u0432\u043E\u0434\u0441\u043A\u043E\u0435 \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435 \u0438 \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u044B \u043F\u043E ISO. \u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438, \u043D\u0430\u043D\u0435\u0441\u0435\u043D\u0438\u0435 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430 \u0438 \u043E\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435 \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u044E\u0442\u0441\u044F \u0441\u0442\u0440\u043E\u0433\u043E \u043F\u043E \u0441\u043F\u0435\u0446\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u044F\u043C \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044F.",
        about_story_overline: "\u041D\u0430\u0448\u0430 \u0438\u0441\u0442\u043E\u0440\u0438\u044F",
        about_story_title: "\u041E\u0441\u043D\u043E\u0432\u0430\u043D\u043E \u043D\u0430 \u044D\u043A\u0441\u043F\u0435\u0440\u0442\u0438\u0437\u0435",
        about_story_p1: "Floor.DSGN \u0431\u044B\u043B\u0430 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0430 \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u0430\u043C\u0438-\u043F\u043E\u043B\u0438\u043C\u0435\u0440\u0449\u0438\u043A\u0430\u043C\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0443\u0432\u0438\u0434\u0435\u043B\u0438 \u043F\u0440\u043E\u0431\u0435\u043B \u043D\u0430 \u0438\u0437\u0440\u0430\u0438\u043B\u044C\u0441\u043A\u043E\u043C \u0440\u044B\u043D\u043A\u0435: \u043F\u043E\u0442\u0440\u0435\u0431\u043D\u043E\u0441\u0442\u044C \u0432 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043D\u0430\u043F\u043E\u043B\u044C\u043D\u044B\u0445 \u0440\u0435\u0448\u0435\u043D\u0438\u044F\u0445 \u0441 \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u043D\u044B\u043C \u043F\u043E\u0434\u0445\u043E\u0434\u043E\u043C.",
        about_story_p2: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043C\u044B \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u043C \u0441 \u043F\u0440\u043E\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u044B\u043C\u0438 \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u044F\u043C\u0438, \u043A\u043E\u043C\u043C\u0435\u0440\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u0437\u0430\u0441\u0442\u0440\u043E\u0439\u0449\u0438\u043A\u0430\u043C\u0438, \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440\u0430\u043C\u0438 \u0438 \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430\u043C\u0438 \u0436\u0438\u043B\u044C\u044F, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0442\u0440\u0435\u0431\u0443\u044E\u0442 \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0441\u0442\u044C \u0431\u0435\u0437 \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0438\u0441\u0441\u043E\u0432 \u0432 \u044D\u0441\u0442\u0435\u0442\u0438\u043A\u0435. \u041E\u0442 \u0437\u0430\u0432\u043E\u0434\u0441\u043A\u043E\u0439 \u044D\u043F\u043E\u043A\u0441\u0438\u0434\u043A\u0438 \u0434\u043E \u0440\u0443\u0447\u043D\u043E\u0433\u043E \u0442\u0435\u0440\u0440\u0430\u0446\u0446\u043E \u2014 \u043C\u044B \u0434\u0435\u043B\u0430\u0435\u043C \u043F\u043E\u043B\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442.",
        about_story_p3: "\u041D\u0430\u0448\u0430 \u043A\u043E\u043C\u0430\u043D\u0434\u0430 \u0441\u043E\u0447\u0435\u0442\u0430\u0435\u0442 \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0435 \u0437\u043D\u0430\u043D\u0438\u044F \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0441 \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043E\u043F\u044B\u0442\u043E\u043C \u043C\u043E\u043D\u0442\u0430\u0436\u0430. \u041C\u044B \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0440\u043E\u0434\u0430\u0451\u043C \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u2014 \u043C\u044B \u043F\u0440\u043E\u0435\u043A\u0442\u0438\u0440\u0443\u0435\u043C \u0440\u0435\u0448\u0435\u043D\u0438\u044F.",
        about_team_overline: "\u041D\u0430\u0448\u0430 \u043A\u043E\u043C\u0430\u043D\u0434\u0430",
        about_team_title: "\u041D\u0430\u0448\u0438 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0441\u0442\u044B",
        about_team_desc: "\u0421\u0435\u0440\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044B \u0441 \u043C\u043D\u043E\u0433\u043E\u043B\u0435\u0442\u043D\u0438\u043C \u0441\u043E\u0432\u043E\u043A\u0443\u043F\u043D\u044B\u043C \u043E\u043F\u044B\u0442\u043E\u043C \u0432 \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u0438\u0438 \u043D\u0430\u043F\u043E\u043B\u044C\u043D\u044B\u0445 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0439.",
