        // Hero
        hero_overline: "\u041F\u0440\u0435\u043C\u0438\u0443\u043C \u0441\u0442\u0443\u0434\u0438\u044F \u043D\u0430\u043F\u043E\u043B\u044C\u043D\u044B\u0445 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0439 \u2022 \u0418\u0437\u0440\u0430\u0438\u043B\u044C",
        hero_title: "\u041F\u0440\u043E\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u044B\u0435<br>\u0438 \u043A\u043E\u043C\u043C\u0435\u0440\u0447\u0435\u0441\u043A\u0438\u0435<br>\u043F\u043E\u043B\u044B",
        hero_text: "\u042D\u043F\u043E\u043A\u0441\u0438\u0434, \u0442\u0435\u0440\u0440\u0430\u0446\u0446\u043E, \u043C\u0438\u043A\u0440\u043E\u0442\u043E\u043F\u043F\u0438\u043D\u0433 \u2014 \u0435\u0432\u0440\u043E\u043F\u0435\u0439\u0441\u043A\u0438\u0435 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B, \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439 \u043C\u043E\u043D\u0442\u0430\u0436, \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u044F 10 \u043B\u0435\u0442. \u0417\u0430\u0432\u043E\u0434\u044B, \u0441\u043A\u043B\u0430\u0434\u044B, \u0448\u043E\u0443\u0440\u0443\u043C\u044B, \u043E\u0444\u0438\u0441\u044B.",
        hero_cta_primary: "\u0411\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B\u0439 \u0440\u0430\u0441\u0447\u0451\u0442",
