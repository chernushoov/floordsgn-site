        // Rubber
        rubber_category: "Safety & Comfort",
        rubber_title: "Rubber Flooring",
        rubber_meta: "Comfort & Safety",
        rubber_lead: "Vulcanized rubber flooring for environments where comfort, safety, and sound absorption matter. Available in rolls, tiles, or poured-in-place systems to match any application.",
        rubber_h2_where: "Where Rubber Flooring Excels",
        rubber_p_where: "Rubber flooring provides the perfect combination of durability, comfort, and safety for demanding environments where people stand, move, and work.",
        rubber_app1_title: "Fitness Facilities",
        rubber_app1_desc: "Gyms, weight rooms, CrossFit boxes. Impact absorption, dropped weight protection, easy cleaning.",
        rubber_app2_title: "Healthcare",
        rubber_app2_desc: "Hospitals, clinics, aged care. Anti-fatigue for staff, slip-resistant, sound absorbing.",
        rubber_app3_title: "Education",
        rubber_app3_desc: "Schools, universities, libraries. Durable, quiet, slip-safe. Sustainable recycled options.",
        rubber_app4_title: "Playgrounds & Recreation",
        rubber_app4_desc: "Safety surfacing for play areas. Fall-height rated poured rubber systems.",
        rubber_h2_substrate: "Substrate Preparation",
        rubber_p_substrate: "Rubber flooring can be glued, loose-laid, or installed over underlayment. Substrate requirements vary by installation method.",
        rubber_sub1: "<strong>Full adhesive</strong> \u2014 Substrate must be flat (SR1-SR2), dry, and free of contaminants. Best for permanent installations",
        rubber_sub2: "<strong>Loose lay</strong> \u2014 Heavier rubber tiles can be loose-laid. Allows for replacement and access to subfloor",
        rubber_sub3: "<strong>Interlocking tiles</strong> \u2014 No adhesive required. Quick install for gyms and temporary applications",
        rubber_sub4: "<strong>Poured rubber</strong> \u2014 EPDM granules bound with polyurethane. Seamless, any thickness, playground-rated",
        rubber_sub5: "<strong>Moisture</strong> \u2014 Rubber is impermeable; excess moisture must be addressed to prevent mold beneath",
        rubber_h2_types: "Rubber Flooring Types",
        rubber_p_types: "We offer multiple rubber flooring technologies to match your specific application requirements.",
        rubber_layer1_title: "Vulcanized Rubber",
        rubber_layer1_desc: "Factory-produced sheets or tiles. Vulcanization process creates durable, resilient product. Available in natural or synthetic formulations.",
        rubber_layer2_title: "Recycled Rubber",
        rubber_layer2_desc: "Made from recycled tires. Available as tiles, rolls, or poured-in-place. Excellent for gyms and playgrounds. Sustainable choice.",
        rubber_layer3_title: "Poured EPDM",
        rubber_layer3_desc: "EPDM rubber granules mixed with polyurethane binder, poured on-site. Seamless, any thickness, any color. Ideal for playgrounds and sports surfacing.",
        rubber_h2_patterns: "Surface Patterns",
        rubber_p_patterns: "Different surface textures provide varying levels of slip resistance and aesthetic options:",
        rubber_var1_title: "Smooth",
        rubber_var1_desc: "Easy to clean. Common in healthcare and retail. Requires good drainage design for wet areas.",
        rubber_var2_title: "Raised Disc / Stud",
        rubber_var2_desc: "Classic rubber flooring look. Enhanced slip resistance. Transit and industrial applications.",
        rubber_var3_title: "Hammered",
        rubber_var3_desc: "Textured for slip resistance and visual interest. Hides wear patterns well.",
        rubber_var4_title: "Custom",
        rubber_var4_desc: "Logos, patterns, wayfinding integrated into the floor. Design possibilities unlimited.",
        rubber_h2_advantages: "Key Advantages",
        rubber_adv1: "<strong>Comfort & Anti-Fatigue</strong> \u2014 Cushioned surface reduces strain on legs and back. Essential for standing work environments.",
        rubber_adv2: "<strong>Sound Absorption</strong> \u2014 Significantly reduces impact noise and airborne sound transmission. Quieter spaces.",
        rubber_adv3: "<strong>Slip Resistance</strong> \u2014 Natural grip even when wet. Excellent safety profile for high-traffic areas.",
        rubber_adv4: "<strong>Impact Absorption</strong> \u2014 Protects dropped items and absorbs falls. Critical for gyms and play areas.",
        rubber_adv5: "<strong>Sustainable Options</strong> \u2014 Recycled tire content. Natural rubber from sustainable sources. Long lifespan.",
        rubber_adv6: "<strong>Easy Maintenance</strong> \u2014 Sweep and mop. No waxing required. Resilient surface resists staining.",
        rubber_h2_maintenance: "Maintenance Protocol",
        rubber_p_maintenance: "Rubber flooring is low-maintenance and resilient. Proper care extends service life and maintains appearance.",
        rubber_maint_daily: "Sweep or vacuum to remove grit. Damp mop high-traffic areas as needed.",
        rubber_maint_weekly: "Machine scrub with neutral pH cleaner. Rinse well to prevent residue buildup.",
        rubber_maint_monthly: "Monthly",
        rubber_maint_monthly_desc: "Deep clean and inspect for damage. Address cuts or tears promptly.",
        rubber_maint_annually: "Professional cleaning if needed. Check seams and edges for lifting.",
        rubber_cta_title: "Need a Rubber Flooring Solution?",
        rubber_cta_text: "Let us recommend the right rubber product for your specific application and requirements.",
