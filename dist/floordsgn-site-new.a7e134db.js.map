        micro_category: "\u0410\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u043D\u043E\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435",
        micro_title: "\u041C\u0438\u043A\u0440\u043E\u0442\u043E\u043F\u043F\u0438\u043D\u0433",
        micro_meta: "\u0423\u043B\u044C\u0442\u0440\u0430\u0442\u043E\u043D\u043A\u043E\u0435 \u0446\u0435\u043C\u0435\u043D\u0442\u043D\u043E\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435",
        micro_lead: "\u0423\u043B\u044C\u0442\u0440\u0430\u0442\u043E\u043D\u043A\u043E\u0435 \u043F\u043E\u043B\u0438\u043C\u0435\u0440\u043D\u043E-\u043C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0435 \u0446\u0435\u043C\u0435\u043D\u0442\u043D\u043E\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0435 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u0432 \u0431\u0435\u0441\u0448\u043E\u0432\u043D\u044B\u0435 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435 \u043F\u043E\u043B\u044B. \u0412\u044B\u0431\u043E\u0440 \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u043E\u0440\u043E\u0432 \u0434\u043B\u044F \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u043D\u044B\u0445 \u0438\u043D\u0442\u0435\u0440\u044C\u0435\u0440\u043E\u0432 \u0441 \u0438\u043D\u0434\u0443\u0441\u0442\u0440\u0438\u0430\u043B\u044C\u043D\u044B\u043C \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043E\u043C.",
        micro_h2_where: "\u0413\u0434\u0435 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u043C\u0438\u043A\u0440\u043E\u0442\u043E\u043F\u043F\u0438\u043D\u0433",
        micro_p_where: "\u041C\u0438\u043A\u0440\u043E\u0442\u043E\u043F\u043F\u0438\u043D\u0433 \u0441\u043E\u0437\u0434\u0430\u0451\u0442 \u0431\u0435\u0441\u0448\u043E\u0432\u043D\u044B\u0435, \u0442\u0435\u043A\u0443\u0447\u0438\u0435 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u044E\u0442 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435 \u0430\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u043D\u044B\u0435 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430. \u041C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F \u0442\u043E\u043B\u0449\u0438\u043D\u0430 \u0434\u0435\u043B\u0430\u0435\u0442 \u0435\u0433\u043E \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u043C \u0434\u043B\u044F \u0440\u0435\u043D\u043E\u0432\u0430\u0446\u0438\u0438, \u0433\u0434\u0435 \u043A\u0440\u0438\u0442\u0438\u0447\u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0430 \u043F\u043E\u043B\u0430.",
        micro_app1_title: "\u041F\u0440\u0435\u043C\u0438\u0443\u043C \u0436\u0438\u043B\u044C\u0451",
        micro_app1_desc: "\u0413\u043E\u0441\u0442\u0438\u043D\u044B\u0435, \u043A\u0443\u0445\u043D\u0438, \u0432\u0430\u043D\u043D\u044B\u0435. \u041D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u0430\u044F \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C \u043F\u043E \u0432\u0441\u0435\u043C\u0443 \u0434\u043E\u043C\u0443. \u0421\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C \u0441 \u0442\u0451\u043F\u043B\u044B\u043C \u043F\u043E\u043B\u043E\u043C.",
        micro_app2_title: "\u0420\u0438\u0442\u0435\u0439\u043B \u0438 \u0448\u043E\u0443\u0440\u0443\u043C\u044B",
        micro_app2_desc: "\u041D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0439 \u0444\u043E\u043D, \u043F\u043E\u0434\u0447\u0451\u0440\u043A\u0438\u0432\u0430\u044E\u0449\u0438\u0439 \u0442\u043E\u0432\u0430\u0440. \u041F\u0440\u043E\u0441\u0442\u043E\u0439 \u0443\u0445\u043E\u0434 \u0434\u043B\u044F \u0437\u043E\u043D \u0441 \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u044B\u043C \u0442\u0440\u0430\u0444\u0438\u043A\u043E\u043C.",
        micro_app3_title: "\u0413\u043E\u0441\u0442\u0438\u043D\u0438\u0447\u043D\u044B\u0439 \u0431\u0438\u0437\u043D\u0435\u0441",
        micro_app3_desc: "\u041E\u0442\u0435\u043B\u0438, \u0440\u0435\u0441\u0442\u043E\u0440\u0430\u043D\u044B, \u043A\u0430\u0444\u0435. \u0421\u043E\u0437\u0434\u0430\u0451\u0442 \u0438\u0437\u044B\u0441\u043A\u0430\u043D\u043D\u0443\u044E \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0443 \u0441 \u0438\u043D\u0434\u0443\u0441\u0442\u0440\u0438\u0430\u043B\u044C\u043D\u044B\u043C\u0438 \u043D\u043E\u0442\u043A\u0430\u043C\u0438.",
        micro_app4_title: "\u0420\u0435\u043D\u043E\u0432\u0430\u0446\u0438\u044F",
        micro_app4_desc: "\u0423\u043A\u043B\u0430\u0434\u043A\u0430 \u043F\u043E\u0432\u0435\u0440\u0445 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439 \u043F\u043B\u0438\u0442\u043A\u0438, \u0431\u0435\u0442\u043E\u043D\u0430 \u0438\u043B\u0438 \u0441\u0442\u044F\u0436\u043A\u0438 \u0431\u0435\u0437 \u0434\u0435\u043C\u043E\u043D\u0442\u0430\u0436\u0430. \u041C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0439 \u043F\u043E\u0434\u044A\u0451\u043C \u0443\u0440\u043E\u0432\u043D\u044F \u043F\u043E\u043B\u0430.",
        micro_h2_substrate: "\u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F",
        micro_p_substrate: "\u041C\u0438\u043A\u0440\u043E\u0442\u043E\u043F\u043F\u0438\u043D\u0433 \u0442\u043E\u043D\u043A\u0438\u0439 (2-3\u043C\u043C), \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0434\u0435\u0444\u0435\u043A\u0442\u044B \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F. \u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442 \u0438\u0442\u043E\u0433\u043E\u0432\u043E\u0435 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E.",
        micro_sub1: "<strong>\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0430\u044F \u043F\u043B\u0438\u0442\u043A\u0430</strong> \u2014 \u041C\u043E\u0436\u043D\u043E \u0443\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0442\u044C \u043F\u043E\u0432\u0435\u0440\u0445, \u0435\u0441\u043B\u0438 \u043F\u0440\u043E\u0447\u043D\u0430\u044F. \u0428\u0432\u044B \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u044E\u0442\u0441\u044F, \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C \u0448\u043B\u0438\u0444\u0443\u0435\u0442\u0441\u044F",
        micro_sub2: "<strong>\u0411\u0435\u0442\u043E\u043D</strong> \u2014 \u0414\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u0442\u044C \u0440\u043E\u0432\u043D\u044B\u043C, \u0431\u0435\u0437 \u0446\u0435\u043C\u0435\u043D\u0442\u043D\u043E\u0433\u043E \u043C\u043E\u043B\u043E\u0447\u043A\u0430, \u0442\u0440\u0435\u0449\u0438\u043D\u044B \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u044B \u0433\u0438\u0431\u043A\u0438\u043C \u0441\u043E\u0441\u0442\u0430\u0432\u043E\u043C",
        micro_sub3: "<strong>\u0421\u0442\u044F\u0436\u043A\u0438</strong> \u2014 \u0421\u0430\u043C\u043E\u0432\u044B\u0440\u0430\u0432\u043D\u0438\u0432\u0430\u044E\u0449\u0430\u044F\u0441\u044F \u0441\u043C\u0435\u0441\u044C \u0434\u043B\u044F \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F \u043D\u0443\u0436\u043D\u043E\u0439 \u0440\u043E\u0432\u043D\u043E\u0441\u0442\u0438 (SR1-SR2)",
        micro_sub4: "<strong>\u0410\u0434\u0433\u0435\u0437\u0438\u043E\u043D\u043D\u044B\u0439 \u043F\u0440\u0430\u0439\u043C\u0435\u0440</strong> \u2014 \u0421\u0438\u0441\u0442\u0435\u043C\u043D\u044B\u0439 \u043F\u0440\u0430\u0439\u043C\u0435\u0440 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0441\u0446\u0435\u043F\u043B\u0435\u043D\u0438\u0435 \u0441 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u043C\u0438 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F\u043C\u0438",
        micro_sub5: "<strong>\u0410\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435 \u0442\u0440\u0435\u0449\u0438\u043D</strong> \u2014 \u0421\u0442\u0435\u043A\u043B\u043E\u0441\u0435\u0442\u043A\u0430 \u0443\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043D\u0430 \u0434\u0435\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0445 \u0448\u0432\u0430\u0445 \u0438 \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u044B\u0445 \u0442\u0440\u0435\u0449\u0438\u043D\u0430\u0445",
        micro_h2_process: "\u041F\u0440\u043E\u0446\u0435\u0441\u0441 \u043D\u0430\u043D\u0435\u0441\u0435\u043D\u0438\u044F",
        micro_p_process: "\u041C\u0438\u043A\u0440\u043E\u0442\u043E\u043F\u043F\u0438\u043D\u0433 \u043D\u0430\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u0432 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0442\u043E\u043D\u043A\u0438\u0445 \u0441\u043B\u043E\u0451\u0432, \u043A\u0430\u0436\u0434\u044B\u0439 \u043F\u0440\u043E\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0432\u0440\u0443\u0447\u043D\u0443\u044E \u0434\u043B\u044F \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u0436\u0435\u043B\u0430\u0435\u043C\u043E\u0439 \u0442\u0435\u043A\u0441\u0442\u0443\u0440\u044B.",
        micro_layer1_title: "\u0411\u0430\u0437\u043E\u0432\u044B\u0439 \u0441\u043B\u043E\u0439",
        micro_layer1_desc: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0441\u043B\u043E\u0439 \u043F\u043E\u043B\u0438\u043C\u0435\u0440\u043D\u043E-\u043C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E \u0446\u0435\u043C\u0435\u043D\u0442\u0430 \u043D\u0430\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u043A\u0435\u043B\u044C\u043C\u043E\u0439. \u0421\u043E\u0437\u0434\u0430\u0451\u0442 \u043E\u0441\u043D\u043E\u0432\u0443, \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u0435\u0442 \u043C\u0435\u043B\u043A\u0438\u0435 \u043D\u0435\u0440\u043E\u0432\u043D\u043E\u0441\u0442\u0438. \u041F\u0440\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438 \u0443\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0441\u0442\u0435\u043A\u043B\u043E\u0441\u0435\u0442\u043A\u0430.",
        micro_layer2_title: "\u0424\u0438\u043D\u0438\u0448\u043D\u044B\u0439 \u0441\u043B\u043E\u0439",
        micro_layer2_desc: "\u0422\u043E\u043D\u043A\u0438\u0439 \u0434\u0435\u043A\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0439 \u0441\u043B\u043E\u0439 \u043D\u0430\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u0438 \u043F\u0440\u043E\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0432\u0440\u0443\u0447\u043D\u0443\u044E \u0434\u043B\u044F \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u0436\u0435\u043B\u0430\u0435\u043C\u043E\u0439 \u0442\u0435\u043A\u0441\u0442\u0443\u0440\u044B \u2014 \u043E\u0442 \u0433\u043B\u0430\u0434\u043A\u043E\u0439 \u0434\u043E \u0432\u0430\u0440\u0438\u0430\u0442\u0438\u0432\u043D\u043E\u0439, \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442 \u0442\u0435\u0445\u043D\u0438\u043A\u0438.",
        micro_layer3_title: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430 \u0433\u0435\u0440\u043C\u0435\u0442\u0438\u043A\u0430",
        micro_layer3_desc: "\u0414\u0432\u0443\u0445\u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u043D\u044B\u0439 \u043F\u043E\u043B\u0438\u0443\u0440\u0435\u0442\u0430\u043D\u043E\u0432\u044B\u0439 \u0438\u043B\u0438 \u044D\u043F\u043E\u043A\u0441\u0438\u0434\u043D\u044B\u0439 \u0433\u0435\u0440\u043C\u0435\u0442\u0438\u043A \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C \u043A \u043F\u044F\u0442\u043D\u0430\u043C \u0438 \u0434\u043E\u043B\u0433\u043E\u0432\u0435\u0447\u043D\u043E\u0441\u0442\u044C. \u0420\u0430\u0437\u043D\u044B\u0435 \u0441\u0442\u0435\u043F\u0435\u043D\u0438 \u0433\u043B\u044F\u043D\u0446\u0430: \u043C\u0430\u0442\u043E\u0432\u044B\u0439, \u0441\u0430\u0442\u0438\u043D\u043E\u0432\u044B\u0439, \u0433\u043B\u044F\u043D\u0446\u0435\u0432\u044B\u0439.",
        micro_h2_finishes: "\u0412\u0430\u0440\u0438\u0430\u043D\u0442\u044B \u043E\u0442\u0434\u0435\u043B\u043A\u0438",
        micro_p_finishes: "\u041A\u0430\u0436\u0434\u044B\u0439 \u043F\u043E\u043B \u0438\u0437 \u043C\u0438\u043A\u0440\u043E\u0442\u043E\u043F\u043F\u0438\u043D\u0433\u0430 \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u043F\u043E\u0434 \u0436\u0435\u043B\u0430\u0435\u043C\u0443\u044E \u044D\u0441\u0442\u0435\u0442\u0438\u043A\u0443:",
        micro_var1_title: "\u041D\u0430\u0442\u0443\u0440\u0430\u043B\u044C\u043D\u044B\u0439 \u0446\u0435\u043C\u0435\u043D\u0442",
        micro_var1_desc: "\u041A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0441\u0435\u0440\u044B\u0435 \u0442\u043E\u043D\u0430 \u0441 \u043B\u0451\u0433\u043A\u0438\u043C\u0438 \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u044F\u043C\u0438. \u0421\u044B\u0440\u0430\u044F \u0438\u043D\u0434\u0443\u0441\u0442\u0440\u0438\u0430\u043B\u044C\u043D\u0430\u044F \u044D\u0441\u0442\u0435\u0442\u0438\u043A\u0430.",
        micro_var2_title: "\u0422\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439",
        micro_var2_desc: "\u0418\u043D\u0442\u0435\u0433\u0440\u0430\u043B\u044C\u043D\u044B\u0435 \u043F\u0438\u0433\u043C\u0435\u043D\u0442\u044B \u0441\u043E\u0437\u0434\u0430\u044E\u0442 \u0442\u0451\u043F\u043B\u044B\u0435 \u0438\u043B\u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0435 \u0442\u043E\u043D\u0430 \u2014 \u043E\u0442 \u0443\u0433\u043E\u043B\u044C\u043D\u043E\u0433\u043E \u0434\u043E \u0442\u0451\u043F\u043B\u043E\u0433\u043E \u0442\u0430\u0443\u043F.",
        micro_var3_title: "\u041E\u0431\u043B\u0430\u0447\u043D\u044B\u0439 \u044D\u0444\u0444\u0435\u043A\u0442",
        micro_var3_desc: "\u041D\u0430\u043C\u0435\u0440\u0435\u043D\u043D\u044B\u0435 \u0441\u043B\u0435\u0434\u044B \u043A\u0435\u043B\u044C\u043C\u044B \u0441\u043E\u0437\u0434\u0430\u044E\u0442 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u0438 \u0433\u043B\u0443\u0431\u0438\u043D\u0443. \u0420\u0435\u043C\u0435\u0441\u043B\u0435\u043D\u043D\u044B\u0439 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440.",
        micro_var4_title: "\u041E\u0434\u043D\u043E\u0440\u043E\u0434\u043D\u044B\u0439",
        micro_var4_desc: "\u041D\u0430\u043D\u0435\u0441\u0435\u043D\u0438\u0435 \u0440\u0430\u0441\u043F\u044B\u043B\u0435\u043D\u0438\u0435\u043C \u0434\u043B\u044F \u0431\u043E\u043B\u0435\u0435 \u0440\u0430\u0432\u043D\u043E\u043C\u0435\u0440\u043D\u043E\u0433\u043E \u0432\u0438\u0434\u0430. \u0421\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439, \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u0438\u0441\u0442\u0438\u0447\u043D\u044B\u0439.",
        micro_h2_advantages: "\u041A\u043B\u044E\u0447\u0435\u0432\u044B\u0435 \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0430",
        micro_adv1: "<strong>\u041C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F \u0442\u043E\u043B\u0449\u0438\u043D\u0430</strong> \u2014 \u0412\u0441\u0435\u0433\u043E 2-3\u043C\u043C. \u041D\u0435 \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0434\u0440\u0435\u0437\u0430\u0442\u044C \u0434\u0432\u0435\u0440\u0438, \u043D\u0435\u0442 \u043F\u0440\u043E\u0431\u043B\u0435\u043C \u0441 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430\u043C\u0438 \u0438 \u0443\u0440\u043E\u0432\u043D\u0435\u043C \u043F\u043E\u043B\u0430.",
        micro_adv2: "<strong>\u0411\u0435\u0441\u0448\u043E\u0432\u043D\u0430\u044F \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u043E\u0441\u0442\u044C</strong> \u2014 \u041D\u0435\u0442 \u0448\u0432\u043E\u0432, \u043D\u0435\u0442 \u0437\u0430\u0442\u0438\u0440\u043A\u0438. \u041F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C \u0442\u0435\u0447\u0451\u0442 \u0438\u0437 \u043A\u043E\u043C\u043D\u0430\u0442\u044B \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0443.",
        micro_adv3: "<strong>\u0414\u0440\u0443\u0436\u0435\u043B\u044E\u0431\u0435\u043D \u043A \u0440\u0435\u043D\u043E\u0432\u0430\u0446\u0438\u0438</strong> \u2014 \u0423\u043A\u043B\u0430\u0434\u043A\u0430 \u043F\u043E\u0432\u0435\u0440\u0445 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0445 \u043F\u043E\u043B\u043E\u0432 \u0431\u0435\u0437 \u0434\u0435\u043C\u043E\u043D\u0442\u0430\u0436\u0430. \u0411\u044B\u0441\u0442\u0440\u0435\u0435, \u0447\u0438\u0449\u0435, \u043C\u0435\u043D\u044C\u0448\u0435 \u0448\u0443\u043C\u0430.",
        micro_adv4: "<strong>\u0423\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0439 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440</strong> \u2014 \u0420\u0443\u0447\u043D\u043E\u0435 \u043D\u0430\u043D\u0435\u0441\u0435\u043D\u0438\u0435, \u0440\u0435\u043C\u0435\u0441\u043B\u0435\u043D\u043D\u0430\u044F \u043E\u0442\u0434\u0435\u043B\u043A\u0430. \u041A\u0430\u0436\u0434\u044B\u0439 \u043F\u043E\u043B \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439 \u0432 \u0441\u0432\u043E\u0451\u043C \u0440\u043E\u0434\u0435.",
        micro_adv5: "<strong>\u0422\u0451\u043F\u043B\u044B\u0439 \u043F\u043E\u043B</strong> \u2014 \u041E\u0442\u043B\u0438\u0447\u043D\u0430\u044F \u0442\u0435\u043F\u043B\u043E\u043F\u0440\u043E\u0432\u043E\u0434\u043D\u043E\u0441\u0442\u044C. \u0422\u043E\u043D\u044C\u0448\u0435 \u043F\u043B\u0438\u0442\u043A\u0438 \u2014 \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u043D\u0430\u0433\u0440\u0435\u0432.",
        micro_adv6: "<strong>\u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F</strong> \u2014 \u041F\u043E\u043B\u044B, \u0441\u0442\u0435\u043D\u044B, \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u044B, \u0441\u0442\u043E\u043B\u0435\u0448\u043D\u0438\u0446\u044B \u2014 \u0435\u0434\u0438\u043D\u044B\u0439 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044C\u043D\u044B\u0439 \u044F\u0437\u044B\u043A.",
        micro_h2_maintenance: "\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F",
        micro_p_maintenance: "\u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u0437\u0430\u0433\u0435\u0440\u043C\u0435\u0442\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u043C\u0438\u043A\u0440\u043E\u0442\u043E\u043F\u043F\u0438\u043D\u0433 \u0434\u043E\u043B\u0433\u043E\u0432\u0435\u0447\u0435\u043D \u0438 \u043F\u0440\u043E\u0441\u0442 \u0432 \u0443\u0445\u043E\u0434\u0435. \u0413\u0435\u0440\u043C\u0435\u0442\u0438\u043A \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u0442 \u043E\u0441\u043D\u043E\u0432\u043D\u0443\u044E \u0440\u0430\u0431\u043E\u0442\u0443 \u2014 \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442 \u0446\u0435\u043C\u0435\u043D\u0442\u043D\u0443\u044E \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C \u043E\u0442 \u043F\u044F\u0442\u0435\u043D \u0438 \u0438\u0437\u043D\u043E\u0441\u0430.",
        micro_maint_daily: "\u041F\u043E\u0434\u043C\u0435\u0442\u0430\u043D\u0438\u0435 \u0438\u043B\u0438 \u043F\u044B\u043B\u0435\u0441\u043E\u0441 \u0434\u043B\u044F \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u044F \u043F\u0435\u0441\u043A\u0430. \u0412\u043B\u0430\u0436\u043D\u0430\u044F \u0443\u0431\u043E\u0440\u043A\u0430 \u043F\u043E \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438 \u0441 \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u043C pH-\u043E\u0447\u0438\u0441\u0442\u0438\u0442\u0435\u043B\u0435\u043C.",
        micro_maint_weekly: "\u0412\u043B\u0430\u0436\u043D\u0430\u044F \u0443\u0431\u043E\u0440\u043A\u0430 \u0441 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u043E\u0432\u0430\u043D\u043D\u044B\u043C \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u0435\u043C \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E\u043C. \u0418\u0437\u0431\u0435\u0433\u0430\u0439\u0442\u0435 \u043A\u0438\u0441\u043B\u043E\u0442\u043D\u044B\u0445 \u0438\u043B\u0438 \u0430\u0431\u0440\u0430\u0437\u0438\u0432\u043D\u044B\u0445 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u043E\u0432.",
        micro_maint_annually: "\u041E\u0441\u043C\u043E\u0442\u0440 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F \u0433\u0435\u0440\u043C\u0435\u0442\u0438\u043A\u0430. \u0417\u043E\u043D\u044B \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0433\u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u043C\u043E\u0433\u0443\u0442 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F \u043A\u0430\u0436\u0434\u044B\u0435 2-3 \u0433\u043E\u0434\u0430.",
        micro_maint_asneeded: "\u0412\u043E\u0437\u043C\u043E\u0436\u0435\u043D \u0442\u043E\u0447\u0435\u0447\u043D\u044B\u0439 \u0440\u0435\u043C\u043E\u043D\u0442 \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u044B\u0445 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0439. \u041F\u043E\u043B\u043D\u0430\u044F \u043F\u0435\u0440\u0435\u0433\u0435\u0440\u043C\u0435\u0442\u0438\u0437\u0430\u0446\u0438\u044F \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F \u043A\u0430\u0436\u0434\u044B\u0435 5-7 \u043B\u0435\u0442.",
        micro_cta_title: "\u0413\u043E\u0442\u043E\u0432\u044B \u043A \u043F\u0440\u043E\u0435\u043A\u0442\u0443 \u0441 \u043C\u0438\u043A\u0440\u043E\u0442\u043E\u043F\u043F\u0438\u043D\u0433\u043E\u043C?",
        micro_cta_text: "\u041D\u0430\u0448\u0430 \u043A\u043E\u043C\u0430\u043D\u0434\u0430 \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u0432\u0430\u043C \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u0431\u0435\u0441\u0448\u043E\u0432\u043D\u044B\u0439 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439 \u043E\u0431\u0440\u0430\u0437, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432\u044B \u0438\u0449\u0435\u0442\u0435.",
        micro_specs_title: "\u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438",
        micro_spec_thickness: "\u041E\u0431\u0449\u0430\u044F \u0442\u043E\u043B\u0449\u0438\u043D\u0430",
        micro_spec_finish: "\u0422\u0438\u043F \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438",
        micro_spec_finish_v: "\u0411\u0435\u0441\u0448\u043E\u0432\u043D\u0430\u044F",
        micro_spec_flatness: "\u0420\u043E\u0432\u043D\u043E\u0441\u0442\u044C \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438",
        micro_spec_sheen: "\u0412\u0430\u0440\u0438\u0430\u043D\u0442\u044B \u0433\u043B\u044F\u043D\u0446\u0430",
        micro_spec_sheen_v: "\u041C\u0430\u0442\u043E\u0432\u044B\u0439/\u0421\u0430\u0442\u0438\u043D/\u0413\u043B\u044F\u043D\u0435\u0446",
        micro_perf_title: "\u041F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C",
        micro_perf_life: "10+ \u043B\u0435\u0442",
        micro_perf_traffic: "24 \u0447\u0430\u0441\u0430",
        micro_perf_cure: "7 \u0434\u043D\u0435\u0439",
        micro_spec_reseal: "\u041E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435 \u0433\u0435\u0440\u043C\u0435\u0442\u0438\u043A\u0430",
        micro_perf_reseal: "5-7 \u043B\u0435\u0442",
        micro_compat_title: "\u0421\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u043E\u0441\u0442\u044C",
        micro_compat_heat: "\u0422\u0451\u043F\u043B\u044B\u0439 \u043F\u043E\u043B",
        micro_compat_tiles: "\u041F\u043E\u0432\u0435\u0440\u0445 \u043F\u043B\u0438\u0442\u043A\u0438",
        micro_compat_wet: "\u0412\u043B\u0430\u0436\u043D\u044B\u0435 \u0437\u043E\u043D\u044B",
        micro_compat_wet_v: "\u0414\u0430 (\u0441 \u0433\u0435\u0440\u043C\u0435\u0442\u0438\u043A\u043E\u043C)",
        micro_compat_walls: "\u0421\u0442\u0435\u043D\u044B \u0438 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438",
        micro_warranty_years: "5 \u043B\u0435\u0442",
        micro_warranty_guide: "\u0420\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E \u043F\u043E \u0443\u0445\u043E\u0434\u0443",
        micro_rel1: "\u0422\u0435\u0440\u0440\u0430\u0446\u0446\u043E",
        micro_rel2: "\u0414\u0435\u043A\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0439 \u0431\u0435\u0442\u043E\u043D",
        micro_rel3: "\u042D\u043F\u043E\u043A\u0441\u0438\u0434\u043D\u044B\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B",
        // MMA
        mma_category: "\u0411\u044B\u0441\u0442\u0440\u043E\u0435 \u043E\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435",
        mma_title: "MMA-\u043F\u043E\u043B\u0438\u043C\u0435\u0440\u043D\u044B\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F",
        mma_meta: "\u041C\u0435\u0442\u0438\u043B\u043C\u0435\u0442\u0430\u043A\u0440\u0438\u043B\u0430\u0442\u043D\u044B\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B",
        mma_lead: "\u041C\u0435\u0442\u0438\u043B\u043C\u0435\u0442\u0430\u043A\u0440\u0438\u043B\u0430\u0442\u043D\u044B\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043E\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044E\u0442\u0441\u044F \u0437\u0430 \u0447\u0430\u0441\u044B, \u0430 \u043D\u0435 \u0434\u043D\u0438. \u041A\u043E\u0433\u0434\u0430 \u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u0441\u0442\u043E\u0438\u0442 \u0434\u043E\u0440\u043E\u0436\u0435 \u043F\u043E\u043B\u0430 \u2014 MMA \u0432\u044B\u0440\u0443\u0447\u0430\u0435\u0442, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044F \u043F\u043E\u043B\u043D\u0443\u044E \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0443 \u0443\u0436\u0435 \u0447\u0435\u0440\u0435\u0437 2-4 \u0447\u0430\u0441\u0430.",
        mma_h2_where: "\u0413\u0434\u0435 MMA \u043F\u0440\u0435\u0432\u043E\u0441\u0445\u043E\u0434\u0438\u0442",
        mma_p_where: "MMA-\u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435 \u2014 \u0440\u0435\u0448\u0435\u043D\u0438\u0435, \u043A\u043E\u0433\u0434\u0430 \u043E\u0431\u044B\u0447\u043D\u044B\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0431\u044B\u0441\u0442\u0440\u044B\u0435. \u0423\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u0430\u044F \u0445\u0438\u043C\u0438\u044F \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0443\u043A\u043B\u0430\u0434\u043A\u0443 \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438 \u0431\u044B \u0434\u0440\u0443\u0433\u0438\u0435 \u043F\u0440\u043E\u0435\u043A\u0442\u044B.",
        mma_app1_title: "\u041A\u0440\u0443\u0433\u043B\u043E\u0441\u0443\u0442\u043E\u0447\u043D\u044B\u0435 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430",
        mma_app1_desc: "\u041F\u0438\u0449\u0435\u0432\u044B\u0435, \u0444\u0430\u0440\u043C\u0430\u0446\u0435\u0432\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435, \u043B\u043E\u0433\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u2014 \u043E\u0431\u044A\u0435\u043A\u0442\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043D\u0435 \u043C\u043E\u0433\u0443\u0442 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F. \u0423\u043A\u043B\u0430\u0434\u043A\u0430 \u0432 \u0432\u044B\u0445\u043E\u0434\u043D\u044B\u0435 \u0438\u043B\u0438 \u043D\u043E\u0447\u044C\u044E.",
        mma_app2_title: "\u0425\u043E\u043B\u043E\u0434\u043D\u044B\u0435 \u0441\u043A\u043B\u0430\u0434\u044B",
        mma_app2_desc: "\u041E\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u0438 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0435 \u0434\u043E -30\xb0C. \u041C\u043E\u0440\u043E\u0437\u0438\u043B\u044C\u043D\u044B\u0435 \u043A\u0430\u043C\u0435\u0440\u044B, \u0445\u043E\u043B\u043E\u0434\u043E\u0432\u044B\u0435 \u0446\u0435\u043F\u0438, \u0440\u0435\u0444\u0440\u0438\u0436\u0435\u0440\u0430\u0442\u043E\u0440\u043D\u044B\u0435 \u0441\u043A\u043B\u0430\u0434\u044B.",
        mma_app3_title: "\u0420\u0438\u0442\u0435\u0439\u043B \u0440\u0435\u043D\u043E\u0432\u0430\u0446\u0438\u044F",
        mma_app3_desc: "\u0420\u0435\u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F \u0422\u0426, \u043F\u0435\u0440\u0435\u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435 \u0441\u0443\u043F\u0435\u0440\u043C\u0430\u0440\u043A\u0435\u0442\u043E\u0432 \u2014 \u0443\u043A\u043B\u0430\u0434\u043A\u0430 \u043D\u043E\u0447\u044C\u044E, \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u0435 \u0443\u0442\u0440\u043E\u043C.",
        mma_app4_title: "\u041C\u0435\u0434\u0438\u0446\u0438\u043D\u0430",
        mma_app4_desc: "\u0420\u0435\u043D\u043E\u0432\u0430\u0446\u0438\u044F \u0431\u043E\u043B\u044C\u043D\u0438\u0446, \u0440\u0435\u043C\u043E\u043D\u0442 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0445. \u0414\u043E\u0441\u0442\u0443\u043F\u043D\u044B \u0444\u043E\u0440\u043C\u0443\u043B\u044B \u0441 \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u043C \u0437\u0430\u043F\u0430\u0445\u043E\u043C.",
        mma_h2_speed: "\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0431\u0435\u0437 \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0438\u0441\u0441\u043E\u0432",
        mma_p_speed: "\u0411\u044B\u0441\u0442\u0440\u043E\u0435 \u043E\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435 MMA \u043D\u0435 \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u0441\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u0438\u0439 \u0432 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0435. \u041F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C \u0433\u043E\u0442\u043E\u0432\u0438\u0442\u0441\u044F \u043F\u043E \u0442\u0435\u043C \u0436\u0435 \u0441\u0442\u0440\u043E\u0433\u0438\u043C \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u0430\u043C, \u0447\u0442\u043E \u0438 \u0434\u043B\u044F \u044D\u043F\u043E\u043A\u0441\u0438\u0434\u0430.",
        mma_prep1: "<strong>\u0414\u0440\u043E\u0431\u0435\u0441\u0442\u0440\u0443\u0439\u043D\u0430\u044F \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0430</strong> \u2014 \u041F\u0440\u0435\u0434\u043F\u043E\u0447\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043C\u0435\u0442\u043E\u0434 \u0434\u043B\u044F \u043E\u043F\u0442\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0444\u0438\u043B\u044F. \u041C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C \u0441\u0440\u0430\u0437\u0443",
        mma_prep2: "<strong>\u0410\u043B\u043C\u0430\u0437\u043D\u0430\u044F \u0448\u043B\u0438\u0444\u043E\u0432\u043A\u0430</strong> \u2014 \u0410\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u0430, \u0433\u0434\u0435 \u0434\u0440\u043E\u0431\u0435\u0441\u0442\u0440\u0443\u0439\u043A\u0430 \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u0430",
        mma_prep3: "<strong>\u0423\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0441\u0442\u044C \u043A \u0432\u043B\u0430\u0433\u0435</strong> \u2014 \u0411\u043E\u043B\u0435\u0435 \u0442\u0435\u0440\u043F\u0438\u043C\u0430, \u0447\u0435\u043C \u044D\u043F\u043E\u043A\u0441\u0438\u0434, \u043D\u043E \u0438\u0437\u0431\u044B\u0442\u043E\u0447\u043D\u0430\u044F \u0432\u043B\u0430\u0433\u0430 \u0432\u0441\u0451 \u0436\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F",
        mma_prep4: "<strong>\u0425\u043E\u043B\u043E\u0434\u043D\u044B\u0435 \u0443\u0441\u043B\u043E\u0432\u0438\u044F</strong> \u2014 \u041D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u043E\u0431\u043E\u0433\u0440\u0435\u0432 \u0434\u043B\u044F \u0443\u043A\u043B\u0430\u0434\u043A\u0438 \u043F\u0440\u0438 \u043C\u0438\u043D\u0443\u0441\u043E\u0432\u044B\u0445 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430\u0445",
        mma_prep5: "<strong>\u0411\u044B\u0441\u0442\u0440\u043E\u0435 \u043E\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435 \u043F\u0440\u0430\u0439\u043C\u0435\u0440\u0430</strong> \u2014 MMA-\u043F\u0440\u0430\u0439\u043C\u0435\u0440\u044B \u043E\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u044E\u0442\u0441\u044F \u0437\u0430 30-60 \u043C\u0438\u043D\u0443\u0442, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044F \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u0441\u0438\u0441\u0442\u0435\u043C\u0443 \u0437\u0430 \u0434\u0435\u043D\u044C",
        mma_h2_system: "\u0410\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u044B",
        mma_p_system: "MMA-\u0441\u0438\u0441\u0442\u0435\u043C\u044B \u0441\u043B\u0435\u0434\u0443\u044E\u0442 \u0441\u0445\u043E\u0436\u0435\u043C\u0443 \u043C\u043D\u043E\u0433\u043E\u0441\u043B\u043E\u0439\u043D\u043E\u043C\u0443 \u043F\u043E\u0434\u0445\u043E\u0434\u0443 \u0441 \u044D\u043F\u043E\u043A\u0441\u0438\u0434\u043E\u043C, \u043D\u043E \u0441 \u0440\u0430\u0434\u0438\u043A\u0430\u043B\u044C\u043D\u043E \u0431\u043E\u043B\u0435\u0435 \u0431\u044B\u0441\u0442\u0440\u044B\u043C \u043E\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435\u043C \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u043C \u044D\u0442\u0430\u043F\u0435.",
        mma_layer1_title: "\u0420\u0435\u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0439 \u043F\u0440\u0430\u0439\u043C\u0435\u0440",
        mma_layer1_desc: "MMA-\u043F\u0440\u0430\u0439\u043C\u0435\u0440 \u043F\u0440\u043E\u043D\u0438\u043A\u0430\u0435\u0442 \u0438 \u0433\u0435\u0440\u043C\u0435\u0442\u0438\u0437\u0438\u0440\u0443\u0435\u0442 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0435. \u041E\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442\u0441\u044F \u0437\u0430 30-60 \u043C\u0438\u043D\u0443\u0442 \u043F\u0440\u0438 20\xb0C, \u043F\u0440\u043E\u043F\u043E\u0440\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u043F\u0440\u0438 \u0431\u043E\u043B\u0435\u0435 \u0432\u044B\u0441\u043E\u043A\u0438\u0445 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430\u0445.",
        mma_layer2_title: "\u041E\u0441\u043D\u043E\u0432\u043D\u043E\u0439 \u0441\u043B\u043E\u0439",
        mma_layer2_desc: "\u0421\u0430\u043C\u043E\u0432\u044B\u0440\u0430\u0432\u043D\u0438\u0432\u0430\u044E\u0449\u0430\u044F\u0441\u044F \u0438\u043B\u0438 \u043F\u043E\u0441\u044B\u043F\u043D\u0430\u044F MMA-\u0441\u043C\u043E\u043B\u0430. \u041F\u043E\u0441\u044B\u043F\u043A\u0430 \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u0435\u043C \u0434\u043B\u044F \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0441\u043A\u043E\u043B\u044C\u0436\u0435\u043D\u0438\u044F \u043F\u0440\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438. \u041E\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442\u0441\u044F \u0437\u0430 1-2 \u0447\u0430\u0441\u0430.",
        mma_layer3_title: "\u0424\u0438\u043D\u0438\u0448\u043D\u044B\u0439 \u0441\u043B\u043E\u0439",
        mma_layer3_desc: "\u041F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u044B\u0439 \u0438\u043B\u0438 \u043F\u0438\u0433\u043C\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0442\u043E\u043F\u043A\u043E\u0443\u0442. UV-\u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u044B\u0435 \u0430\u043B\u0438\u0444\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0444\u043E\u0440\u043C\u0443\u043B\u044B \u0434\u043B\u044F \u043D\u0430\u0440\u0443\u0436\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0438\u043B\u0438 \u044F\u0440\u043A\u043E \u043E\u0441\u0432\u0435\u0449\u0451\u043D\u043D\u044B\u0445 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0439. \u041F\u043E\u043B\u043D\u043E\u0435 \u043E\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435 \u0437\u0430 1-2 \u0447\u0430\u0441\u0430.",
        mma_h2_variants: "\u0412\u0430\u0440\u0438\u0430\u043D\u0442\u044B \u0441\u0438\u0441\u0442\u0435\u043C",
        mma_p_variants: "MMA \u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D \u0432 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445 \u043A\u043E\u043D\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u044F\u0445 \u043F\u043E\u0434 \u0432\u0430\u0448\u0438 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0435 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F:",
        mma_var1_title: "\u0421\u0430\u043C\u043E\u0432\u044B\u0440\u0430\u0432\u043D\u0438\u0432\u0430\u044E\u0449\u0438\u0439\u0441\u044F",
        mma_var1_desc: "\u0413\u043B\u0430\u0434\u043A\u0430\u044F \u0431\u0435\u0441\u0448\u043E\u0432\u043D\u0430\u044F \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C. 2-3\u043C\u043C. \u0411\u044B\u0441\u0442\u0440\u0430\u044F \u0443\u043A\u043B\u0430\u0434\u043A\u0430 \u0434\u043B\u044F \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0441\u0442\u043E\u044F.",
        mma_var2_title: "\u041A\u0432\u0430\u0440\u0446\u0435\u0432\u0430\u044F \u043F\u043E\u0441\u044B\u043F\u043A\u0430",
        mma_var2_desc: "\u0426\u0432\u0435\u0442\u043D\u043E\u0439 \u043A\u0432\u0430\u0440\u0446 \u0434\u043B\u044F \u0434\u043E\u043B\u0433\u043E\u0432\u0435\u0447\u043D\u043E\u0441\u0442\u0438 \u0438 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0441\u043A\u043E\u043B\u044C\u0436\u0435\u043D\u0438\u044F. \u041E\u0431\u0449\u0430\u044F \u0442\u043E\u043B\u0449\u0438\u043D\u0430 3-4\u043C\u043C.",
        mma_var3_title: "\u041F\u0440\u043E\u0442\u0438\u0432\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u044F\u0449\u0438\u0439",
        mma_var3_desc: "\u0422\u0435\u043A\u0441\u0442\u0443\u0440\u043D\u0430\u044F \u043F\u043E\u0441\u044B\u043F\u043A\u0430 \u0434\u043B\u044F \u0432\u043B\u0430\u0436\u043D\u044B\u0445 \u0437\u043E\u043D, \u043F\u0430\u043D\u0434\u0443\u0441\u043E\u0432 \u0438 \u043D\u0430\u0440\u0443\u0436\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F.",
        mma_var4_title: "\u0414\u0435\u043A\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0439 \u0444\u043B\u0435\u0439\u043A",
        mma_var4_desc: "\u041F\u043E\u0441\u044B\u043F\u043A\u0430 \u0446\u0432\u0435\u0442\u043D\u044B\u043C\u0438 \u0447\u0438\u043F\u0441\u0430\u043C\u0438 \u0434\u043B\u044F \u044D\u0441\u0442\u0435\u0442\u0438\u043A\u0438. \u041F\u043E\u043F\u0443\u043B\u044F\u0440\u0435\u043D \u0432 \u0440\u0438\u0442\u0435\u0439\u043B\u0435 \u0438 \u043A\u043E\u043C\u043C\u0435\u0440\u0446\u0438\u0438.",
        mma_h2_advantages: "\u041A\u043B\u044E\u0447\u0435\u0432\u044B\u0435 \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0430",
        mma_adv1: "<strong>\u0411\u044B\u0441\u0442\u0440\u043E\u0435 \u043E\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435</strong> \u2014 \u041F\u043E\u043B\u043D\u0430\u044F \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0430 \u0447\u0435\u0440\u0435\u0437 2-4 \u0447\u0430\u0441\u0430. \u0417\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0435\u043A\u0442\u0430 \u0437\u0430 \u043E\u0434\u043D\u0443 \u0441\u043C\u0435\u043D\u0443 \u0438\u043B\u0438 \u043D\u043E\u0447\u044C.",
        mma_adv2: "<strong>\u041E\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435 \u043F\u0440\u0438 \u043D\u0438\u0437\u043A\u0438\u0445 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430\u0445</strong> \u2014 \u0423\u043A\u043B\u0430\u0434\u043A\u0430 \u043E\u0442 -30\xb0C \u0434\u043E +35\xb0C. \u041D\u0435 \u043D\u0443\u0436\u0435\u043D \u043E\u0431\u043E\u0433\u0440\u0435\u0432 \u0434\u043B\u044F \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0445 \u0441\u043A\u043B\u0430\u0434\u043E\u0432 \u0438\u043B\u0438 \u0437\u0438\u043C\u043D\u0438\u0445 \u0440\u0430\u0431\u043E\u0442.",
        mma_adv3: "<strong>UV-\u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C</strong> \u2014 \u0410\u043B\u0438\u0444\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 MMA \u043D\u0435 \u0436\u0435\u043B\u0442\u0435\u0435\u0442 \u0438 \u043D\u0435 \u043C\u0435\u043B\u0438\u0442\u0441\u044F. \u041F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0434\u043B\u044F \u043D\u0430\u0440\u0443\u0436\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F.",
        mma_adv4: "<strong>\u0425\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C</strong> \u2014 \u041E\u0442\u043B\u0438\u0447\u043D\u0430\u044F \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0441\u0442\u044C \u043A \u043A\u0438\u0441\u043B\u043E\u0442\u0430\u043C, \u0449\u0435\u043B\u043E\u0447\u0430\u043C \u0438 \u043C\u043D\u043E\u0433\u0438\u043C \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0438\u0442\u0435\u043B\u044F\u043C.",
        mma_adv5: "<strong>\u0413\u0438\u0431\u043A\u043E\u0441\u0442\u044C</strong> \u2014 \u0413\u0438\u0431\u0447\u0435 \u044D\u043F\u043E\u043A\u0441\u0438\u0434\u0430, \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0432\u043E\u043B\u043E\u0441\u044F\u043D\u044B\u0435 \u0442\u0440\u0435\u0449\u0438\u043D\u044B, \u0430\u0434\u0430\u043F\u0442\u0438\u0440\u0443\u0435\u0442\u0441\u044F \u043A \u043F\u043E\u0434\u0432\u0438\u0436\u043A\u0430\u043C \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F.",
        mma_adv6: "<strong>\u041C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0439 \u043F\u0440\u043E\u0441\u0442\u043E\u0439</strong> \u2014 \u0413\u043B\u0430\u0432\u043D\u043E\u0435 \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E \u2014 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u043E \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0441\u044F \u0441 \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u043C\u0438 \u043F\u0435\u0440\u0435\u0440\u044B\u0432\u0430\u043C\u0438.",
        mma_h2_maintenance: "\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F",
        mma_p_maintenance: "MMA-\u043F\u043E\u043B\u044B \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0442 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C, \u0441\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043C\u0443\u044E \u0441 \u044D\u043F\u043E\u043A\u0441\u0438\u0434\u043E\u043C, \u043F\u0440\u0438 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0431\u043E\u043B\u0435\u0435 \u0431\u044B\u0441\u0442\u0440\u043E\u0439 \u0443\u043A\u043B\u0430\u0434\u043A\u0435. \u0423\u0445\u043E\u0434 \u043F\u0440\u043E\u0441\u0442.",
        mma_maint_daily: "\u041F\u043E\u0434\u043C\u0435\u0442\u0430\u043D\u0438\u0435 \u0438\u043B\u0438 \u0430\u0432\u0442\u043E\u0441\u043A\u0440\u0430\u0431\u0435\u0440 \u0434\u043B\u044F \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u044F \u043C\u0443\u0441\u043E\u0440\u0430. \u0422\u043E\u0447\u0435\u0447\u043D\u0430\u044F \u0443\u0431\u043E\u0440\u043A\u0430 \u0440\u0430\u0437\u043B\u0438\u0432\u043E\u0432 \u043F\u043E \u043C\u0435\u0440\u0435 \u0432\u043E\u0437\u043D\u0438\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u044F.",
        mma_maint_weekly: "\u041C\u0430\u0448\u0438\u043D\u043D\u0430\u044F \u043C\u043E\u0439\u043A\u0430 \u0441 \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u043C pH-\u043E\u0447\u0438\u0441\u0442\u0438\u0442\u0435\u043B\u0435\u043C. \u0422\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u043E\u043F\u043E\u043B\u0430\u0441\u043A\u0438\u0432\u0430\u043D\u0438\u0435.",
        mma_maint_quarterly: "\u0413\u043B\u0443\u0431\u043E\u043A\u0430\u044F \u043E\u0447\u0438\u0441\u0442\u043A\u0430 \u0438 \u043E\u0441\u043C\u043E\u0442\u0440. \u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F \u0442\u043E\u043F\u043A\u043E\u0443\u0442\u0430 \u0432 \u0437\u043E\u043D\u0430\u0445 \u0438\u0437\u043D\u043E\u0441\u0430.",
        mma_maint_asneeded: "\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u0431\u044B\u0441\u0442\u0440\u043E\u0435 \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0442\u0438\u0435 \u2014 MMA-\u0442\u043E\u043F\u043A\u043E\u0443\u0442 \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u043D\u0435\u0441\u0442\u0438 \u0441 \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0439 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u043E\u0439.",
        mma_cta_title: "\u041D\u0443\u0436\u0435\u043D \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0439 \u043F\u0440\u043E\u0441\u0442\u043E\u0439?",
        mma_cta_text: "\u041E\u0431\u0441\u0443\u0434\u0438\u043C, \u043A\u0430\u043A MMA \u0440\u0435\u0448\u0438\u0442 \u0432\u0430\u0448\u0443 \u0437\u0430\u0434\u0430\u0447\u0443 \u0431\u044B\u0441\u0442\u0440\u043E\u0439 \u0443\u043A\u043B\u0430\u0434\u043A\u0438.",
        mma_specs_title: "\u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438",
        mma_spec_thickness: "\u0422\u043E\u043B\u0449\u0438\u043D\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u044B",
        mma_spec_traffic: "\u0413\u043E\u0442\u043E\u0432\u043D\u043E\u0441\u0442\u044C \u043A \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0435",
        mma_spec_primer: "\u041E\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435 \u043F\u0440\u0430\u0439\u043C\u0435\u0440\u0430",
        mma_temp_title: "\u0414\u0438\u0430\u043F\u0430\u0437\u043E\u043D \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440",
        mma_temp_min: "\u041C\u0438\u043D. \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u0443\u043A\u043B\u0430\u0434\u043A\u0438",
        mma_temp_max: "\u041C\u0430\u043A\u0441. \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u0443\u043A\u043B\u0430\u0434\u043A\u0438",
        mma_temp_service: "\u0420\u0430\u0431\u043E\u0447\u0438\u0439 \u0434\u0438\u0430\u043F\u0430\u0437\u043E\u043D",
        mma_temp_humidity: "\u0423\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0441\u0442\u044C \u043A \u0432\u043B\u0430\u0436\u043D\u043E\u0441\u0442\u0438",
        mma_temp_humidity_v: "\u0412\u044B\u0441\u043E\u043A\u0430\u044F",
        mma_perf_title: "\u041F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C",
        mma_perf_uv: "UV-\u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C",
        mma_perf_uv_v: "\u041E\u0442\u043B\u0438\u0447\u043D\u0430\u044F",
        mma_perf_chem: "\u0425\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C",
        mma_perf_chem_v: "\u041E\u0442\u043B\u0438\u0447\u043D\u0430\u044F",
        mma_perf_flex: "\u0413\u0438\u0431\u043A\u043E\u0441\u0442\u044C",
        mma_perf_flex_v: "\u0412\u044B\u0441\u043E\u043A\u0430\u044F",
        mma_warranty_years: "5 \u043B\u0435\u0442",
        mma_warranty_repair: "\u0410\u0432\u0430\u0440\u0438\u0439\u043D\u044B\u0439 \u0440\u0435\u043C\u043E\u043D\u0442",
        mma_warranty_repair_v: "\u0414\u043E\u0441\u0442\u0443\u043F\u0435\u043D",
        mma_rel1: "\u042D\u043F\u043E\u043A\u0441\u0438\u0434\u043D\u044B\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F",
        mma_rel2: "PU-\u0446\u0435\u043C\u0435\u043D\u0442",
        mma_rel3: "\u0420\u0435\u0437\u0438\u043D\u043E\u0432\u044B\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F",
        // PU-Cement
        puc_category: "\u0422\u0435\u0440\u043C\u043E\u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C",
        puc_title: "PU-\u0446\u0435\u043C\u0435\u043D\u0442\u043D\u044B\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F",
        puc_meta: "\u041F\u043E\u043B\u0438\u0443\u0440\u0435\u0442\u0430\u043D-\u0446\u0435\u043C\u0435\u043D\u0442\u043D\u044B\u0435 \u0433\u0438\u0431\u0440\u0438\u0434\u043D\u044B\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B",
        puc_lead: "\u041F\u043E\u043B\u0438\u0443\u0440\u0435\u0442\u0430\u043D-\u0446\u0435\u043C\u0435\u043D\u0442\u043D\u044B\u0435 \u0433\u0438\u0431\u0440\u0438\u0434\u043D\u044B\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u0434\u043B\u044F \u044D\u043A\u0441\u0442\u0440\u0435\u043C\u0430\u043B\u044C\u043D\u044B\u0445 \u0442\u0435\u0440\u043C\u043E\u0446\u0438\u043A\u043B\u043E\u0432. \u041E\u0442 \u043A\u0438\u043F\u044F\u0442\u043A\u0430 \u0434\u043E \u043C\u043E\u0440\u043E\u0437\u0438\u043B\u044C\u043D\u044B\u0445 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440 \u2014 \u0431\u0435\u0437 \u0442\u0440\u0435\u0449\u0438\u043D. \u041E\u0442\u0440\u0430\u0441\u043B\u0435\u0432\u043E\u0439 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442 \u0434\u043B\u044F \u043F\u0438\u0449\u0435\u0432\u043E\u0439 \u043F\u0440\u043E\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u043E\u0441\u0442\u0438.",
        puc_h2_where: "\u0413\u0434\u0435 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F PU-\u0446\u0435\u043C\u0435\u043D\u0442",
        puc_p_where: "PU-\u0446\u0435\u043C\u0435\u043D\u0442 \u2014 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0439, \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u0430\u044F \u0434\u043B\u044F \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u0439 \u043F\u0438\u0449\u0435\u0432\u043E\u0439 \u043F\u0440\u043E\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u043E\u0441\u0442\u0438, \u0433\u0434\u0435 \u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u0442\u0435\u0440\u043C\u043E\u0448\u043E\u043A, \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043D\u0430\u044F \u0443\u0431\u043E\u0440\u043A\u0430 \u0438 \u0433\u0438\u0433\u0438\u0435\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F.",
        puc_app1_title: "\u041F\u0438\u0449\u0435\u0432\u0430\u044F \u0438 \u043D\u0430\u043F\u0438\u0442\u043E\u0447\u043D\u0430\u044F \u043F\u0440\u043E\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u043E\u0441\u0442\u044C",
        puc_app1_desc: "\u041F\u0438\u0432\u043E\u0432\u0430\u0440\u043D\u0438, \u043C\u043E\u043B\u043E\u0447\u043D\u044B\u0435 \u0437\u0430\u0432\u043E\u0434\u044B, \u043C\u044F\u0441\u043E\u043F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u043A\u0430. \u0413\u043E\u0440\u044F\u0447\u0430\u044F \u043C\u043E\u0439\u043A\u0430, \u0449\u0435\u043B\u043E\u0447\u043D\u0430\u044F \u0443\u0431\u043E\u0440\u043A\u0430, \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043F\u0430\u0440\u0430. \u041E\u0442\u0440\u0430\u0441\u043B\u0435\u0432\u043E\u0439 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442.",
        puc_app2_title: "\u041A\u043E\u043C\u043C\u0435\u0440\u0447\u0435\u0441\u043A\u0438\u0435 \u043A\u0443\u0445\u043D\u0438",
        puc_app2_desc: "\u0420\u0430\u0437\u043B\u0438\u0432\u044B \u0433\u043E\u0440\u044F\u0447\u0435\u0433\u043E \u043C\u0430\u0441\u043B\u0430, \u043A\u0438\u043F\u044F\u0442\u043E\u043A, \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u0430\u044F \u0443\u0431\u043E\u0440\u043A\u0430. \u041F\u0440\u043E\u0442\u0438\u0432\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u044F\u0449\u0430\u044F \u0442\u0435\u043A\u0441\u0442\u0443\u0440\u0430 \u0434\u043B\u044F \u0432\u043B\u0430\u0436\u043D\u044B\u0445 \u0441\u0440\u0435\u0434.",
        puc_app3_title: "\u0424\u0430\u0440\u043C\u0430\u0446\u0435\u0432\u0442\u0438\u043A\u0430",
        puc_app3_desc: "\u0421\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u043E\u0441\u0442\u044C \u0441 CIP. \u0412\u044B\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043D\u044B\u0435 \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u044B \u0441\u0430\u043D\u0438\u0442\u0430\u0440\u043D\u043E\u0439 \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0438.",
        puc_app4_title: "\u041F\u0435\u043A\u0430\u0440\u043D\u0438 \u0438 \u043F\u0440\u0430\u0447\u0435\u0447\u043D\u044B\u0435",
        puc_app4_desc: "\u0418\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u044B \u0433\u043E\u0440\u044F\u0447\u0438\u0445 \u043F\u0435\u0447\u0435\u0439, \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043F\u0430\u0440\u0430, \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u0430\u044F \u0432\u043B\u0430\u0436\u043D\u043E\u0441\u0442\u044C, \u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C \u043A \u043C\u043E\u044E\u0449\u0438\u043C \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\u043C.",
        puc_h2_built: "\u0421\u043E\u0437\u0434\u0430\u043D \u0434\u043B\u044F \u043D\u0430\u0433\u0440\u0443\u0437\u043E\u043A",
        puc_p_built: "PU-\u0446\u0435\u043C\u0435\u043D\u0442\u043D\u044B\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u2014 \u0442\u043E\u043B\u0441\u0442\u043E\u0441\u043B\u043E\u0439\u043D\u044B\u0435 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u044B, \u0442\u0440\u0435\u0431\u0443\u044E\u0449\u0438\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0433\u043E \u0434\u0440\u0435\u043D\u0430\u0436\u0430 \u0438 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0438 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F \u0434\u043B\u044F \u043E\u043F\u0442\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B.",
        puc_prep1: "<strong>\u0423\u043A\u043B\u043E\u043D\u044B \u043A \u0442\u0440\u0430\u043F\u0430\u043C</strong> \u2014 \u041C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0439 \u0443\u043A\u043B\u043E\u043D 1:80. \u041C\u044B \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u043C \u0441\u0442\u044F\u0436\u043A\u0438 \u0434\u043B\u044F \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0433\u043E \u0434\u0440\u0435\u043D\u0430\u0436\u0430",
        puc_prep2: "<strong>\u0414\u0440\u043E\u0431\u0435\u0441\u0442\u0440\u0443\u0439\u043D\u0430\u044F \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0430</strong> \u2014 \u0410\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043D\u044B\u0439 \u043F\u0440\u043E\u0444\u0438\u043B\u044C (CSP 5-7) \u0434\u043B\u044F \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u0441\u0446\u0435\u043F\u043B\u0435\u043D\u0438\u044F",
        puc_prep3: "<strong>\u0417\u0430\u043A\u0440\u0443\u0433\u043B\u0451\u043D\u043D\u044B\u0435 \u043F\u043B\u0438\u043D\u0442\u0443\u0441\u044B</strong> \u2014 \u0418\u043D\u0442\u0435\u0433\u0440\u0430\u043B\u044C\u043D\u044B\u0439 \u043F\u043B\u0438\u043D\u0442\u0443\u0441 \u043D\u0430 \u043F\u0440\u0438\u043C\u044B\u043A\u0430\u043D\u0438\u044F\u0445 \u043A \u0441\u0442\u0435\u043D\u0430\u043C \u0443\u0441\u0442\u0440\u0430\u043D\u044F\u0435\u0442 \u0443\u0433\u043B\u043E\u0432\u044B\u0435 \u0448\u0432\u044B",
        puc_prep4: "<strong>\u041B\u043E\u0442\u043A\u043E\u0432\u044B\u0435 \u0442\u0440\u0430\u043F\u044B</strong> \u2014 \u041D\u0435\u0440\u0436\u0430\u0432\u0435\u044E\u0449\u0438\u0439 \u0434\u0440\u0435\u043D\u0430\u0436 \u0438\u043D\u0442\u0435\u0433\u0440\u0438\u0440\u043E\u0432\u0430\u043D \u0432 \u0441\u0438\u0441\u0442\u0435\u043C\u0443 \u043F\u043E\u043B\u0430",
        puc_prep5: "<strong>\u0423\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0441\u0442\u044C \u043A \u0432\u043B\u0430\u0433\u0435</strong> \u2014 PU-\u0446\u0435\u043C\u0435\u043D\u0442 \u0432\u043B\u0430\u0433\u043E\u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432, \u043D\u043E \u0438\u0437\u0431\u044B\u0442\u043E\u0447\u043D\u0443\u044E \u0432\u043E\u0434\u0443 \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u0443\u0441\u0442\u0440\u0430\u043D\u0438\u0442\u044C",
        puc_h2_system: "\u0410\u0440\u0445\u0438\u0442\u0435\u043A\u0442\u0443\u0440\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u044B",
        puc_p_system: "PU-\u0446\u0435\u043C\u0435\u043D\u0442\u043D\u044B\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u0441\u043E\u0447\u0435\u0442\u0430\u044E\u0442 \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C \u0446\u0435\u043C\u0435\u043D\u0442\u0430 \u0441 \u0433\u0438\u0431\u043A\u043E\u0441\u0442\u044C\u044E \u0438 \u0445\u0438\u043C\u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C\u044E \u043F\u043E\u043B\u0438\u0443\u0440\u0435\u0442\u0430\u043D\u0430.",
        puc_layer1_title: "\u0410\u0434\u0433\u0435\u0437\u0438\u043E\u043D\u043D\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430",
        puc_layer1_desc: "\u042D\u043F\u043E\u043A\u0441\u0438\u0434\u043D\u044B\u0439 \u0438\u043B\u0438 \u043F\u043E\u043B\u0438\u0443\u0440\u0435\u0442\u0430\u043D\u043E\u0432\u044B\u0439 \u043F\u0440\u0430\u0439\u043C\u0435\u0440 \u0441\u043E\u0437\u0434\u0430\u0451\u0442 \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u0441\u0432\u044F\u0437\u044C \u0441 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u043C \u0431\u0435\u0442\u043E\u043D\u043E\u043C. \u041A\u0440\u0438\u0442\u0438\u0447\u0435\u043D \u0434\u043B\u044F \u0430\u0434\u0433\u0435\u0437\u0438\u0438 \u043F\u0440\u0438 \u0442\u0435\u0440\u043C\u043E\u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0430\u0445.",
        puc_layer2_title: "PU-\u0446\u0435\u043C\u0435\u043D\u0442\u043D\u044B\u0439 \u0440\u0430\u0441\u0442\u0432\u043E\u0440",
        puc_layer2_desc: "\u041F\u043E\u043B\u0438\u0443\u0440\u0435\u0442\u0430\u043D-\u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0439 \u0446\u0435\u043C\u0435\u043D\u0442\u043D\u044B\u0439 \u0440\u0430\u0441\u0442\u0432\u043E\u0440 \u0437\u0430\u0442\u0438\u0440\u0430\u0435\u0442\u0441\u044F \u0434\u043E \u0437\u0430\u0434\u0430\u043D\u043D\u043E\u0439 \u0442\u043E\u043B\u0449\u0438\u043D\u044B. \u0421\u043E\u0434\u0435\u0440\u0436\u0438\u0442 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435 \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u0438 \u0434\u043B\u044F \u0442\u0435\u0440\u043C\u043E\u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u0438 \u0438 \u0438\u0437\u043D\u043E\u0441\u043E\u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u0438.",
        puc_layer3_title: "\u0424\u0438\u043D\u0438\u0448\u043D\u044B\u0439 \u0441\u043B\u043E\u0439",
        puc_layer3_desc: "\u041F\u043E\u043B\u0438\u0443\u0440\u0435\u0442\u0430\u043D\u043E\u0432\u044B\u0439 \u0442\u043E\u043F\u043A\u043E\u0443\u0442 \u0433\u0435\u0440\u043C\u0435\u0442\u0438\u0437\u0438\u0440\u0443\u0435\u0442 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0445\u0438\u043C\u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C \u0438 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442 \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0441\u043A\u043E\u043B\u044C\u0436\u0435\u043D\u0438\u044F.",
        puc_h2_texture: "\u0412\u0430\u0440\u0438\u0430\u043D\u0442\u044B \u0442\u0435\u043A\u0441\u0442\u0443\u0440\u044B",
        puc_p_texture: "\u041F\u0440\u043E\u0442\u0438\u0432\u043E\u0441\u043A\u043E\u043B\u044C\u0436\u0435\u043D\u0438\u0435 \u043A\u0440\u0438\u0442\u0438\u0447\u043D\u043E \u0432\u043E \u0432\u043B\u0430\u0436\u043D\u044B\u0445 \u043F\u0438\u0449\u0435\u0432\u044B\u0445 \u0441\u0440\u0435\u0434\u0430\u0445. \u041C\u044B \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u043C \u043F\u043E\u043B\u043D\u044B\u0439 \u0441\u043F\u0435\u043A\u0442\u0440 \u0442\u0435\u043A\u0441\u0442\u0443\u0440:",
        puc_var1_title: "\u0413\u043B\u0430\u0434\u043A\u0430\u044F (R10)",
        puc_var1_desc: "\u041B\u0435\u0433\u043A\u043E \u043C\u043E\u0435\u0442\u0441\u044F, \u0443\u043C\u0435\u0440\u0435\u043D\u043D\u043E\u0435 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0441\u043A\u043E\u043B\u044C\u0436\u0435\u043D\u0438\u0435. \u0421\u0443\u0445\u0438\u0435 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435 \u0437\u043E\u043D\u044B.",
        puc_var2_title: "\u0421\u0440\u0435\u0434\u043D\u044F\u044F (R11)",
        puc_var2_desc: "\u0411\u0430\u043B\u0430\u043D\u0441 \u043C\u0435\u0436\u0434\u0443 \u043E\u0447\u0438\u0449\u0430\u0435\u043C\u043E\u0441\u0442\u044C\u044E \u0438 \u0441\u0446\u0435\u043F\u043B\u0435\u043D\u0438\u0435\u043C. \u0411\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E \u043F\u0438\u0449\u0435\u0432\u044B\u0445 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432.",
        puc_var3_title: "\u0413\u0440\u0443\u0431\u0430\u044F (R12)",
        puc_var3_desc: "\u041F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0435 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0441\u043A\u043E\u043B\u044C\u0436\u0435\u043D\u0438\u0435 \u0434\u043B\u044F \u0432\u043B\u0430\u0436\u043D\u044B\u0445/\u043C\u0430\u0441\u043B\u044F\u043D\u0438\u0441\u0442\u044B\u0445 \u0437\u043E\u043D. \u0427\u0443\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435 \u0443\u0441\u0438\u043B\u0438\u0439 \u0434\u043B\u044F \u0443\u0431\u043E\u0440\u043A\u0438.",
        puc_var4_title: "\u0422\u044F\u0436\u0451\u043B\u0430\u044F (R13)",
        puc_var4_desc: "\u041C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435 \u0441\u0446\u0435\u043F\u043B\u0435\u043D\u0438\u0435 \u0434\u043B\u044F \u044D\u043A\u0441\u0442\u0440\u0435\u043C\u0430\u043B\u044C\u043D\u043E \u0432\u043B\u0430\u0436\u043D\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u0439. \u041F\u0440\u043E\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u044B\u0435 \u0434\u0440\u0435\u043D\u0430\u0436\u043D\u044B\u0435 \u0437\u043E\u043D\u044B.",
        puc_h2_advantages: "\u041A\u043B\u044E\u0447\u0435\u0432\u044B\u0435 \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0430",
        puc_adv1: "<strong>\u0422\u0435\u0440\u043C\u043E\u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C</strong> \u2014 \u0412\u044B\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u043E\u0442 -40\xb0C \u0434\u043E +120\xb0C \u0431\u0435\u0437 \u0440\u0430\u0441\u0442\u0440\u0435\u0441\u043A\u0438\u0432\u0430\u043D\u0438\u044F. \u041D\u0435\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u044B\u0435 \u0442\u0435\u0440\u043C\u043E\u0446\u0438\u043A\u043B\u044B.",
        puc_adv2: "<strong>\u041F\u0430\u0440 \u0438 \u0433\u043E\u0440\u044F\u0447\u0430\u044F \u0432\u043E\u0434\u0430</strong> \u2014 \u0420\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043D \u043D\u0430 \u0435\u0436\u0435\u0434\u043D\u0435\u0432\u043D\u0443\u044E \u043F\u0430\u0440\u043E\u0432\u0443\u044E \u0443\u0431\u043E\u0440\u043A\u0443 \u0438 \u0433\u043E\u0440\u044F\u0447\u0443\u044E \u043C\u043E\u0439\u043A\u0443. \u041E\u0442\u0440\u0430\u0441\u043B\u0435\u0432\u043E\u0439 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442 \u0434\u043B\u044F \u043F\u0438\u0449\u0435\u043F\u0440\u043E\u043C\u0430.",
        puc_adv3: "<strong>\u0425\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C</strong> \u2014 \u0423\u0441\u0442\u043E\u0439\u0447\u0438\u0432 \u043A \u043E\u0440\u0433\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043A\u0438\u0441\u043B\u043E\u0442\u0430\u043C, \u0449\u0435\u043B\u043E\u0447\u0430\u043C, \u043C\u043E\u044E\u0449\u0438\u043C \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\u043C. HACCP-\u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C.",
        puc_adv4: "<strong>\u041F\u0440\u043E\u0442\u0438\u0432\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u044F\u0449\u0438\u0435 \u0442\u0435\u043A\u0441\u0442\u0443\u0440\u044B</strong> \u2014 \u0414\u0438\u0430\u043F\u0430\u0437\u043E\u043D \u043A\u043B\u0430\u0441\u0441\u043E\u0432 (R10-R13) \u043F\u043E\u0434 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0435 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F \u0437\u043E\u043D.",
        puc_adv5: "<strong>\u0423\u0434\u0430\u0440\u043E\u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C</strong> \u2014 \u0422\u043E\u043B\u0441\u0442\u043E\u0441\u043B\u043E\u0439\u043D\u044B\u0439 \u0440\u0430\u0441\u0442\u0432\u043E\u0440 \u043F\u043E\u0433\u043B\u043E\u0449\u0430\u0435\u0442 \u0443\u0434\u0430\u0440\u044B. \u041F\u0430\u0434\u0430\u044E\u0449\u0435\u0435 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435, \u0440\u043E\u0445\u043B\u0438, \u0442\u044F\u0436\u0451\u043B\u044B\u0435 \u0433\u0440\u0443\u0437\u044B.",
        puc_adv6: "<strong>\u0413\u0438\u0433\u0438\u0435\u043D\u0438\u0447\u043D\u044B\u0439 \u0434\u0438\u0437\u0430\u0439\u043D</strong> \u2014 \u0411\u0435\u0441\u0448\u043E\u0432\u043D\u043E\u0441\u0442\u044C \u0441 \u0437\u0430\u043A\u0440\u0443\u0433\u043B\u0451\u043D\u043D\u044B\u043C\u0438 \u043F\u043B\u0438\u043D\u0442\u0443\u0441\u0430\u043C\u0438. \u041D\u0435\u0442 \u0448\u0432\u043E\u0432 \u0434\u043B\u044F \u0441\u043A\u043E\u043F\u043B\u0435\u043D\u0438\u044F \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u0439.",
        puc_h2_maintenance: "\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F",
        puc_p_maintenance: "PU-\u0446\u0435\u043C\u0435\u043D\u0442 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D \u0434\u043B\u044F \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043D\u044B\u0445 \u0440\u0435\u0436\u0438\u043C\u043E\u0432 \u0443\u0431\u043E\u0440\u043A\u0438. \u0421\u0438\u0441\u0442\u0435\u043C\u0430 \u0443\u043B\u0443\u0447\u0448\u0430\u0435\u0442\u0441\u044F \u043E\u0442 \u0440\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u043E\u0439 \u043E\u0447\u0438\u0441\u0442\u043A\u0438.",
        puc_maint_shift: "\u041A\u043E\u043D\u0435\u0446 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439 \u0441\u043C\u0435\u043D\u044B",
        puc_maint_shift_desc: "\u041C\u043E\u0439\u043A\u0430 \u0433\u043E\u0440\u044F\u0447\u0435\u0439 \u0432\u043E\u0434\u043E\u0439, \u0447\u0438\u0441\u0442\u043A\u0430 \u0441 \u043C\u043E\u044E\u0449\u0438\u043C \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E\u043C, \u043E\u043F\u043E\u043B\u0430\u0441\u043A\u0438\u0432\u0430\u043D\u0438\u0435. \u041F\u043E\u043B \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043D \u043D\u0430 \u044D\u0442\u043E\u0442 \u0435\u0436\u0435\u0434\u043D\u0435\u0432\u043D\u044B\u0439 \u0446\u0438\u043A\u043B.",
        puc_maint_weekly: "\u0413\u043B\u0443\u0431\u043E\u043A\u0430\u044F \u043E\u0447\u0438\u0441\u0442\u043A\u0430 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0438\u043C\u0438 \u0445\u0438\u043C\u0438\u043A\u0430\u0442\u0430\u043C\u0438. \u0429\u0435\u043B\u043E\u0447\u044C \u0438\u043B\u0438 \u043A\u0438\u0441\u043B\u043E\u0442\u0430 \u043F\u043E \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044E \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0430.",
        puc_maint_quarterly: "\u041E\u0441\u043C\u043E\u0442\u0440 \u0442\u0440\u0430\u043F\u043E\u0432, \u043F\u043B\u0438\u043D\u0442\u0443\u0441\u043E\u0432 \u0438 \u0437\u043E\u043D \u0438\u0437\u043D\u043E\u0441\u0430. \u0422\u043E\u0447\u0435\u0447\u043D\u044B\u0439 \u0440\u0435\u043C\u043E\u043D\u0442 \u043F\u043E \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438.",
        puc_maint_annually: "\u041F\u043E\u043B\u043D\u044B\u0439 \u043E\u0441\u043C\u043E\u0442\u0440 \u0441\u0438\u0441\u0442\u0435\u043C\u044B. \u041F\u0435\u0440\u0435\u0433\u0435\u0440\u043C\u0435\u0442\u0438\u0437\u0430\u0446\u0438\u044F \u0437\u043E\u043D \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0433\u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u043F\u0440\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438.",
        puc_cta_title: "\u041F\u0440\u043E\u0435\u043A\u0442 \u043F\u043E\u043B\u0430 \u0434\u043B\u044F \u043F\u0438\u0449\u0435\u043F\u0440\u043E\u043C\u0430?",
        puc_cta_text: "\u041D\u0430\u0448\u0430 \u043A\u043E\u043C\u0430\u043D\u0434\u0430 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0437\u0438\u0440\u0443\u0435\u0442\u0441\u044F \u043D\u0430 HACCP-\u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u044B\u0445 \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0445 \u043F\u043E\u043B\u043E\u0432 \u0434\u043B\u044F \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u0441\u0440\u0435\u0434.",
        puc_specs_title: "\u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438",
        puc_spec_thickness: "\u0422\u043E\u043B\u0449\u0438\u043D\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u044B",
        puc_spec_shock: "\u0422\u0435\u0440\u043C\u043E\u0448\u043E\u043A",
        puc_spec_shock_v: "\u041D\u0435\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u044B\u0435 \u0446\u0438\u043A\u043B\u044B",
        puc_spec_impact: "\u0423\u0434\u0430\u0440\u043E\u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C",
        puc_slip_title: "\u041F\u0440\u043E\u0442\u0438\u0432\u043E\u0441\u043A\u043E\u043B\u044C\u0436\u0435\u043D\u0438\u0435",
        puc_slip_smooth: "\u0413\u043B\u0430\u0434\u043A\u0430\u044F \u043E\u0442\u0434\u0435\u043B\u043A\u0430",
        puc_slip_medium: "\u0421\u0440\u0435\u0434\u043D\u044F\u044F \u043E\u0442\u0434\u0435\u043B\u043A\u0430",
        puc_slip_coarse: "\u0413\u0440\u0443\u0431\u0430\u044F \u043E\u0442\u0434\u0435\u043B\u043A\u0430",
        puc_slip_heavy: "\u0422\u044F\u0436\u0451\u043B\u0430\u044F \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0430",
        puc_compliance_title: "\u0421\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435",
        puc_compl_food: "\u041F\u0438\u0449\u0435\u0432\u0430\u044F \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C",
        puc_compl_chem: "\u0425\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C",
        puc_compl_chem_v: "\u041E\u0442\u043B\u0438\u0447\u043D\u0430\u044F",
        puc_compl_steam: "\u041F\u0430\u0440\u043E\u0432\u0430\u044F \u0443\u0431\u043E\u0440\u043A\u0430",
        puc_compl_steam_v: "\u0415\u0436\u0435\u0434\u043D\u0435\u0432\u043D\u043E",
        puc_warranty_years: "10 \u043B\u0435\u0442",
        puc_warranty_inspect: "\u0415\u0436\u0435\u0433\u043E\u0434\u043D\u044B\u0439 \u043E\u0441\u043C\u043E\u0442\u0440",
        puc_rel1: "\u042D\u043F\u043E\u043A\u0441\u0438\u0434\u043D\u044B\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F",
        puc_rel2: "MMA-\u0441\u0438\u0441\u0442\u0435\u043C\u044B",
        puc_rel3: "\u041C\u0438\u043A\u0440\u043E\u0442\u043E\u043F\u043F\u0438\u043D\u0433",
        // Terrazzo
        terrazzo_category: "\u041F\u0440\u0435\u043C\u0438\u0443\u043C \u0434\u0435\u043A\u043E\u0440",
        terrazzo_title: "\u0422\u0435\u0440\u0440\u0430\u0446\u0446\u043E",
        terrazzo_meta: "\u0412\u0435\u0447\u043D\u0430\u044F \u043A\u0440\u0430\u0441\u043E\u0442\u0430 \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u0435\u0439",
        terrazzo_lead: "\u041C\u0440\u0430\u043C\u043E\u0440\u043D\u044B\u0435, \u0441\u0442\u0435\u043A\u043B\u044F\u043D\u043D\u044B\u0435 \u0438\u043B\u0438 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0435 \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u0438 \u0432 \u0446\u0435\u043C\u0435\u043D\u0442\u043D\u043E\u0439 \u0438\u043B\u0438 \u044D\u043F\u043E\u043A\u0441\u0438\u0434\u043D\u043E\u0439 \u043C\u0430\u0442\u0440\u0438\u0446\u0435 \u2014 \u0437\u0430\u0442\u0435\u043C \u0448\u043B\u0438\u0444\u043E\u0432\u043A\u0430 \u0438 \u043F\u043E\u043B\u0438\u0440\u043E\u0432\u043A\u0430, \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u044E\u0449\u0438\u0435 \u0433\u043B\u0443\u0431\u0438\u043D\u0443 \u0438 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440. \u041F\u043E\u043B \u0441 \u0434\u0443\u0448\u043E\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043C\u043E\u0436\u0435\u0442 \u0441\u043B\u0443\u0436\u0438\u0442\u044C \u043F\u043E\u043A\u043E\u043B\u0435\u043D\u0438\u044F\u043C.",
        terrazzo_h2_where: "\u0413\u0434\u0435 \u0442\u0435\u0440\u0440\u0430\u0446\u0446\u043E \u0441\u0438\u044F\u0435\u0442",
        terrazzo_p_where: "\u0422\u0435\u0440\u0440\u0430\u0446\u0446\u043E \u0432\u0435\u043A\u0430\u043C\u0438 \u0431\u044B\u043B \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u043C \u044D\u043B\u0435\u0433\u0430\u043D\u0442\u043D\u043E\u0441\u0442\u0438 \u0438 \u0434\u043E\u043B\u0433\u043E\u0432\u0435\u0447\u043D\u043E\u0441\u0442\u0438. \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043E\u043D \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u0432\u044B\u0431\u043E\u0440\u043E\u043C \u0434\u043B\u044F \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432, \u0433\u0434\u0435 \u0434\u0438\u0437\u0430\u0439\u043D\u0435\u0440\u0441\u043A\u043E\u0435 \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0438 \u0434\u043E\u043B\u0433\u043E\u0432\u0435\u0447\u043D\u043E\u0441\u0442\u044C \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442\u043D\u044B.",
        terrazzo_app1_title: "\u0410\u044D\u0440\u043E\u043F\u043E\u0440\u0442\u044B \u0438 \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442",
        terrazzo_app1_desc: "\u0414\u043E\u043B\u0433\u043E\u0432\u0435\u0447\u043D\u043E\u0441\u0442\u044C \u043F\u0440\u0438 \u043C\u0438\u043B\u043B\u0438\u043E\u043D\u0430\u0445 \u043F\u0440\u043E\u0445\u043E\u0434\u043E\u0432. \u041D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0435 \u043F\u0430\u0442\u0442\u0435\u0440\u043D\u044B, \u043B\u043E\u0433\u043E\u0442\u0438\u043F\u044B, \u0438\u043D\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u044F \u0431\u0440\u0435\u043D\u0434\u0430. \u041D\u0438\u0437\u043A\u0430\u044F \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u0432\u043B\u0430\u0434\u0435\u043D\u0438\u044F.",
        terrazzo_app2_title: "\u041B\u044E\u043A\u0441\u043E\u0432\u044B\u0439 \u0440\u0438\u0442\u0435\u0439\u043B",
        terrazzo_app2_desc: "\u041F\u043E\u043B\u044B-\u0437\u0430\u044F\u0432\u043B\u0435\u043D\u0438\u044F, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u044E\u0442 \u0431\u0440\u0435\u043D\u0434-\u043E\u043F\u044B\u0442. \u0418\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u044B\u0439 \u043F\u043E\u0434\u0431\u043E\u0440 \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u0435\u0439 \u0438 \u043F\u0430\u0442\u0442\u0435\u0440\u043D\u043E\u0432.",
        terrazzo_app3_title: "\u041E\u0442\u0435\u043B\u0438 \u0438 \u043B\u043E\u0431\u0431\u0438",
        terrazzo_app3_desc: "\u041F\u0430\u0440\u0430\u0434\u043D\u044B\u0435 \u0432\u0445\u043E\u0434\u043D\u044B\u0435 \u0437\u0430\u044F\u0432\u043B\u0435\u043D\u0438\u044F. \u0421\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0435 \u0434\u043E\u043B\u0433\u043E\u0432\u0435\u0447\u043D\u043E\u0441\u0442\u0438 \u0441 \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u044B\u043C \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C. \u0418\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0438\u043B\u0438 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439.",
        terrazzo_app4_title: "\u041C\u0435\u0434\u0438\u0446\u0438\u043D\u0430",
        terrazzo_app4_desc: "\u0411\u0435\u0441\u0448\u043E\u0432\u043D\u043E\u0441\u0442\u044C, \u0433\u0438\u0433\u0438\u0435\u043D\u0438\u0447\u043D\u043E\u0441\u0442\u044C, \u043B\u0451\u0433\u043A\u043E\u0441\u0442\u044C \u0443\u0431\u043E\u0440\u043A\u0438. \u0421\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435 \u0438\u043D\u0444\u0435\u043A\u0446\u0438\u043E\u043D\u043D\u043E\u043C\u0443 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044E. \u041F\u043E\u0436\u0438\u0437\u043D\u0435\u043D\u043D\u0430\u044F \u0434\u043E\u043B\u0433\u043E\u0432\u0435\u0447\u043D\u043E\u0441\u0442\u044C \u0441\u043D\u0438\u0436\u0430\u0435\u0442 \u0437\u0430\u0442\u0440\u0430\u0442\u044B \u043D\u0430 \u0437\u0430\u043C\u0435\u043D\u0443.",
        terrazzo_h2_substrate: "\u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F",
        terrazzo_p_substrate: "\u0422\u0435\u0440\u0440\u0430\u0446\u0446\u043E \u2014 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u0430\u044F \u0438\u043D\u0441\u0442\u0430\u043B\u043B\u044F\u0446\u0438\u044F, \u0442\u0440\u0435\u0431\u0443\u044E\u0449\u0430\u044F \u043D\u0430\u0434\u043B\u0435\u0436\u0430\u0449\u0435\u0439 \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u043D\u043E\u0439 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0438. \u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u0442\u0438\u043F\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u044B, \u043D\u043E \u043A\u0440\u0438\u0442\u0438\u0447\u043D\u0430 \u0434\u043B\u044F \u0434\u043E\u043B\u0433\u043E\u0441\u0440\u043E\u0447\u043D\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B.",
        terrazzo_sub1: "<strong>\u0426\u0435\u043C\u0435\u043D\u0442\u043D\u043E\u0435 \u0442\u0435\u0440\u0440\u0430\u0446\u0446\u043E (\u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043E\u043D\u043D\u043E\u0435)</strong> \u2014 \u0422\u0440\u0435\u0431\u0443\u0435\u0442 \u043F\u0435\u0441\u0447\u0430\u043D\u043E-\u0446\u0435\u043C\u0435\u043D\u0442\u043D\u043E\u0439 \u043F\u043E\u0434\u043B\u043E\u0436\u043A\u0438 \u043F\u043E\u0432\u0435\u0440\u0445 \u0433\u0438\u0434\u0440\u043E\u0438\u0437\u043E\u043B\u044F\u0446\u0438\u0438. \u041E\u0431\u0449\u0430\u044F \u0442\u043E\u043B\u0449\u0438\u043D\u0430 25-50\u043C\u043C",
        terrazzo_sub2: "<strong>\u042D\u043F\u043E\u043A\u0441\u0438\u0434\u043D\u043E\u0435 \u0442\u0435\u0440\u0440\u0430\u0446\u0446\u043E (\u0442\u043E\u043D\u043A\u043E\u0441\u043B\u043E\u0439\u043D\u043E\u0435)</strong> \u2014 \u041D\u0430\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u043F\u0440\u044F\u043C\u043E \u043D\u0430 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u0439 \u0431\u0435\u0442\u043E\u043D. \u041E\u0431\u0449\u0430\u044F \u0442\u043E\u043B\u0449\u0438\u043D\u0430 10-12\u043C\u043C",
        terrazzo_sub3: "<strong>\u0420\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u043F\u0440\u043E\u0444\u0438\u043B\u0438</strong> \u2014 \u041B\u0430\u0442\u0443\u043D\u043D\u044B\u0435, \u0446\u0438\u043D\u043A\u043E\u0432\u044B\u0435 \u0438\u043B\u0438 \u043F\u043B\u0430\u0441\u0442\u0438\u043A\u043E\u0432\u044B\u0435 \u043F\u0440\u043E\u0444\u0438\u043B\u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u044E\u0442 \u0442\u0440\u0435\u0449\u0438\u043D\u044B \u0438 \u0441\u043E\u0437\u0434\u0430\u044E\u0442 \u0434\u0438\u0437\u0430\u0439\u043D\u0435\u0440\u0441\u043A\u0438\u0435 \u043F\u0430\u0442\u0442\u0435\u0440\u043D\u044B",
        terrazzo_sub4: "<strong>\u0414\u0435\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0435 \u0448\u0432\u044B</strong> \u2014 \u0414\u043E\u043B\u0436\u043D\u044B \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u0442\u044C \u0441\u043E \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u043D\u044B\u043C\u0438 \u0448\u0432\u0430\u043C\u0438. \u0417\u0430\u043F\u043E\u043B\u043D\u044F\u044E\u0442\u0441\u044F \u0433\u0438\u0431\u043A\u0438\u043C \u0433\u0435\u0440\u043C\u0435\u0442\u0438\u043A\u043E\u043C",
        terrazzo_sub5: "<strong>\u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u0432\u043B\u0430\u0433\u0438</strong> \u2014 \u041A\u0440\u0438\u0442\u0438\u0447\u0435\u043D \u0434\u043B\u044F \u044D\u043F\u043E\u043A\u0441\u0438\u0434\u043D\u044B\u0445 \u0441\u0438\u0441\u0442\u0435\u043C. \u041F\u0430\u0440\u043E\u0438\u0437\u043E\u043B\u044F\u0446\u0438\u044F \u0438\u043B\u0438 \u043C\u0438\u0442\u0438\u0433\u0430\u0446\u0438\u044F \u043F\u0440\u0438 RH >75%",
        terrazzo_h2_process: "\u041F\u0440\u043E\u0446\u0435\u0441\u0441 \u0442\u0435\u0440\u0440\u0430\u0446\u0446\u043E",
        terrazzo_p_process: "\u041A\u0430\u0436\u0434\u0430\u044F \u0443\u043A\u043B\u0430\u0434\u043A\u0430 \u0442\u0435\u0440\u0440\u0430\u0446\u0446\u043E \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u043F\u0440\u043E\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u043C\u0443 \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0443, \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u044E\u0449\u0435\u043C\u0443 \u0441\u044B\u0440\u044C\u0451 \u0432 \u0434\u043E\u043B\u0433\u043E\u0432\u0435\u0447\u043D\u044B\u0435 \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0430.",
        terrazzo_layer1_title: "\u0417\u0430\u043B\u0438\u0432\u043A\u0430 \u0438 \u0443\u043A\u043B\u0430\u0434\u043A\u0430",
        terrazzo_layer1_desc: "\u041C\u0430\u0442\u0440\u0438\u0446\u0430 (\u0446\u0435\u043C\u0435\u043D\u0442 \u0438\u043B\u0438 \u044D\u043F\u043E\u043A\u0441\u0438\u0434) \u0441\u043C\u0435\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0441 \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u044B\u043C\u0438 \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044F\u043C\u0438, \u0437\u0430\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u043C\u0435\u0436\u0434\u0443 \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C\u0438 \u043F\u0440\u043E\u0444\u0438\u043B\u044F\u043C\u0438 \u0438 \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F \u0434\u043E \u0437\u0430\u0434\u0430\u043D\u043D\u043E\u0439 \u0433\u043B\u0443\u0431\u0438\u043D\u044B. \u0417\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u0438 \u043F\u043E\u0441\u044B\u043F\u0430\u044E\u0442\u0441\u044F \u0432\u0440\u0443\u0447\u043D\u0443\u044E \u0434\u043B\u044F \u043F\u043B\u043E\u0442\u043D\u043E\u0441\u0442\u0438.",
        terrazzo_layer2_title: "\u0428\u043B\u0438\u0444\u043E\u0432\u043A\u0430",
        terrazzo_layer2_desc: "\u041F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u0448\u043B\u0438\u0444\u043E\u0432\u043A\u0430 \u0430\u043B\u043C\u0430\u0437\u043D\u044B\u043C\u0438 \u0441\u0435\u0433\u043C\u0435\u043D\u0442\u0430\u043C\u0438 \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0433\u0440\u0430\u043D\u0438 \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u0435\u0439. \u041C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E \u043F\u0440\u043E\u0445\u043E\u0434\u043E\u0432 \u043E\u0442 \u0433\u0440\u0443\u0431\u044B\u0445 (40 \u0433\u0440\u0438\u0442) \u0434\u043E \u0442\u043E\u043D\u043A\u0438\u0445 (200+ \u0433\u0440\u0438\u0442) \u0441\u043E\u0437\u0434\u0430\u044E\u0442 \u0433\u043B\u0430\u0434\u043A\u0443\u044E \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C.",
        terrazzo_layer3_title: "\u0428\u043F\u0430\u043A\u043B\u0451\u0432\u043A\u0430 \u0438 \u043F\u043E\u043B\u0438\u0440\u043E\u0432\u043A\u0430",
        terrazzo_layer3_desc: "\u041F\u043E\u0440\u044B \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u044E\u0442\u0441\u044F \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0435\u0439 \u0448\u043F\u0430\u043A\u043B\u0451\u0432\u043A\u043E\u0439, \u0437\u0430\u0442\u0435\u043C \u043F\u043E\u043B\u0438\u0440\u043E\u0432\u043A\u0430 \u0434\u043E \u0438\u0442\u043E\u0433\u043E\u0432\u043E\u0433\u043E \u0431\u043B\u0435\u0441\u043A\u0430. \u041F\u0440\u043E\u043D\u0438\u043A\u0430\u044E\u0449\u0438\u0439 \u0433\u0435\u0440\u043C\u0435\u0442\u0438\u043A \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442, \u043D\u0435 \u043C\u0435\u043D\u044F\u044F \u0432\u0438\u0434.",
        terrazzo_h2_aggregates: "\u0412\u0430\u0440\u0438\u0430\u043D\u0442\u044B \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u0435\u0439",
        terrazzo_p_aggregates: "\u041A\u0440\u0430\u0441\u043E\u0442\u0430 \u0442\u0435\u0440\u0440\u0430\u0446\u0446\u043E \u0432 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u044B\u0445 \u0434\u0438\u0437\u0430\u0439\u043D\u0435\u0440\u0441\u043A\u0438\u0445 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044F\u0445 \u0447\u0435\u0440\u0435\u0437 \u0432\u044B\u0431\u043E\u0440 \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u0435\u0439:",
        terrazzo_var1_title: "\u041C\u0440\u0430\u043C\u043E\u0440\u043D\u0430\u044F \u043A\u0440\u043E\u0448\u043A\u0430",
        terrazzo_var1_desc: "\u041A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C \u0442\u0435\u0440\u0440\u0430\u0446\u0446\u043E. \u0420\u0430\u0437\u043C\u0435\u0440\u044B \u043E\u0442 0 (\u043C\u0435\u043B\u043A\u0438\u0439) \u0434\u043E 8 (\u043A\u0440\u0443\u043F\u043D\u044B\u0439). \u0415\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435 \u0446\u0432\u0435\u0442\u043E\u0432\u044B\u0435 \u0432\u0430\u0440\u0438\u0430\u0446\u0438\u0438.",
        terrazzo_var2_title: "\u0421\u0442\u0435\u043A\u043B\u043E",
        terrazzo_var2_desc: "\u041F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u043E\u0435 \u0438\u043B\u0438 \u043F\u0435\u0440\u0432\u0438\u0447\u043D\u043E\u0435 \u0441\u0442\u0435\u043A\u043B\u043E \u043D\u0435\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u044B\u0445 \u0446\u0432\u0435\u0442\u043E\u0432. \u041E\u0442\u0440\u0430\u0436\u0430\u044E\u0449\u0438\u0439 \u0431\u043B\u0435\u0441\u043A, \u044D\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u043D\u044B\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442.",
        terrazzo_var3_title: "\u041F\u0435\u0440\u043B\u0430\u043C\u0443\u0442\u0440",
        terrazzo_var3_desc: "\u0418\u0437\u043C\u0435\u043B\u044C\u0447\u0451\u043D\u043D\u0430\u044F \u0440\u0430\u043A\u0443\u0448\u043A\u0430 \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u043B\u0438\u0432\u0430\u044E\u0449\u0435\u0433\u043E\u0441\u044F \u044D\u0444\u0444\u0435\u043A\u0442\u0430. \u041B\u044E\u043A\u0441\u043E\u0432\u044B\u0435 \u0436\u0438\u043B\u044B\u0435 \u0438 \u0433\u043E\u0441\u0442\u0438\u043D\u0438\u0447\u043D\u044B\u0435 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F.",
        terrazzo_var4_title: "\u0421\u043C\u0435\u0448\u0430\u043D\u043D\u044B\u0439 / \u041D\u0430 \u0437\u0430\u043A\u0430\u0437",
        terrazzo_var4_desc: "\u041A\u043E\u043C\u0431\u0438\u043D\u0438\u0440\u0443\u0439\u0442\u0435 \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u0438 \u0434\u043B\u044F \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0445 \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u0432. \u0420\u0430\u043A\u0443\u0448\u043A\u0438, \u043C\u0435\u0442\u0430\u043B\u043B, \u0437\u0435\u0440\u043A\u0430\u043B\u043E \u2014 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u0431\u0435\u0437\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u044B.",
        terrazzo_h2_advantages: "\u041A\u043B\u044E\u0447\u0435\u0432\u044B\u0435 \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0430",
        terrazzo_adv1: "<strong>\u0418\u0441\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u0434\u043E\u043B\u0433\u043E\u0432\u0435\u0447\u043D\u043E\u0441\u0442\u044C</strong> \u2014 50+ \u043B\u0435\u0442 \u0441\u043B\u0443\u0436\u0431\u044B. \u041C\u043D\u043E\u0433\u0438\u0435 \u043F\u043E\u043B\u044B \u0442\u0435\u0440\u0440\u0430\u0446\u0446\u043E 1920-\u0445 \u0433\u043E\u0434\u043E\u0432 \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442 \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440.",
        terrazzo_adv2: "<strong>\u0421\u0432\u043E\u0431\u043E\u0434\u0430 \u0434\u0438\u0437\u0430\u0439\u043D\u0430</strong> \u2014 \u041D\u0435\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u044B\u0435 \u0446\u0432\u0435\u0442\u0430, \u043F\u0430\u0442\u0442\u0435\u0440\u043D\u044B, \u043B\u043E\u0433\u043E\u0442\u0438\u043F\u044B \u0438 \u0438\u043D\u043A\u0440\u0443\u0441\u0442\u0430\u0446\u0438\u0438. \u0418\u0441\u0442\u0438\u043D\u043D\u044B\u0435 \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u044B\u0435 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438.",
        terrazzo_adv3: "<strong>\u041D\u0438\u0437\u043A\u0430\u044F \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u0432\u043B\u0430\u0434\u0435\u043D\u0438\u044F</strong> \u2014 \u0412\u044B\u0441\u043E\u043A\u0430\u044F \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0438\u0440\u0443\u0435\u0442\u0441\u044F \u0434\u0435\u0441\u044F\u0442\u0438\u043B\u0435\u0442\u0438\u044F\u043C\u0438 \u0441\u043B\u0443\u0436\u0431\u044B. \u0420\u0435\u0441\u0442\u0430\u0432\u0440\u0438\u0440\u0443\u0435\u0442\u0441\u044F, \u0430 \u043D\u0435 \u0437\u0430\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F.",
        terrazzo_adv4: "<strong>\u042D\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u043D\u043E\u0441\u0442\u044C</strong> \u2014 \u041F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u043E\u0435 \u0441\u0442\u0435\u043A\u043B\u043E \u0438 \u043F\u043E\u0441\u0442\u043F\u043E\u0442\u0440\u0435\u0431\u0438\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0435 \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u0438. VOC-free \u0446\u0435\u043C\u0435\u043D\u0442\u043D\u044B\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B. LEED-\u043A\u0440\u0435\u0434\u0438\u0442\u044B.",
        terrazzo_adv5: "<strong>\u0411\u0435\u0441\u0448\u043E\u0432\u043D\u043E\u0441\u0442\u044C \u0438 \u0433\u0438\u0433\u0438\u0435\u043D\u0430</strong> \u2014 \u041D\u0435\u0442 \u0437\u0430\u0442\u0438\u0440\u043E\u0447\u043D\u044B\u0445 \u0448\u0432\u043E\u0432. \u0420\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435 \u043F\u0440\u043E\u0444\u0438\u043B\u0438 \u0438\u043D\u0442\u0435\u0433\u0440\u0430\u043B\u044C\u043D\u044B. \u041B\u0435\u0433\u043A\u043E \u043C\u044B\u0442\u044C \u0438 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u0442\u044C.",
        terrazzo_adv6: "<strong>\u0420\u0435\u0441\u0442\u0430\u0432\u0440\u0438\u0440\u0443\u0435\u043C\u043E\u0441\u0442\u044C</strong> \u2014 \u041C\u043E\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u0448\u043B\u0438\u0444\u043E\u0432\u0430\u0442\u044C \u0438 \u043F\u0435\u0440\u0435\u043F\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0434\u043E \u0438\u0441\u0445\u043E\u0434\u043D\u043E\u0433\u043E \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F. \u041F\u043E\u043B, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0443\u043B\u0443\u0447\u0448\u0430\u0435\u0442\u0441\u044F \u0441 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u043E\u043C.",
        terrazzo_h2_maintenance: "\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F",
        terrazzo_p_maintenance: "\u0422\u0435\u0440\u0440\u0430\u0446\u0446\u043E \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043D\u0435\u043F\u0440\u0438\u0445\u043E\u0442\u043B\u0438\u0432. \u041F\u0440\u043E\u0446\u0435\u0441\u0441 \u0448\u043B\u0438\u0444\u043E\u0432\u043A\u0438 \u0438 \u043F\u043E\u043B\u0438\u0440\u043E\u0432\u043A\u0438 \u0441\u043E\u0437\u0434\u0430\u0451\u0442 \u043F\u043B\u043E\u0442\u043D\u0443\u044E, \u0437\u0430\u043A\u0440\u044B\u0442\u0443\u044E \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C, \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u0443\u044E \u043A \u043F\u044F\u0442\u043D\u0430\u043C \u0438 \u0438\u0437\u043D\u043E\u0441\u0443.",
        terrazzo_maint_daily: "\u0421\u0443\u0445\u0430\u044F \u0443\u0431\u043E\u0440\u043A\u0430 \u0434\u043B\u044F \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u044F \u0430\u0431\u0440\u0430\u0437\u0438\u0432\u043D\u044B\u0445 \u0447\u0430\u0441\u0442\u0438\u0446. \u0412\u043B\u0430\u0436\u043D\u0430\u044F \u0443\u0431\u043E\u0440\u043A\u0430 \u0437\u043E\u043D \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0433\u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u043F\u043E \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438.",
        terrazzo_maint_weekly: "\u0412\u043B\u0430\u0436\u043D\u0430\u044F \u0443\u0431\u043E\u0440\u043A\u0430 \u0441 \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u043C pH-\u043E\u0447\u0438\u0441\u0442\u0438\u0442\u0435\u043B\u0435\u043C. \u0410\u0432\u0442\u043E\u0441\u043A\u0440\u0430\u0431\u0435\u0440 \u0434\u043B\u044F \u0431\u043E\u043B\u044C\u0448\u0438\u0445 \u043F\u043B\u043E\u0449\u0430\u0434\u0435\u0439.",
        terrazzo_maint_annually: "\u041F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u0430\u044F \u0430\u043B\u043C\u0430\u0437\u043D\u0430\u044F \u0448\u043B\u0438\u0444\u043E\u0432\u043A\u0430 \u0437\u043E\u043D \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0433\u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F. \u041F\u043E\u0432\u0442\u043E\u0440\u043D\u043E\u0435 \u043D\u0430\u043D\u0435\u0441\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u043D\u0438\u043A\u0430\u044E\u0449\u0435\u0433\u043E \u0433\u0435\u0440\u043C\u0435\u0442\u0438\u043A\u0430.",
        terrazzo_maint_cycle: "\u041A\u0430\u0436\u0434\u044B\u0435 10-20 \u043B\u0435\u0442",
        terrazzo_maint_cycle_desc: "\u041F\u043E\u043B\u043D\u0430\u044F \u0440\u0435\u0441\u0442\u0430\u0432\u0440\u0430\u0446\u0438\u043E\u043D\u043D\u0430\u044F \u0448\u043B\u0438\u0444\u043E\u0432\u043A\u0430 \u0438 \u043F\u043E\u043B\u0438\u0440\u043E\u0432\u043A\u0430 \u043F\u043E \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438 \u0434\u043B\u044F \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F \u0438\u0441\u0445\u043E\u0434\u043D\u043E\u0433\u043E \u0432\u0438\u0434\u0430.",
        terrazzo_cta_title: "\u0413\u043E\u0442\u043E\u0432\u044B \u043A \u043F\u0440\u043E\u0435\u043A\u0442\u0443 \u0442\u0435\u0440\u0440\u0430\u0446\u0446\u043E?",
        terrazzo_cta_text: "\u041D\u0430\u0448\u0430 \u0434\u0438\u0437\u0430\u0439\u043D-\u043A\u043E\u043C\u0430\u043D\u0434\u0430 \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u044B\u0439 \u043F\u043E\u043B \u0442\u0435\u0440\u0440\u0430\u0446\u0446\u043E, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u0440\u043E\u0441\u043B\u0443\u0436\u0438\u0442 \u043F\u043E\u043A\u043E\u043B\u0435\u043D\u0438\u044F\u043C.",
        terrazzo_specs_title: "\u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438",
        terrazzo_spec_thickness: "\u0422\u043E\u043B\u0449\u0438\u043D\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u044B",
        terrazzo_spec_passes: "\u041F\u0440\u043E\u0445\u043E\u0434\u043E\u0432 \u0448\u043B\u0438\u0444\u043E\u0432\u043A\u0438",
        terrazzo_spec_polish: "\u0418\u0442\u043E\u0433\u043E\u0432\u0430\u044F \u043F\u043E\u043B\u0438\u0440\u043E\u0432\u043A\u0430",
        terrazzo_sealer_title: "\u0413\u0435\u0440\u043C\u0435\u0442\u0438\u043A \u0438 \u0437\u0430\u0449\u0438\u0442\u0430",
        terrazzo_seal_type: "\u0422\u0438\u043F \u0433\u0435\u0440\u043C\u0435\u0442\u0438\u043A\u0430",
        terrazzo_seal_type_v: "\u041F\u0440\u043E\u043D\u0438\u043A\u0430\u044E\u0449\u0438\u0439",
        terrazzo_seal_stain: "\u0421\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u044C \u043A \u043F\u044F\u0442\u043D\u0430\u043C",
        terrazzo_seal_stain_v: "\u041E\u0442\u043B\u0438\u0447\u043D\u0430\u044F",
        terrazzo_seal_cure: "\u0412\u0440\u0435\u043C\u044F \u043E\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u044F",
        terrazzo_seal_design: "\u0414\u0438\u0437\u0430\u0439\u043D\u0435\u0440\u0441\u043A\u0438\u0435 \u043E\u043F\u0446\u0438\u0438",
        terrazzo_seal_design_v: "\u041D\u0430 \u0437\u0430\u043A\u0430\u0437",
        terrazzo_cat_title: "\u041A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0438 \u0441\u0438\u0441\u0442\u0435\u043C",
        terrazzo_cat_cement: "\u0426\u0435\u043C\u0435\u043D\u0442\u043D\u043E\u0435 \u0442\u0435\u0440\u0440\u0430\u0446\u0446\u043E",
        terrazzo_cat_epoxy: "\u042D\u043F\u043E\u043A\u0441\u0438\u0434\u043D\u043E\u0435 \u0442\u0435\u0440\u0440\u0430\u0446\u0446\u043E",
        terrazzo_cat_precast: "\u0421\u0431\u043E\u0440\u043D\u0430\u044F \u043F\u043B\u0438\u0442\u043A\u0430",
        terrazzo_cat_rustic: "\u0420\u0443\u0441\u0442\u0438\u043A / \u041C\u043E\u043D\u043E\u043B\u0438\u0442",
        terrazzo_warranty_years: "10 \u043B\u0435\u0442",
        terrazzo_warranty_struct: "\u0421\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u043D\u0430\u044F (\u0446\u0435\u043C\u0435\u043D\u0442)",
        terrazzo_rel1: "\u041C\u0438\u043A\u0440\u043E\u0442\u043E\u043F\u043F\u0438\u043D\u0433",
        terrazzo_rel2: "\u041F\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0431\u0435\u0442\u043E\u043D",
        terrazzo_rel3: "\u042D\u043F\u043E\u043A\u0441\u0438\u0434\u043D\u044B\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F",
        // Concrete
        concrete_category: "\u042D\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u043D\u0430\u044F \u043E\u0442\u0434\u0435\u043B\u043A\u0430",
        concrete_title: "\u0414\u0435\u043A\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0439 \u0431\u0435\u0442\u043E\u043D",
        concrete_meta: "\u041F\u043E\u043B\u0438\u0440\u043E\u0432\u043A\u0430 \u0438 \u043E\u043A\u0440\u0430\u0448\u0438\u0432\u0430\u043D\u0438\u0435",
        concrete_lead: "\u041F\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0433\u043E \u0431\u0435\u0442\u043E\u043D\u0430 \u0432 \u0433\u043E\u0442\u043E\u0432\u044B\u0439 \u043F\u043E\u043B \u0447\u0435\u0440\u0435\u0437 \u0448\u043B\u0438\u0444\u043E\u0432\u043A\u0443, \u043F\u043E\u043B\u0438\u0440\u043E\u0432\u043A\u0443 \u0438 \u043E\u043A\u0440\u0430\u0448\u0438\u0432\u0430\u043D\u0438\u0435. \u041C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F \u044D\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u043D\u043E\u0441\u0442\u044C, \u043C\u0438\u043D\u0438\u043C\u0443\u043C \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432 \u2014 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u0439 \u044D\u043A\u043E-\u0432\u044B\u0431\u043E\u0440 \u0434\u043B\u044F \u043D\u0430\u043F\u043E\u043B\u044C\u043D\u044B\u0445 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0439.",
        concrete_h2_where: "\u0413\u0434\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u043F\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0431\u0435\u0442\u043E\u043D",
        concrete_p_where: "\u041F\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0431\u0435\u0442\u043E\u043D \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u043E\u0431\u044B\u0447\u043D\u044B\u0435 \u043F\u043B\u0438\u0442\u044B \u0432 \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0435, \u0434\u043E\u043B\u0433\u043E\u0432\u0435\u0447\u043D\u044B\u0435 \u043F\u043E\u043B\u044B. \u0418\u0434\u0435\u0430\u043B\u0435\u043D \u0434\u043B\u044F \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432, \u0433\u0434\u0435 \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442\u043D\u044B \u044D\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u043D\u043E\u0441\u0442\u044C, \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0439 \u0443\u0445\u043E\u0434 \u0438 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0430\u044F \u044D\u0441\u0442\u0435\u0442\u0438\u043A\u0430.",
        concrete_app1_title: "\u0420\u0438\u0442\u0435\u0439\u043B \u0438 \u0448\u043E\u0443\u0440\u0443\u043C\u044B",
        concrete_app1_desc: "\u0421\u0442\u0438\u043B\u044C\u043D\u0430\u044F \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0430\u044F \u044D\u0441\u0442\u0435\u0442\u0438\u043A\u0430. \u0412\u044B\u0441\u043E\u043A\u0430\u044F \u0441\u0432\u0435\u0442\u043E\u043E\u0442\u0440\u0430\u0436\u0430\u0435\u043C\u043E\u0441\u0442\u044C \u0441\u043D\u0438\u0436\u0430\u0435\u0442 \u0437\u0430\u0442\u0440\u0430\u0442\u044B \u043D\u0430 \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0435. \u041C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0439 \u0443\u0445\u043E\u0434.",
        concrete_app2_title: "\u0421\u043A\u043B\u0430\u0434\u044B \u0438 \u0434\u0438\u0441\u0442\u0440\u0438\u0431\u0443\u0446\u0438\u044F",
        concrete_app2_desc: "\u0423\u043F\u043B\u043E\u0442\u043D\u0451\u043D\u043D\u044B\u0439 \u0431\u0435\u0442\u043E\u043D \u0432\u044B\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u043F\u043E\u0433\u0440\u0443\u0437\u0447\u0438\u043A\u0438. \u0411\u0435\u0441\u043F\u044B\u043B\u044C\u043D\u0430\u044F \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C \u0443\u043B\u0443\u0447\u0448\u0430\u0435\u0442 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E \u0432\u043E\u0437\u0434\u0443\u0445\u0430.",
        concrete_app3_title: "\u041E\u0444\u0438\u0441\u043D\u044B\u0435 \u0437\u0434\u0430\u043D\u0438\u044F",
        concrete_app3_desc: "\u042D\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u043D\u044B\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F. LEED-\u043A\u0440\u0435\u0434\u0438\u0442\u044B. \u041E\u0442\u043A\u0440\u044B\u0442\u044B\u0439 \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C \u0438\u043B\u0438 \u043A\u0440\u0435\u043C\u043E\u0432\u0430\u044F \u043E\u0442\u0434\u0435\u043B\u043A\u0430.",
        concrete_app4_title: "\u0416\u0438\u043B\u044C\u0451",
        concrete_app4_desc: "\u0418\u043D\u0434\u0443\u0441\u0442\u0440\u0438\u0430\u043B\u044C\u043D\u044B\u0439 \u0448\u0438\u043A. \u0421\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C \u0441 \u0442\u0451\u043F\u043B\u044B\u043C \u043F\u043E\u043B\u043E\u043C. \u0413\u0438\u043F\u043E\u0430\u043B\u043B\u0435\u0440\u0433\u0435\u043D\u043D\u044B\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442.",
        concrete_h2_substrate: "\u041E\u0446\u0435\u043D\u043A\u0430 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F",
        concrete_p_substrate: "\u041F\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0431\u0435\u0442\u043E\u043D \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0435 \u043F\u043B\u0438\u0442\u044B. \u0418\u0442\u043E\u0433\u043E\u0432\u044B\u0439 \u0432\u0438\u0434 \u0441\u0438\u043B\u044C\u043D\u043E \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430 \u0438 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F. \u041D\u0430\u0448\u0430 \u043A\u043E\u043C\u0430\u043D\u0434\u0430 \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442 \u0442\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u0443\u044E \u043E\u0446\u0435\u043D\u043A\u0443 \u043F\u0435\u0440\u0435\u0434 \u043A\u0430\u0436\u0434\u044B\u043C \u043F\u0440\u043E\u0435\u043A\u0442\u043E\u043C.",
        concrete_sub1: "<strong>\u041A\u0430\u0447\u0435\u0441\u0442\u0432\u043E \u0431\u0435\u0442\u043E\u043D\u0430</strong> \u2014 \u0411\u0435\u0442\u043E\u043D \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u0438 (25+ \u041C\u041F\u0430) \u043F\u043E\u043B\u0438\u0440\u0443\u0435\u0442\u0441\u044F \u043B\u0443\u0447\u0448\u0435. \u0422\u0438\u043F \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044F \u0432\u043B\u0438\u044F\u0435\u0442 \u043D\u0430 \u0432\u0438\u0434",
        concrete_sub2: "<strong>\u0421\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F</strong> \u2014 \u0421\u0442\u0430\u0440\u044B\u0435 \u0433\u0435\u0440\u043C\u0435\u0442\u0438\u043A\u0438, \u043A\u0440\u0430\u0441\u043A\u0438, \u043A\u043B\u0435\u0438 \u0434\u043E\u043B\u0436\u043D\u044B \u0431\u044B\u0442\u044C \u0443\u0434\u0430\u043B\u0435\u043D\u044B. \u041C\u043E\u0436\u0435\u0442 \u043F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C\u0441\u044F \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043D\u0430\u044F \u0448\u043B\u0438\u0444\u043E\u0432\u043A\u0430",
        concrete_sub3: "<strong>\u0420\u0435\u043C\u043E\u043D\u0442 \u0442\u0440\u0435\u0449\u0438\u043D</strong> \u2014 \u0422\u0440\u0435\u0449\u0438\u043D\u044B \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u044E\u0442\u0441\u044F \u044D\u043F\u043E\u043A\u0441\u0438\u0434\u043E\u043C \u0438\u043B\u0438 \u043F\u043E\u043B\u0438\u043C\u043E\u0447\u0435\u0432\u0438\u043D\u043E\u0439. \u041E\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u0432\u0438\u0434\u0438\u043C\u044B\u043C\u0438 \u043A\u0430\u043A \u044D\u043B\u0435\u043C\u0435\u043D\u0442 \u0434\u0438\u0437\u0430\u0439\u043D\u0430",
        concrete_sub4: "<strong>\u0420\u043E\u0432\u043D\u043E\u0441\u0442\u044C</strong> \u2014 \u0428\u043B\u0438\u0444\u043E\u0432\u043A\u0430 \u0441\u043D\u0438\u043C\u0430\u0435\u0442 \u0432\u044B\u0441\u0442\u0443\u043F\u044B. \u0417\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u0432\u044B\u0440\u0430\u0432\u043D\u0438\u0432\u0430\u043D\u0438\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043D\u0430\u043B\u0438\u0432\u043D\u044B\u0445 \u043F\u043E\u043B\u043E\u0432",
        concrete_sub5: "<strong>\u0412\u043B\u0430\u0436\u043D\u043E\u0441\u0442\u044C</strong> \u2014 \u0423\u043F\u043B\u043E\u0442\u043D\u0438\u0442\u0435\u043B\u0438 \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442 \u043F\u0440\u0438 \u0443\u043C\u0435\u0440\u0435\u043D\u043D\u043E\u0439 \u0432\u043B\u0430\u0433\u0435. \u0421\u0435\u0440\u044C\u0451\u0437\u043D\u044B\u0439 MVT \u043C\u043E\u0436\u0435\u0442 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C \u043C\u0438\u0442\u0438\u0433\u0430\u0446\u0438\u0438",
        concrete_h2_process: "\u041F\u0440\u043E\u0446\u0435\u0441\u0441 \u043F\u043E\u043B\u0438\u0440\u043E\u0432\u043A\u0438",
        concrete_p_process: "\u041F\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0431\u0435\u0442\u043E\u043D \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0435\u0442\u0441\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043C\u0435\u0445\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u043C, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0443\u043F\u043B\u043E\u0442\u043D\u044F\u0435\u0442 \u0438 \u0443\u043B\u0443\u0447\u0448\u0430\u0435\u0442 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C.",
        concrete_layer1_title: "\u0428\u043B\u0438\u0444\u043E\u0432\u043A\u0430",
        concrete_layer1_desc: "\u041F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u0430\u043B\u043C\u0430\u0437\u043D\u0430\u044F \u0448\u043B\u0438\u0444\u043E\u0432\u043A\u0430 \u043E\u0442 \u0433\u0440\u0443\u0431\u043E\u0439 (30-50 \u0433\u0440\u0438\u0442) \u0434\u043E \u0441\u0440\u0435\u0434\u043D\u0435\u0439 (100-200 \u0433\u0440\u0438\u0442). \u0421\u043D\u0438\u043C\u0430\u0435\u0442 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u043D\u044B\u0439 \u0441\u043B\u043E\u0439, \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C \u043F\u0440\u0438 \u0436\u0435\u043B\u0430\u043D\u0438\u0438, \u0441\u043E\u0437\u0434\u0430\u0451\u0442 \u0440\u043E\u0432\u043D\u0443\u044E \u043F\u043B\u043E\u0441\u043A\u043E\u0441\u0442\u044C.",
        concrete_layer2_title: "\u0423\u043F\u043B\u043E\u0442\u043D\u0435\u043D\u0438\u0435",
        concrete_layer2_desc: "\u041B\u0438\u0442\u0438\u0435\u0432\u044B\u0439 \u0441\u0438\u043B\u0438\u043A\u0430\u0442 \u043F\u0440\u043E\u043D\u0438\u043A\u0430\u0435\u0442 \u0438 \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u0435\u0442 \u0441 \u0431\u0435\u0442\u043E\u043D\u043E\u043C, \u0443\u043F\u0440\u043E\u0447\u043D\u044F\u044F \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C. \u0421\u043E\u0437\u0434\u0430\u0451\u0442 \u0431\u0435\u0441\u043F\u044B\u043B\u044C\u043D\u0443\u044E, \u0438\u0437\u043D\u043E\u0441\u043E\u0441\u0442\u043E\u0439\u043A\u0443\u044E \u043C\u0430\u0442\u0440\u0438\u0446\u0443.",
        concrete_layer3_title: "\u041F\u043E\u043B\u0438\u0440\u043E\u0432\u043A\u0430",
        concrete_layer3_desc: "\u0422\u043E\u043D\u043A\u0430\u044F \u0430\u043B\u043C\u0430\u0437\u043D\u0430\u044F \u043F\u043E\u043B\u0438\u0440\u043E\u0432\u043A\u0430 (400-3000 \u0433\u0440\u0438\u0442) \u0441\u043E\u0437\u0434\u0430\u0451\u0442 \u0431\u043B\u0435\u0441\u043A. \u0412\u044B\u0448\u0435 \u0433\u0440\u0438\u0442 = \u0432\u044B\u0448\u0435 \u0431\u043B\u0435\u0441\u043A. \u0417\u0430\u0449\u0438\u0442\u043D\u044B\u0439 \u0441\u043B\u043E\u0439 \u043E\u043F\u0446\u0438\u043E\u043D\u0430\u043B\u0435\u043D \u0434\u043B\u044F \u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u0438 \u043A \u043F\u044F\u0442\u043D\u0430\u043C.",
        concrete_h2_finishes: "\u0412\u0430\u0440\u0438\u0430\u043D\u0442\u044B \u043E\u0442\u0434\u0435\u043B\u043A\u0438",
        concrete_p_finishes: "\u041C\u044B \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u043C \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0443\u0440\u043E\u0432\u043D\u0435\u0439 \u043E\u0442\u0434\u0435\u043B\u043A\u0438 \u043F\u043E\u0434 \u0432\u0430\u0448\u0438 \u044D\u0441\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0438 \u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0435 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F:",
        concrete_var1_title: "\u041A\u0440\u0435\u043C\u043E\u0432\u0430\u044F \u043F\u043E\u043B\u0438\u0440\u043E\u0432\u043A\u0430",
        concrete_var1_desc: "\u041C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F \u0448\u043B\u0438\u0444\u043E\u0432\u043A\u0430 \u2014 \u043F\u043E\u043B\u0438\u0440\u0443\u0435\u0442\u0441\u044F \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u043D\u0430\u044F \u043F\u0430\u0441\u0442\u0430. \u041E\u0434\u043D\u043E\u0440\u043E\u0434\u043D\u044B\u0439 \u0446\u0432\u0435\u0442, \u0431\u0435\u0437 \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u0438\u044F \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044F.",
        concrete_var2_title: "\u0421\u043E\u043B\u044C \u0438 \u043F\u0435\u0440\u0435\u0446",
        concrete_var2_desc: "\u041B\u0451\u0433\u043A\u043E\u0435 \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u0438\u0435 \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044F. \u0412\u0438\u0434\u043D\u0430 \u0441\u043C\u0435\u0441\u044C \u043C\u0435\u043B\u043A\u043E\u0433\u043E \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044F \u0438 \u0446\u0435\u043C\u0435\u043D\u0442\u043D\u043E\u0439 \u043F\u0430\u0441\u0442\u044B.",
        concrete_var3_title: "\u041F\u043E\u043B\u043D\u043E\u0435 \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u0438\u0435",
        concrete_var3_desc: "\u0413\u043B\u0443\u0431\u043E\u043A\u0430\u044F \u0448\u043B\u0438\u0444\u043E\u0432\u043A\u0430 \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043A\u0440\u0443\u043F\u043D\u044B\u0439 \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C. \u041A\u0430\u043C\u0435\u043D\u043D\u0430\u044F \u043A\u0440\u043E\u0448\u043A\u0430 \u0432\u0438\u0434\u043D\u0430 \u043F\u043E\u0432\u0441\u044E\u0434\u0443.",
        concrete_var4_title: "\u041E\u043A\u0440\u0430\u0448\u0435\u043D\u043D\u044B\u0439",
        concrete_var4_desc: "\u041A\u0438\u0441\u043B\u043E\u0442\u043D\u0430\u044F \u043C\u043E\u0440\u0438\u043B\u043A\u0430 \u0438\u043B\u0438 \u043A\u0440\u0430\u0441\u0438\u0442\u0435\u043B\u044C \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044E\u0442 \u0446\u0432\u0435\u0442. \u0420\u0435\u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0435 \u043C\u043E\u0440\u0438\u043B\u043A\u0438 \u0441\u043E\u0437\u0434\u0430\u044E\u0442 \u0432\u0430\u0440\u0438\u0430\u0442\u0438\u0432\u043D\u044B\u0435, \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u044B.",
        concrete_h2_advantages: "\u041A\u043B\u044E\u0447\u0435\u0432\u044B\u0435 \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0430",
        concrete_adv1: "<strong>\u042D\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u043D\u043E\u0441\u0442\u044C</strong> \u2014 \u041D\u043E\u0432\u044B\u0435 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B \u043D\u0435 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044E\u0442\u0441\u044F. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0430\u044F \u043F\u043B\u0438\u0442\u0430. \u041D\u0443\u043B\u0435\u0432\u043E\u0439 VOC. \u0414\u043E\u0441\u0442\u0443\u043F\u043D\u044B LEED-\u043A\u0440\u0435\u0434\u0438\u0442\u044B.",
        concrete_adv2: "<strong>\u041C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0439 \u0443\u0445\u043E\u0434</strong> \u2014 \u0423\u043F\u043B\u043E\u0442\u043D\u0451\u043D\u043D\u0430\u044F \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u0430 \u043A \u043F\u044F\u0442\u043D\u0430\u043C \u0438 \u043F\u044B\u043B\u0435\u043D\u0438\u044E. \u041F\u0440\u043E\u0441\u0442\u043E\u0439 \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B \u0443\u0431\u043E\u0440\u043A\u0438.",
        concrete_adv3: "<strong>\u042D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u043D\u043E\u0441\u0442\u044C</strong> \u2014 \u041D\u0435\u0442 \u043D\u0430\u043B\u0438\u0432\u043D\u044B\u0445 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432. \u041D\u0438\u0437\u043A\u0430\u044F \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u0432\u043B\u0430\u0434\u0435\u043D\u0438\u044F \u043F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441 \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E\u043C \u0441\u0438\u0441\u0442\u0435\u043C.",
        concrete_adv4: "<strong>\u0421\u0432\u0435\u0442\u043E\u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u0435</strong> \u2014 \u0412\u044B\u0441\u043E\u043A\u043E\u0433\u043B\u044F\u043D\u0446\u0435\u0432\u0430\u044F \u043F\u043E\u043B\u0438\u0440\u043E\u0432\u043A\u0430 \u043E\u0442\u0440\u0430\u0436\u0430\u0435\u0442 \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u0439 \u0441\u0432\u0435\u0442, \u0441\u043D\u0438\u0436\u0430\u044F \u044D\u043D\u0435\u0440\u0433\u043E\u0437\u0430\u0442\u0440\u0430\u0442\u044B \u043D\u0430 \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0435.",
        concrete_adv5: "<strong>\u0414\u043E\u043B\u0433\u043E\u0432\u0435\u0447\u043D\u043E\u0441\u0442\u044C</strong> \u2014 25+ \u043B\u0435\u0442 \u0441\u043B\u0443\u0436\u0431\u044B. \u041C\u043E\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u043F\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u043F\u0440\u0438 \u0446\u0430\u0440\u0430\u043F\u0438\u043D\u0430\u0445 \u0438\u043B\u0438 \u0438\u0437\u043D\u043E\u0441\u0435.",
        concrete_adv6: "<strong>\u0411\u0435\u0437 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0432\u044B\u0441\u043E\u0442\u044B</strong> \u2014 \u041F\u0440\u043E\u0446\u0435\u0441\u0441 \u0441\u043D\u0438\u043C\u0430\u0435\u0442, \u0430 \u043D\u0435 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B. \u041D\u0435\u0442 \u043F\u0440\u043E\u0431\u043B\u0435\u043C \u0441 \u0434\u0432\u0435\u0440\u044F\u043C\u0438 \u0438\u043B\u0438 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430\u043C\u0438.",
        concrete_h2_maintenance: "\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F",
        concrete_p_maintenance: "\u0423\u043F\u043B\u043E\u0442\u043D\u0451\u043D\u043D\u044B\u0439 \u043F\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0431\u0435\u0442\u043E\u043D \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043F\u0440\u043E\u0441\u0442 \u0432 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0438. \u0422\u0432\u0451\u0440\u0434\u0430\u044F, \u043F\u043B\u043E\u0442\u043D\u0430\u044F \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u0430 \u043A \u0438\u0437\u043D\u043E\u0441\u0443 \u0438 \u043F\u044F\u0442\u043D\u0430\u043C.",
        concrete_maint_daily: "\u0421\u0443\u0445\u0430\u044F \u0443\u0431\u043E\u0440\u043A\u0430 \u0447\u0438\u0441\u0442\u043E\u0439 \u043C\u0438\u043A\u0440\u043E\u0444\u0438\u0431\u0440\u043E\u0439. \u0410\u0432\u0442\u043E\u0441\u043A\u0440\u0430\u0431\u0435\u0440 \u0434\u043B\u044F \u0431\u043E\u043B\u044C\u0448\u0438\u0445 \u043F\u043B\u043E\u0449\u0430\u0434\u0435\u0439.",
        concrete_maint_weekly: "\u0412\u043B\u0430\u0436\u043D\u0430\u044F \u0443\u0431\u043E\u0440\u043A\u0430 \u0441 \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u043C pH-\u043E\u0447\u0438\u0441\u0442\u0438\u0442\u0435\u043B\u0435\u043C. \u0412\u043E\u0441\u043A \u0438\u043B\u0438 \u043F\u043E\u043B\u0438\u0440\u043E\u043B\u044C \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u044E\u0442\u0441\u044F.",
        concrete_maint_monthly: "\u0415\u0436\u0435\u043C\u0435\u0441\u044F\u0447\u043D\u043E",
        concrete_maint_monthly_desc: "\u041F\u043E\u043B\u0438\u0440\u043E\u0432\u043A\u0430 \u0432\u044B\u0441\u043E\u043A\u043E\u0441\u043A\u043E\u0440\u043E\u0441\u0442\u043D\u044B\u043C \u0431\u0430\u0444\u0444\u0435\u0440\u043E\u043C \u043F\u0440\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438 \u0434\u043B\u044F \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F \u0431\u043B\u0435\u0441\u043A\u0430.",
        concrete_maint_asneeded: "\u041F\u043E\u0432\u0442\u043E\u0440\u043D\u043E\u0435 \u0443\u043F\u043B\u043E\u0442\u043D\u0435\u043D\u0438\u0435 \u0438 \u043F\u0435\u0440\u0435\u043F\u043E\u043B\u0438\u0440\u043E\u0432\u043A\u0430 \u0438\u0437\u043D\u043E\u0448\u0435\u043D\u043D\u044B\u0445 \u0437\u043E\u043D. \u041E\u0431\u044B\u0447\u043D\u043E \u043A\u0430\u0436\u0434\u044B\u0435 5-10 \u043B\u0435\u0442 \u043F\u0440\u0438 \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u043C \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0438.",
        concrete_cta_title: "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u0435\u0442 \u043F\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439 \u0431\u0435\u0442\u043E\u043D?",
        concrete_cta_text: "\u041F\u043E\u0437\u0432\u043E\u043B\u044C\u0442\u0435 \u043D\u0430\u043C \u043E\u0446\u0435\u043D\u0438\u0442\u044C \u0432\u0430\u0448\u0443 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0443\u044E \u043F\u043B\u0438\u0442\u0443 \u0438 \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u0442\u044C \u043B\u0443\u0447\u0448\u0438\u0439 \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \u043E\u0442\u0434\u0435\u043B\u043A\u0438 \u0434\u043B\u044F \u0432\u0430\u0448\u0435\u0433\u043E \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430.",
        concrete_specs_title: "\u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438",
        concrete_spec_thickness: "\u0414\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u043D\u0430\u044F \u0442\u043E\u043B\u0449\u0438\u043D\u0430",
        concrete_spec_depth: "\u0413\u043B\u0443\u0431\u0438\u043D\u0430 \u0448\u043B\u0438\u0444\u043E\u0432\u043A\u0438",
        concrete_spec_sheen: "\u0423\u0440\u043E\u0432\u043D\u0438 \u0431\u043B\u0435\u0441\u043A\u0430",
        concrete_spec_sheen_v: "\u041E\u0442 \u043C\u0430\u0442\u043E\u0432\u043E\u0433\u043E \u0434\u043E \u0437\u0435\u0440\u043A\u0430\u043B\u044C\u043D\u043E\u0433\u043E",
        concrete_polish_title: "\u0423\u0440\u043E\u0432\u043D\u0438 \u043F\u043E\u043B\u0438\u0440\u043E\u0432\u043A\u0438",
        concrete_polish_matte: "\u041C\u0430\u0442\u043E\u0432\u0430\u044F \u043E\u0442\u0434\u0435\u043B\u043A\u0430",
        concrete_polish_satin: "\u0421\u0430\u0442\u0438\u043D\u043E\u0432\u0430\u044F \u043E\u0442\u0434\u0435\u043B\u043A\u0430",
        concrete_polish_semi: "\u041F\u043E\u043B\u0443\u0433\u043B\u044F\u043D\u0435\u0446",
        concrete_polish_high: "\u0412\u044B\u0441\u043E\u043A\u0438\u0439 \u0433\u043B\u044F\u043D\u0435\u0446",
        concrete_treat_title: "\u0412\u0430\u0440\u0438\u0430\u043D\u0442\u044B \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0438",
        concrete_treat_dens: "\u0423\u043F\u043B\u043E\u0442\u043D\u0438\u0442\u0435\u043B\u044C",
        concrete_treat_dens_v: "\u041B\u0438\u0442\u0438\u0435\u0432\u044B\u0439 \u0441\u0438\u043B\u0438\u043A\u0430\u0442",
        concrete_treat_guard: "\u0417\u0430\u0449\u0438\u0442\u0430/\u0413\u0435\u0440\u043C\u0435\u0442\u0438\u043A",
        concrete_treat_guard_v: "\u041E\u043F\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E",
        concrete_treat_stain: "\u0412\u0430\u0440\u0438\u0430\u043D\u0442\u044B \u043E\u043A\u0440\u0430\u0441\u043A\u0438",
        concrete_treat_stain_v: "\u041A\u0438\u0441\u043B\u043E\u0442\u0430 \u0438\u043B\u0438 \u043A\u0440\u0430\u0441\u0438\u0442\u0435\u043B\u044C",
        concrete_treat_voc: "\u0421\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 VOC",
        concrete_treat_voc_v: "\u041D\u043E\u043B\u044C",
        concrete_warranty_years: "5 \u043B\u0435\u0442",
        concrete_warranty_repolish: "\u0423\u0441\u043B\u0443\u0433\u0430 \u043F\u0435\u0440\u0435\u043F\u043E\u043B\u0438\u0440\u043E\u0432\u043A\u0438",
        concrete_warranty_repolish_v: "\u0414\u043E\u0441\u0442\u0443\u043F\u043D\u0430",
        concrete_rel1: "\u041C\u0438\u043A\u0440\u043E\u0442\u043E\u043F\u043F\u0438\u043D\u0433",
        concrete_rel2: "\u0422\u0435\u0440\u0440\u0430\u0446\u0446\u043E",
        concrete_rel3: "\u042D\u043F\u043E\u043A\u0441\u0438\u0434\u043D\u044B\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F",
        // Rubber
        rubber_category: "\u0411\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C \u0438 \u043A\u043E\u043C\u0444\u043E\u0440\u0442",
        rubber_title: "\u0420\u0435\u0437\u0438\u043D\u043E\u0432\u044B\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F",
        rubber_meta: "\u041A\u043E\u043C\u0444\u043E\u0440\u0442 \u0438 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C",
        rubber_lead: "\u0412\u0443\u043B\u043A\u0430\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435 \u0440\u0435\u0437\u0438\u043D\u043E\u0432\u044B\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F \u0434\u043B\u044F \u0441\u0440\u0435\u0434, \u0433\u0434\u0435 \u0432\u0430\u0436\u043D\u044B \u043A\u043E\u043C\u0444\u043E\u0440\u0442, \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C \u0438 \u0437\u0432\u0443\u043A\u043E\u043F\u043E\u0433\u043B\u043E\u0449\u0435\u043D\u0438\u0435. \u0414\u043E\u0441\u0442\u0443\u043F\u043D\u044B \u0432 \u0440\u0443\u043B\u043E\u043D\u0430\u0445, \u043F\u043B\u0438\u0442\u043A\u0430\u0445 \u0438\u043B\u0438 \u043D\u0430\u043B\u0438\u0432\u043D\u044B\u0445 \u0441\u0438\u0441\u0442\u0435\u043C\u0430\u0445 \u043F\u043E\u0434 \u043B\u044E\u0431\u043E\u0435 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435.",
        rubber_h2_where: "\u0413\u0434\u0435 \u0440\u0435\u0437\u0438\u043D\u0430 \u043F\u0440\u0435\u0432\u043E\u0441\u0445\u043E\u0434\u0438\u0442",
        rubber_p_where: "\u0420\u0435\u0437\u0438\u043D\u043E\u0432\u044B\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0442 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E\u0435 \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0435 \u0434\u043E\u043B\u0433\u043E\u0432\u0435\u0447\u043D\u043E\u0441\u0442\u0438, \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u0430 \u0438 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438 \u0434\u043B\u044F \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u0441\u0440\u0435\u0434, \u0433\u0434\u0435 \u043B\u044E\u0434\u0438 \u0441\u0442\u043E\u044F\u0442, \u0434\u0432\u0438\u0433\u0430\u044E\u0442\u0441\u044F \u0438 \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442.",
        rubber_app1_title: "\u0424\u0438\u0442\u043D\u0435\u0441-\u0446\u0435\u043D\u0442\u0440\u044B",
        rubber_app1_desc: "\u0421\u043F\u043E\u0440\u0442\u0437\u0430\u043B\u044B, \u0442\u0440\u0435\u043D\u0430\u0436\u0451\u0440\u043D\u044B\u0435 \u0437\u0430\u043B\u044B, \u043A\u0440\u043E\u0441\u0441\u0444\u0438\u0442. \u041F\u043E\u0433\u043B\u043E\u0449\u0435\u043D\u0438\u0435 \u0443\u0434\u0430\u0440\u043E\u0432, \u0437\u0430\u0449\u0438\u0442\u0430 \u043E\u0442 \u043F\u0430\u0434\u0430\u044E\u0449\u0438\u0445 \u0432\u0435\u0441\u043E\u0432, \u043B\u0451\u0433\u043A\u0430\u044F \u0443\u0431\u043E\u0440\u043A\u0430.",
        rubber_app2_title: "\u041C\u0435\u0434\u0438\u0446\u0438\u043D\u0430",
        rubber_app2_desc: "\u0411\u043E\u043B\u044C\u043D\u0438\u0446\u044B, \u043A\u043B\u0438\u043D\u0438\u043A\u0438, \u0434\u043E\u043C\u0430 \u043F\u0440\u0435\u0441\u0442\u0430\u0440\u0435\u043B\u044B\u0445. \u0410\u043D\u0442\u0438\u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C \u0434\u043B\u044F \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u0430, \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0441\u043A\u043E\u043B\u044C\u0436\u0435\u043D\u0438\u0435, \u0437\u0432\u0443\u043A\u043E\u043F\u043E\u0433\u043B\u043E\u0449\u0435\u043D\u0438\u0435.",
        rubber_app3_title: "\u041E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0435",
        rubber_app3_desc: "\u0428\u043A\u043E\u043B\u044B, \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u044B, \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0438. \u0414\u043E\u043B\u0433\u043E\u0432\u0435\u0447\u043D\u043E\u0441\u0442\u044C, \u0442\u0438\u0448\u0438\u043D\u0430, \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C. \u042D\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u043D\u044B\u0435 \u043F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0435 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u044B.",
        rubber_app4_title: "\u0414\u0435\u0442\u0441\u043A\u0438\u0435 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0438 \u0438 \u0440\u0435\u043A\u0440\u0435\u0430\u0446\u0438\u044F",
        rubber_app4_desc: "\u0411\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F \u0434\u043B\u044F \u0438\u0433\u0440\u043E\u0432\u044B\u0445 \u0437\u043E\u043D. \u041D\u0430\u043B\u0438\u0432\u043D\u044B\u0435 \u0440\u0435\u0437\u0438\u043D\u043E\u0432\u044B\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u0441 \u0440\u0435\u0439\u0442\u0438\u043D\u0433\u043E\u043C \u0432\u044B\u0441\u043E\u0442\u044B \u043F\u0430\u0434\u0435\u043D\u0438\u044F.",
        rubber_h2_substrate: "\u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F",
        rubber_p_substrate: "\u0420\u0435\u0437\u0438\u043D\u043E\u0432\u044B\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u0438\u043A\u043B\u0435\u0438\u0432\u0430\u0442\u044C, \u0443\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0442\u044C \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E \u0438\u043B\u0438 \u043C\u043E\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u043D\u0430 \u043F\u043E\u0434\u043B\u043E\u0436\u043A\u0443. \u0422\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F \u043A \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044E \u0437\u0430\u0432\u0438\u0441\u044F\u0442 \u043E\u0442 \u043C\u0435\u0442\u043E\u0434\u0430 \u0443\u043A\u043B\u0430\u0434\u043A\u0438.",
        rubber_sub1: "<strong>\u041F\u043E\u043B\u043D\u043E\u0435 \u043F\u0440\u0438\u043A\u043B\u0435\u0438\u0432\u0430\u043D\u0438\u0435</strong> \u2014 \u041E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0435 \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C \u0440\u043E\u0432\u043D\u044B\u043C (SR1-SR2), \u0441\u0443\u0445\u0438\u043C \u0438 \u0447\u0438\u0441\u0442\u044B\u043C \u043E\u0442 \u0437\u0430\u0433\u0440\u044F\u0437\u043D\u0435\u043D\u0438\u0439. \u041B\u0443\u0447\u0448\u0435 \u0434\u043B\u044F \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u0445 \u0443\u043A\u043B\u0430\u0434\u043E\u043A",
        rubber_sub2: "<strong>\u0421\u0432\u043E\u0431\u043E\u0434\u043D\u0430\u044F \u0443\u043A\u043B\u0430\u0434\u043A\u0430</strong> \u2014 \u0422\u044F\u0436\u0451\u043B\u044B\u0435 \u0440\u0435\u0437\u0438\u043D\u043E\u0432\u044B\u0435 \u043F\u043B\u0438\u0442\u043A\u0438 \u043C\u043E\u0436\u043D\u043E \u0443\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0442\u044C \u0431\u0435\u0437 \u043A\u043B\u0435\u044F. \u041F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0437\u0430\u043C\u0435\u043D\u0443 \u0438 \u0434\u043E\u0441\u0442\u0443\u043F \u043A \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044E",
        rubber_sub3: "<strong>\u0417\u0430\u043C\u043A\u043E\u0432\u044B\u0435 \u043F\u043B\u0438\u0442\u043A\u0438</strong> \u2014 \u041A\u043B\u0435\u0439 \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F. \u0411\u044B\u0441\u0442\u0440\u044B\u0439 \u043C\u043E\u043D\u0442\u0430\u0436 \u0434\u043B\u044F \u0441\u043F\u043E\u0440\u0442\u0437\u0430\u043B\u043E\u0432 \u0438 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0439",
        rubber_sub4: "<strong>\u041D\u0430\u043B\u0438\u0432\u043D\u0430\u044F \u0440\u0435\u0437\u0438\u043D\u0430</strong> \u2014 EPDM-\u0433\u0440\u0430\u043D\u0443\u043B\u044B \u0441 \u043F\u043E\u043B\u0438\u0443\u0440\u0435\u0442\u0430\u043D\u043E\u0432\u044B\u043C \u0441\u0432\u044F\u0437\u0443\u044E\u0449\u0438\u043C. \u0411\u0435\u0441\u0448\u043E\u0432\u043D\u0430\u044F, \u043B\u044E\u0431\u0430\u044F \u0442\u043E\u043B\u0449\u0438\u043D\u0430, \u0440\u0435\u0439\u0442\u0438\u043D\u0433 \u0434\u043B\u044F \u043F\u043B\u043E\u0449\u0430\u0434\u043E\u043A",
        rubber_sub5: "<strong>\u0412\u043B\u0430\u0436\u043D\u043E\u0441\u0442\u044C</strong> \u2014 \u0420\u0435\u0437\u0438\u043D\u0430 \u043D\u0435\u043F\u0440\u043E\u043D\u0438\u0446\u0430\u0435\u043C\u0430; \u0438\u0437\u0431\u044B\u0442\u043E\u0447\u043D\u0430\u044F \u0432\u043B\u0430\u0433\u0430 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0440\u0435\u0448\u0435\u043D\u0438\u044F \u0434\u043B\u044F \u043F\u0440\u0435\u0434\u043E\u0442\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F \u043F\u043B\u0435\u0441\u0435\u043D\u0438 \u043F\u043E\u0434 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435\u043C",
        rubber_h2_types: "\u0422\u0438\u043F\u044B \u0440\u0435\u0437\u0438\u043D\u043E\u0432\u044B\u0445 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0439",
        rubber_p_types: "\u041C\u044B \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u043C \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0435 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0438 \u0440\u0435\u0437\u0438\u043D\u043E\u0432\u044B\u0445 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0439 \u043F\u043E\u0434 \u0432\u0430\u0448\u0438 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0435 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F.",
        rubber_layer1_title: "\u0412\u0443\u043B\u043A\u0430\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F \u0440\u0435\u0437\u0438\u043D\u0430",
        rubber_layer1_desc: "\u0417\u0430\u0432\u043E\u0434\u0441\u043A\u0438\u0435 \u043B\u0438\u0441\u0442\u044B \u0438\u043B\u0438 \u043F\u043B\u0438\u0442\u043A\u0438. \u041F\u0440\u043E\u0446\u0435\u0441\u0441 \u0432\u0443\u043B\u043A\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0438 \u0441\u043E\u0437\u0434\u0430\u0451\u0442 \u0434\u043E\u043B\u0433\u043E\u0432\u0435\u0447\u043D\u044B\u0439, \u0443\u043F\u0440\u0443\u0433\u0438\u0439 \u043F\u0440\u043E\u0434\u0443\u043A\u0442. \u0414\u043E\u0441\u0442\u0443\u043F\u043D\u0430 \u0432 \u043D\u0430\u0442\u0443\u0440\u0430\u043B\u044C\u043D\u044B\u0445 \u0438\u043B\u0438 \u0441\u0438\u043D\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0444\u043E\u0440\u043C\u0443\u043B\u0430\u0445.",
        rubber_layer2_title: "\u041F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u0430\u044F \u0440\u0435\u0437\u0438\u043D\u0430",
        rubber_layer2_desc: "\u0418\u0437 \u043F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0445 \u0448\u0438\u043D. \u0414\u043E\u0441\u0442\u0443\u043F\u043D\u0430 \u043A\u0430\u043A \u043F\u043B\u0438\u0442\u043A\u0438, \u0440\u0443\u043B\u043E\u043D\u044B \u0438\u043B\u0438 \u043D\u0430\u043B\u0438\u0432\u043D\u0430\u044F. \u041E\u0442\u043B\u0438\u0447\u043D\u043E \u0434\u043B\u044F \u0441\u043F\u043E\u0440\u0442\u0437\u0430\u043B\u043E\u0432 \u0438 \u043F\u043B\u043E\u0449\u0430\u0434\u043E\u043A. \u042D\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u043D\u044B\u0439 \u0432\u044B\u0431\u043E\u0440.",
        rubber_layer3_title: "\u041D\u0430\u043B\u0438\u0432\u043D\u043E\u0439 EPDM",
        rubber_layer3_desc: "EPDM-\u0433\u0440\u0430\u043D\u0443\u043B\u044B \u0441 \u043F\u043E\u043B\u0438\u0443\u0440\u0435\u0442\u0430\u043D\u043E\u0432\u044B\u043C \u0441\u0432\u044F\u0437\u0443\u044E\u0449\u0438\u043C, \u0437\u0430\u043B\u0438\u0432\u0430\u0435\u043C\u044B\u0435 \u043D\u0430 \u043C\u0435\u0441\u0442\u0435. \u0411\u0435\u0441\u0448\u043E\u0432\u043D\u0430\u044F, \u043B\u044E\u0431\u0430\u044F \u0442\u043E\u043B\u0449\u0438\u043D\u0430, \u043B\u044E\u0431\u043E\u0439 \u0446\u0432\u0435\u0442. \u0418\u0434\u0435\u0430\u043B\u044C\u043D\u0430 \u0434\u043B\u044F \u043F\u043B\u043E\u0449\u0430\u0434\u043E\u043A \u0438 \u0441\u043F\u043E\u0440\u0442\u0438\u0432\u043D\u044B\u0445 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0439.",
        rubber_h2_patterns: "\u0420\u0438\u0441\u0443\u043D\u043A\u0438 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438",
        rubber_p_patterns: "\u0420\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0435 \u0442\u0435\u043A\u0441\u0442\u0443\u0440\u044B \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0442 \u0440\u0430\u0437\u043D\u044B\u0435 \u0443\u0440\u043E\u0432\u043D\u0438 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0441\u043A\u043E\u043B\u044C\u0436\u0435\u043D\u0438\u044F \u0438 \u044D\u0441\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u043E\u043F\u0446\u0438\u0438:",
        rubber_var1_title: "\u0413\u043B\u0430\u0434\u043A\u0430\u044F",
        rubber_var1_desc: "\u041B\u0435\u0433\u043A\u043E \u043C\u043E\u0435\u0442\u0441\u044F. \u0420\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0430 \u0432 \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0435 \u0438 \u0440\u0438\u0442\u0435\u0439\u043B\u0435. \u0422\u0440\u0435\u0431\u0443\u0435\u0442 \u0445\u043E\u0440\u043E\u0448\u0435\u0433\u043E \u0434\u0440\u0435\u043D\u0430\u0436\u0430 \u0434\u043B\u044F \u0432\u043B\u0430\u0436\u043D\u044B\u0445 \u0437\u043E\u043D.",
        rubber_var2_title: "\u0414\u0438\u0441\u043A\u0438 / \u0428\u0438\u043F\u044B",
        rubber_var2_desc: "\u041A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0432\u0438\u0434 \u0440\u0435\u0437\u0438\u043D\u043E\u0432\u044B\u0445 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0439. \u0423\u043B\u0443\u0447\u0448\u0435\u043D\u043D\u043E\u0435 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0441\u043A\u043E\u043B\u044C\u0436\u0435\u043D\u0438\u0435. \u0422\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442 \u0438 \u043F\u0440\u043E\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u043E\u0441\u0442\u044C.",
        rubber_var3_title: "\u041C\u043E\u043B\u043E\u0442\u043A\u043E\u0432\u0430\u044F",
        rubber_var3_desc: "\u0422\u0435\u043A\u0441\u0442\u0443\u0440\u0430 \u0434\u043B\u044F \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0441\u043A\u043E\u043B\u044C\u0436\u0435\u043D\u0438\u044F \u0438 \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0430. \u0425\u043E\u0440\u043E\u0448\u043E \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0441\u043B\u0435\u0434\u044B \u0438\u0437\u043D\u043E\u0441\u0430.",
        rubber_var4_title: "\u041D\u0430 \u0437\u0430\u043A\u0430\u0437",
        rubber_var4_desc: "\u041B\u043E\u0433\u043E\u0442\u0438\u043F\u044B, \u043F\u0430\u0442\u0442\u0435\u0440\u043D\u044B, \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u044F \u0438\u043D\u0442\u0435\u0433\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u044B \u0432 \u043F\u043E\u043B. \u0411\u0435\u0437\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u044B\u0435 \u0434\u0438\u0437\u0430\u0439\u043D\u0435\u0440\u0441\u043A\u0438\u0435 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438.",
        rubber_h2_advantages: "\u041A\u043B\u044E\u0447\u0435\u0432\u044B\u0435 \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0430",
        rubber_adv1: "<strong>\u041A\u043E\u043C\u0444\u043E\u0440\u0442 \u0438 \u0430\u043D\u0442\u0438\u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C</strong> \u2014 \u0410\u043C\u043E\u0440\u0442\u0438\u0437\u0438\u0440\u0443\u044E\u0449\u0430\u044F \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C \u0441\u043D\u0438\u0436\u0430\u0435\u0442 \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0443 \u043D\u0430 \u043D\u043E\u0433\u0438 \u0438 \u0441\u043F\u0438\u043D\u0443. \u041A\u0440\u0438\u0442\u0438\u0447\u043D\u043E \u0434\u043B\u044F \u0441\u0442\u043E\u044F\u0447\u0435\u0439 \u0440\u0430\u0431\u043E\u0442\u044B.",
        rubber_adv2: "<strong>\u0417\u0432\u0443\u043A\u043E\u043F\u043E\u0433\u043B\u043E\u0449\u0435\u043D\u0438\u0435</strong> \u2014 \u0417\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0441\u043D\u0438\u0436\u0430\u0435\u0442 \u0443\u0434\u0430\u0440\u043D\u044B\u0439 \u0448\u0443\u043C \u0438 \u0432\u043E\u0437\u0434\u0443\u0448\u043D\u0443\u044E \u0437\u0432\u0443\u043A\u043E\u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0443. \u0422\u0438\u0448\u0438\u043D\u0430 \u0432 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F\u0445.",
        rubber_adv3: "<strong>\u041F\u0440\u043E\u0442\u0438\u0432\u043E\u0441\u043A\u043E\u043B\u044C\u0436\u0435\u043D\u0438\u0435</strong> \u2014 \u0415\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435 \u0441\u0446\u0435\u043F\u043B\u0435\u043D\u0438\u0435 \u0434\u0430\u0436\u0435 \u0432\u043E \u0432\u043B\u0430\u0436\u043D\u043E\u043C \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438. \u041E\u0442\u043B\u0438\u0447\u043D\u044B\u0439 \u043F\u0440\u043E\u0444\u0438\u043B\u044C \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438 \u0434\u043B\u044F \u0437\u043E\u043D \u0441 \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u044B\u043C \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435\u043C.",
        rubber_adv4: "<strong>\u041F\u043E\u0433\u043B\u043E\u0449\u0435\u043D\u0438\u0435 \u0443\u0434\u0430\u0440\u043E\u0432</strong> \u2014 \u0417\u0430\u0449\u0438\u0449\u0430\u0435\u0442 \u043F\u0430\u0434\u0430\u044E\u0449\u0438\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B \u0438 \u0441\u043C\u044F\u0433\u0447\u0430\u0435\u0442 \u043F\u0430\u0434\u0435\u043D\u0438\u044F. \u041A\u0440\u0438\u0442\u0438\u0447\u043D\u043E \u0434\u043B\u044F \u0441\u043F\u043E\u0440\u0442\u0437\u0430\u043B\u043E\u0432 \u0438 \u0438\u0433\u0440\u043E\u0432\u044B\u0445 \u0437\u043E\u043D.",
        rubber_adv5: "<strong>\u042D\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u043D\u044B\u0435 \u043E\u043F\u0446\u0438\u0438</strong> \u2014 \u041F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0435 \u0448\u0438\u043D\u044B. \u041D\u0430\u0442\u0443\u0440\u0430\u043B\u044C\u043D\u044B\u0439 \u043A\u0430\u0443\u0447\u0443\u043A \u0438\u0437 \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u044B\u0445 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u043E\u0432. \u0414\u043E\u043B\u0433\u0438\u0439 \u0441\u0440\u043E\u043A \u0441\u043B\u0443\u0436\u0431\u044B.",
        rubber_adv6: "<strong>\u041F\u0440\u043E\u0441\u0442\u043E\u0439 \u0443\u0445\u043E\u0434</strong> \u2014 \u041F\u043E\u0434\u043C\u0435\u0442\u0430\u043D\u0438\u0435 \u0438 \u043C\u044B\u0442\u044C\u0451. \u0412\u043E\u0449\u0435\u043D\u0438\u0435 \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F. \u0423\u043F\u0440\u0443\u0433\u0430\u044F \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u0430 \u043A \u043F\u044F\u0442\u043D\u0430\u043C.",
        rubber_h2_maintenance: "\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u044F",
        rubber_p_maintenance: "\u0420\u0435\u0437\u0438\u043D\u043E\u0432\u044B\u0435 \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u044F \u043D\u0435\u043F\u0440\u0438\u0445\u043E\u0442\u043B\u0438\u0432\u044B \u0438 \u0443\u043F\u0440\u0443\u0433\u0438. \u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u0443\u0445\u043E\u0434 \u043F\u0440\u043E\u0434\u043B\u0435\u0432\u0430\u0435\u0442 \u0441\u0440\u043E\u043A \u0441\u043B\u0443\u0436\u0431\u044B \u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442 \u0432\u0438\u0434.",
        rubber_maint_daily: "\u041F\u043E\u0434\u043C\u0435\u0442\u0430\u043D\u0438\u0435 \u0438\u043B\u0438 \u043F\u044B\u043B\u0435\u0441\u043E\u0441 \u0434\u043B\u044F \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u044F \u043F\u0435\u0441\u043A\u0430. \u0412\u043B\u0430\u0436\u043D\u0430\u044F \u0443\u0431\u043E\u0440\u043A\u0430 \u0437\u043E\u043D \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0433\u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u043F\u043E \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438.",
        rubber_maint_weekly: "\u041C\u0430\u0448\u0438\u043D\u043D\u0430\u044F \u043C\u043E\u0439\u043A\u0430 \u0441 \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u043C pH-\u043E\u0447\u0438\u0441\u0442\u0438\u0442\u0435\u043B\u0435\u043C. \u0422\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u043E\u043F\u043E\u043B\u0430\u0441\u043A\u0438\u0432\u0430\u043D\u0438\u0435 \u0434\u043B\u044F \u043F\u0440\u0435\u0434\u043E\u0442\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F \u043E\u0441\u0442\u0430\u0442\u043A\u043E\u0432.",
        rubber_maint_monthly: "\u0415\u0436\u0435\u043C\u0435\u0441\u044F\u0447\u043D\u043E",
        rubber_maint_monthly_desc: "\u0413\u043B\u0443\u0431\u043E\u043A\u0430\u044F \u043E\u0447\u0438\u0441\u0442\u043A\u0430 \u0438 \u043E\u0441\u043C\u043E\u0442\u0440 \u043D\u0430 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F. \u041D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E\u0435 \u0443\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u043F\u043E\u0440\u0435\u0437\u043E\u0432 \u0438\u043B\u0438 \u0440\u0430\u0437\u0440\u044B\u0432\u043E\u0432.",
        rubber_maint_annually: "\u041F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u0430\u044F \u0443\u0431\u043E\u0440\u043A\u0430 \u043F\u0440\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438. \u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0448\u0432\u043E\u0432 \u0438 \u043A\u0440\u0430\u0451\u0432 \u043D\u0430 \u043E\u0442\u0441\u043B\u043E\u0435\u043D\u0438\u0435.",
        rubber_cta_title: "\u041D\u0443\u0436\u043D\u043E \u0440\u0435\u0448\u0435\u043D\u0438\u0435 \u0441 \u0440\u0435\u0437\u0438\u043D\u043E\u0432\u044B\u043C \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435\u043C?",
        rubber_cta_text: "\u041F\u043E\u0437\u0432\u043E\u043B\u044C\u0442\u0435 \u043D\u0430\u043C \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u0442\u044C \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u0440\u0435\u0437\u0438\u043D\u043E\u0432\u044B\u0439 \u043F\u0440\u043E\u0434\u0443\u043A\u0442 \u0434\u043B\u044F \u0432\u0430\u0448\u0435\u0433\u043E \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0438 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u0439.",
        rubber_specs_title: "\u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438",
        rubber_spec_thickness: "\u0414\u0438\u0430\u043F\u0430\u0437\u043E\u043D \u0442\u043E\u043B\u0449\u0438\u043D",
        rubber_spec_colors: "\u0426\u0432\u0435\u0442\u0430",
        rubber_spec_colors_v: "\u041F\u043E\u043B\u043D\u044B\u0439 \u0441\u043F\u0435\u043A\u0442\u0440",
        rubber_spec_textures: "\u0422\u0435\u043A\u0441\u0442\u0443\u0440\u044B",
        rubber_spec_textures_v: "\u041C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u043E\u0432",
        rubber_products_title: "\u0412\u0430\u0440\u0438\u0430\u043D\u0442\u044B \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u043E\u0432",
        rubber_prod_sheet: "\u041B\u0438\u0441\u0442\u043E\u0432\u044B\u0435 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B",
        rubber_prod_tiles: "\u041F\u043B\u0438\u0442\u043A\u0438",
