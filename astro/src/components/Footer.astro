---
interface Props {
  lang?: 'ru' | 'en';
}
const { lang = 'ru' } = Astro.props;
const t = lang === 'en' ? {
  tagline: 'Premium floor design and installation across Israel. Engineering-grade systems for industry, commercial, and architectural projects.',
  systems: 'Floor Systems',
  company: 'Company',
  contact: 'Contact',
  about: 'About Us',
  blog: 'Blog',
  projects: 'Projects',
  location: 'Israel, Tel Aviv',
  warranty: '10-Year Warranty',
  experience: '15+ Years Experience',
  iso: 'ISO 9001 Certified',
  visit: 'Free Site Visit',
  copyright: '© 2026 Floor.DSGN. All rights reserved. Licensed Flooring Contractor.',
  legal: "Floor.DSGN Ltd. | Service throughout Israel: Tel Aviv, Jerusalem, Haifa, Be'er Sheva | VAT Registered",
} : {
  tagline: 'Премиальный дизайн и монтаж полов по Израилю. Инженерные системы для промышленности, коммерции и архитектурных проектов.',
  systems: 'Системы полов',
  company: 'Компания',
  contact: 'Контакты',
  about: 'О нас',
  blog: 'Блог',
  projects: 'Проекты',
  location: 'Израиль, Тель-Авив',
  warranty: 'Гарантия 10 лет',
  experience: '15+ лет опыта',
  iso: 'Сертификат ISO 9001',
  visit: 'Бесплатный выезд',
  copyright: '© 2026 Floor.DSGN. Все права защищены. Лицензированный подрядчик.',
  legal: 'Floor.DSGN Ltd. | Сервис по всему Израилю: Тель-Авив, Иерусалим, Хайфа, Беэр-Шева | НДС зарегистрирован',
};
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src="/images/logo/White1_tr.png" alt="Floor.DSGN" class="footer-logo">
        <p data-i18n="footer_tagline">{t.tagline}</p>
      </div>
      <div class="footer-column">
        <h4 data-i18n="footer_systems">{t.systems}</h4>
        <ul>
          <li><a href="/materials/epoxy.html">Epoxy</a></li>
          <li><a href="/materials/mma.html">MMA</a></li>
          <li><a href="/materials/pu-cement.html">PU-Cement</a></li>
          <li><a href="/materials/microtopping.html">Microtopping</a></li>
          <li><a href="/materials/terrazzo.html">Terrazzo</a></li>
          <li><a href="/materials/concrete.html">Concrete</a></li>
        </ul>
      </div>
      <div class="footer-column">
        <h4 data-i18n="footer_company">{t.company}</h4>
        <ul>
          <li><a href="/projects.html" data-i18n="nav_projects">{t.projects}</a></li>
          <li><a href="/about.html" data-i18n="nav_about">{t.about}</a></li>
          <li><a href="/blog.html" data-i18n="nav_blog">{t.blog}</a></li>
          <li><a href="/contact.html" data-i18n="footer_contact">{t.contact}</a></li>
        </ul>
      </div>
      <div class="footer-column">
        <h4 data-i18n="footer_contact">{t.contact}</h4>
        <ul>
          <li><a href="mailto:floors.dsgn@gmail.com">floors.dsgn@gmail.com</a></li>
          <li><a href="tel:+972559661459">+972 55 966 1459</a></li>
          <li data-i18n="footer_location">{t.location}</li>
        </ul>
      </div>
    </div>
    <div class="footer-badges">
      <div class="badge-item">
        <div class="badge-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="M9 12l2 2 4-4"/>
          </svg>
        </div>
        <span data-i18n="footer_badge_warranty">{t.warranty}</span>
      </div>
      <div class="badge-item">
        <div class="badge-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 6v6l4 2"/>
          </svg>
        </div>
        <span data-i18n="footer_badge_experience">{t.experience}</span>
      </div>
      <div class="badge-item">
        <div class="badge-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
        </div>
        <span data-i18n="footer_badge_iso">{t.iso}</span>
      </div>
      <div class="badge-item">
        <div class="badge-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="1" y="3" width="15" height="13" rx="2"/>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
            <circle cx="5.5" cy="18.5" r="2.5"/>
            <circle cx="18.5" cy="18.5" r="2.5"/>
          </svg>
        </div>
        <span data-i18n="footer_badge_visit">{t.visit}</span>
      </div>
    </div>
    <div class="footer-bottom">
      <p data-i18n="footer_copyright">{t.copyright}</p>
      <div class="social-links">
        <a href="https://instagram.com/floor.dsgn" target="_blank" rel="noopener noreferrer" aria-label="Instagram">Instagram</a>
        <a href="https://linkedin.com/company/floordsgn" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">LinkedIn</a>
        <a href="https://facebook.com/floordsgn" target="_blank" rel="noopener noreferrer" aria-label="Facebook">Facebook</a>
      </div>
    </div>
    <div class="footer-legal">
      <p data-i18n="footer_legal">{t.legal}</p>
    </div>
  </div>
</footer>
